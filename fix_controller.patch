        [HttpGet("{empId}/leave-statement/{year}/pdf")]
        public async Task<IActionResult> DownloadLeaveStatementPdf(int empId, int year, [FromServices] Pay2ScopeResolver scopeResolver)
        {
            var userco = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "0");

            // 1. Fetch Employee Info to check WS Access
            var empQuery = "SELECT EMP_ID, EMP_CODE, WS_ID, FIRST_NAME, LAST_NAME, USERCO FROM PAY2_EMPLOYEE WHERE EMP_ID = @empId";
            var emps = await _db.DoGetDataSQLAsync<dynamic>(empQuery, new { empId });
            var emp = emps.FirstOrDefault();
            if (emp == null) return NotFound("Employee not found");

            // 2. ACL Check: Self-Service OR Manager with Read Access
            if (emp.USERCO != userco)
            {
                await scopeResolver.EnsureWorkshopAsync(userco, (int)emp.WS_ID);
                var hasAccess = await _db.DoGetDataSQLAsyncSingle<int>("SELECT 1 FROM SAL_CHEK WHERE USERCO = @userco AND OBJECT = (SELECT IDH FROM TFORMS WHERE FORMNAME = 'PAY2_EMPLOYEE') AND SEE = 1", new { userco });
                if (hasAccess == 0) return Forbid();
            }

            // 3. Gather Config Data
            var configQuery = @"
                SELECT
                    ISNULL(MAX(CASE WHEN CFG_KEY = 'LEAVE_MINS_PER_DAY' THEN TRY_CAST(CFG_VALUE AS INT) END), 440) AS LeaveMinsPerDay,
                    ISNULL(MAX(CASE WHEN CFG_KEY = 'LEAVE_CARRYOVER_MAX' THEN TRY_CAST(CFG_VALUE AS INT) END), 9) AS LeaveCarryoverMax
                FROM PAY2_CONFIG
                WHERE CFG_KEY IN ('LEAVE_MINS_PER_DAY', 'LEAVE_CARRYOVER_MAX')";
            var configs = await _db.DoGetDataSQLAsync<dynamic>(configQuery);
            var config = configs.FirstOrDefault();

            int leaveMinsPerDay = config?.LeaveMinsPerDay ?? 440;
            int leaveCarryoverMax = config?.LeaveCarryoverMax ?? 9;

            // 4. Gather Balance Data
            var balQuery = "SELECT ENTITLEMENT_MIN, USED_MIN, CARRIED_IN_MIN FROM PAY2_LEAVE_BAL WHERE EMP_ID = @empId AND YEAR = @year";
            var bals = await _db.DoGetDataSQLAsync<dynamic>(balQuery, new { empId, year });
            var bal = bals.FirstOrDefault();

            int entitlement = bal?.ENTITLEMENT_MIN ?? (leaveMinsPerDay * 26);
            int carriedIn = bal?.CARRIED_IN_MIN ?? 0;
            int used = bal?.USED_MIN ?? 0;
            int balance = entitlement + carriedIn - used;

            // 5. Gather History
            var historyQuery = @"
                SELECT
                    START_DATE,
                    END_DATE,
                    REQ_DAYS,
                    REQ_HOURS,
                    REQ_MINUTES,
                    DESCRIPTION,
                    (REQ_DAYS * @LeaveMinsPerDay + REQ_HOURS * 60 + REQ_MINUTES) AS TotalDeductedMinutes
                FROM PAY2_LEAVE
                WHERE EMP_ID = @empId
                  AND START_DATE / 10000 = @year
                  AND STATUS >= 3
                ORDER BY START_DATE DESC";

            var history = (await _db.DoGetDataSQLAsync<Pay2LeaveStatementLineDto>(historyQuery, new { empId, year, LeaveMinsPerDay = leaveMinsPerDay })).ToList();

            var prsDate = Safir.Shared.Utility.CL_Tarikh.ConvertToPersianDateLong(DateTime.Now)?.ToString() ?? "";
            var pDateFormatted = prsDate.Length == 8 ? $"{prsDate.Substring(0,4)}/{prsDate.Substring(4,2)}/{prsDate.Substring(6,2)}" : prsDate;

            var dto = new Pay2LeaveStatementDto
            {
                EmployeeCode = emp.EMP_CODE,
                EmployeeName = $"{emp.LAST_NAME} {emp.FIRST_NAME}",
                Year = year,
                PrintDate = pDateFormatted,
                LeaveMinsPerDay = leaveMinsPerDay,
                LeaveCarryoverMax = leaveCarryoverMax,
                EntitlementMin = entitlement,
                CarriedInMin = carriedIn,
                UsedMin = used,
                BalanceMin = balance,
                History = history
            };

            // 6. Generate PDF using QuestPDF
            var doc = new Safir.Server.Reports.Pay2LeaveStatementDocument(dto);
            byte[] pdfBytes = doc.GeneratePdf();

            return File(pdfBytes, "application/pdf", $"LeaveStatement_{emp.EMP_CODE}_{year}.pdf");
        }

