﻿﻿@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using Safir.Client.Services
@using Safir.Shared.Interfaces;
@inject NavigationManager NavigationManager
@inject IAuthService AuthService
@inject MudBlazor.IDialogService DialogService
@inject ShoppingCartService CartService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject UserStateApiService UserStateApiService
@inject ConnectionManagerService ConnectionManager
@inject ClientAppSettingsService ClientAppSettings

<div class="safir-nav">
    @if (activeDbSettings != null)
    {
        <div class="safir-nav-workspace" title="@($"سرور: {activeDbSettings.Server} — دیتابیس: {activeDbSettings.Database}")">
            <div class="safir-nav-workspace-icon"><i class="bi bi-building"></i></div>
            <div class="safir-nav-workspace-text">
                @if (activeSazmanSettings != null)
                {
                    <div class="safir-nav-workspace-name">@activeSazmanSettings.NAME</div>
                    <div class="safir-nav-workspace-meta">سال مالی @activeSazmanSettings.YEA · @activeDbSettings.Database</div>
                }
                else
                {
                    <div class="safir-nav-workspace-name">@activeDbSettings.Database</div>
                    <div class="safir-nav-workspace-meta">@activeDbSettings.Server</div>
                }
            </div>
        </div>
    }

    <MudNavMenu>
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
            صفحه اصلی
        </MudNavLink>

        <AuthorizeView>
            <Authorized>
                <div class="safir-nav-section">فروش و مشتریان</div>

                @if (_isCustomerSelected)
                {
                    <MudNavLink Href="item-groups" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ShoppingCart">
                        ثبت سفارش
                    </MudNavLink>
                }

                <MudNavLink Href="visitor-customers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List">
                    لیست مشتریان
                </MudNavLink>

                <MudNavLink Href="customer-define" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonAdd">
                    تعریف مشتری جدید
                </MudNavLink>

                <MudNavGroup Title="مدیریت مشتریان (CRM)" Icon="@Icons.Material.Filled.SupportAgent" Expanded="false">
                    <MudNavLink Href="/crm" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.PeopleAlt">
                        مدیریت و پیگیری‌ها
                    </MudNavLink>
                    <MudNavLink Href="/crm/dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Analytics">
                        داشبورد آماری
                    </MudNavLink>
                    <MudNavLink Href="/crm/phonebook" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ContactPhone">
                        دفترچه تلفن
                    </MudNavLink>
                </MudNavGroup>

                <div class="safir-nav-section">حقوق و دستمزد</div>

                <MudNavLink Href="salary/manage" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountBalanceWallet">
                    حقوق و دستمزد
                </MudNavLink>

                <MudNavLink Href="salary/my-leave-statement" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EventNote">
                    صورت‌حساب مرخصی من
                </MudNavLink>

                <div class="safir-nav-section">تولید و بهای تمام‌شده</div>

                <MudNavLink Href="production-reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Report">
                    ثبت گزارش تولید
                </MudNavLink>

                <MudNavGroup Title="بهای تمام‌شده" Icon="@Icons.Material.Filled.Calculate" Expanded="false">
                    <MudNavLink Href="/cost-close" Match="NavLinkMatch.All"
                                Icon="@Icons.Material.Filled.Dashboard">
                        داشبورد
                    </MudNavLink>
                    <MudNavLink Href="/cost-close/exceptions" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.Rule">
                        مغایرت‌ها
                    </MudNavLink>
                    @* بیرون از یک اجرای مشخص است چون چند دوره را با هم می‌گیرد؛
                       از داخلِ صورت‌های مالیِ هر اجرا هم لینک دارد. *@
                    <MudNavLink Href="/cost-close/statements/compare" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.CompareArrows">
                        صورت‌های مالی چند دوره
                    </MudNavLink>
                    @* برگه‌ی انباری می‌سازد، پس کارِ روزانه است نه گزارشِ
                       پایان ماه — ولی ارزشش را از کاردکس می‌گیرد و ترازش
                       را گام S11B می‌بندد، برای همین اینجا می‌نشیند. *@
                    <MudNavLink Href="/cost-close/conversions" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.SwapHoriz">
                        تبدیل کالا
                    </MudNavLink>
                    <MudNavLink Href="/cost-close/settings" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.Settings">
                        تنظیمات
                    </MudNavLink>
                </MudNavGroup>

                <div class="safir-nav-section">ابزارها</div>

                <MudNavLink Href="/automation/tasks" Icon="@Icons.Material.Filled.Assignment">
                    کارتابل اتوماسیون
                </MudNavLink>

                @* دستیار بیرون از گروهِ بهای تمام‌شده است چون قرار نیست فقط
                   آن ماژول را جواب بدهد؛ ابزارهای بعدی حوزه‌های دیگر را هم
                   می‌گیرند. «دسترسی» زیر همان مجوزی است که بقیه‌ی دسترسی‌ها
                   را می‌دهد، پس اگر کاربر ادمین نباشد صفحه ۴۰۳ می‌دهد. *@
                <MudNavGroup Title="دستیار هوش مصنوعی" Icon="@Icons.Material.Filled.SmartToy" Expanded="false">
                    <MudNavLink Href="/ai/chat" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.Chat">
                        گفتگو
                    </MudNavLink>
                    <MudNavLink Href="/ai/access" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.AdminPanelSettings">
                        دسترسی کاربران
                    </MudNavLink>
                    <MudNavLink Href="/ai/settings" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.Tune">
                        تنظیمات سرویس
                    </MudNavLink>
                    <MudNavLink Href="/ai/knowledge" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.MenuBook">
                        دانش کسب‌وکار
                    </MudNavLink>
                </MudNavGroup>

                <MudNavGroup Title="گزارش خطای نرم‌افزار" Icon="@Icons.Material.Filled.BugReport" Expanded="false">
                    <MudNavLink Href="bug-report" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AddComment">
                        ثبت گزارش جدید
                    </MudNavLink>
                    <MudNavLink Href="my-bug-reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ListAlt">
                        گزارش‌های من
                    </MudNavLink>
                    <MudNavLink Href="bug-report-list" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageSearch">
                        همه‌ی گزارش‌ها
                    </MudNavLink>
                </MudNavGroup>

                <div class="safir-nav-section">سیستم</div>

                <MudNavGroup Title="تنظیمات" Icon="@Icons.Material.Filled.Settings" Expanded="false">
                    <MudNavLink Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">@context.User.FindFirst(Safir.Shared.Constants.BaseknowClaimTypes.UUSER)?.Value</MudNavLink>

                    @* زیر همان مجوزِ ادمینِ دسترسی‌هاست؛ کاربر عادی که بازش کند
                       ۴۰۳ می‌گیرد. جایش اینجاست و نه داخل بهای تمام‌شده، چون
                       مهاجرت‌ها کلِ برنامه را می‌سازند نه فقط آن ماژول را. *@
                    <MudNavLink Href="/admin/db-upgrade" Match="NavLinkMatch.Prefix"
                                Icon="@Icons.Material.Filled.Storage">
                        به‌روزرسانی دیتابیس
                    </MudNavLink>

                    <MudNavLink @onclick="BeginSoftRefresh" Icon="@Icons.Material.Filled.SystemUpdateAlt">
                        بررسی و دریافت بروزرسانی
                    </MudNavLink>

                    <MudNavLink @onclick="BeginServerStateReset" Icon="@Icons.Material.Filled.DeleteForever">
                        ریست ذخیره وضعیت
                    </MudNavLink>

                    <MudNavLink @onclick="BeginFactoryReset" Icon="@Icons.Material.Filled.DeleteForever" Style="color: var(--mud-palette-error);">
                        ریست کامل سایت
                    </MudNavLink>
                </MudNavGroup>

                <MudNavLink Match="NavLinkMatch.Prefix" @onclick="BeginLogout" Icon="@Icons.Material.Filled.Logout">
                    خروج
                </MudNavLink>
            </Authorized>
            <NotAuthorized>
                <MudNavLink Href="login" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Login">
                    ورود کاربری
                </MudNavLink>

                <div class="safir-nav-section">تولید</div>

                <MudNavLink Href="production-reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Report">
                    ثبت گزارش تولید
                </MudNavLink>

                <MudNavLink Href="evaporation-report" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EditNote">
                    فرم گزارش اواپراتور
                </MudNavLink>

                <div class="safir-nav-section">سیستم</div>

                <MudNavLink @onclick="BeginSoftRefresh" Icon="@Icons.Material.Filled.SystemUpdateAlt">
                    بررسی و دریافت بروزرسانی
                </MudNavLink>

                <MudNavLink @onclick="BeginFactoryReset" Icon="@Icons.Material.Filled.DeleteForever" Style="color: var(--mud-palette-error);">
                    ریست کامل سایت
                </MudNavLink>
            </NotAuthorized>
        </AuthorizeView>
    </MudNavMenu>

    <div class="safir-nav-version">نسخه @appVersion</div>
</div>


@code {
    private bool collapseNavMenu = true;

    private string appVersion = "1.0.0"; // می‌توانید این مقدار را مطابق نسخه پروژه در csproj یا منبع دیگر تنظیم کنید

    private bool _isCustomerSelected = false;
    private Safir.Shared.Models.DbConnectionSettings? activeDbSettings;
    private Safir.Shared.Models.SAZMAN? activeSazmanSettings;

    // --- Lifecycle and Event Handling ---
    protected override async Task OnInitializedAsync()
    {
        await ConnectionManager.LoadSettingsAsync();
        // 🚀 اصلاح مهم: استفاده از متد جدید برای دریافت تنظیمات موثر
        activeDbSettings = await ConnectionManager.GetEffectiveDbSettingsAsync();

        try
        {
            ClientAppSettings.Invalidate();
            activeSazmanSettings = await ClientAppSettings.GetSettingsAsync();
        }
        catch
        {
        }

        // Set initial state based on current cart status
        _isCustomerSelected = CartService.CurrentCustomer != null;
        // Subscribe to the CartChanged event
        CartService.CartChanged += OnCartChanged;

        try
        {
            var version = System.Reflection.Assembly.GetExecutingAssembly().GetName().Version;
            if (version != null)
            {
                // به‌عنوان مثال: "1.0.0.0"
                appVersion = version.ToString();
            }
        }
        catch { }

        base.OnInitialized();
    }
    private void OnCartChanged()
    {
        // Update the state when the cart changes
        _isCustomerSelected = CartService.CurrentCustomer != null;
        // Notify the component to re-render
        InvokeAsync(StateHasChanged);
    }
    public void Dispose()
    {
        // Unsubscribe from the event when the component is disposed
        CartService.CartChanged -= OnCartChanged;
    }

    private async Task BeginServerStateReset()
    {
        var options = new DialogOptions { CloseButton = false, MaxWidth = MaxWidth.Small };
        var parameters = new DialogParameters
        {
            ["Title"] = "حذف وضعیت ذخیره شده",
            ["ContentText"] = "آیا از پاک شدن وضعیت کاربری مثل سبد خرید و مشتری انتخاب شده و .... اطمینان دارید؟",
            ["ConfirmButtonText"] = "بله، پاک کن",
            ["CancelButtonText"] = "خیر"
        };
        var dialog = DialogService.Show<ConfirmDialog>(parameters["Title"]?.ToString()!, parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                await UserStateApiService.ClearStateAsync();
                Snackbar.Add("اطلاعات ذخیره شده با موفقیت حذف شد.", MudBlazor.Severity.Success);
                NavigationManager.NavigateTo("/", forceLoad: true);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error clearing server state: {ex.Message}");
                Snackbar.Add("خطا در حذف اطلاعات ذخیره شده.", MudBlazor.Severity.Error);
            }
        }
    }
    // Computes the CSS class for the main navigation div to make it collapsible
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    // Toggles the expanded/collapsed state of the navigation menu
    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    // Handles the logout process
    private async Task BeginLogout()
    {
        var options = new DialogOptions { CloseButton = false, MaxWidth = MaxWidth.ExtraSmall };
        var parameters = new DialogParameters
        {
            ["Title"] = "خروج از حساب",
            ["ContentText"] = "آیا مطمئن هستید می‌خواهید از حساب کاربری خود خارج شوید؟",
            ["ConfirmButtonText"] = "خارج شو",
            ["CancelButtonText"] = "منصرف شدم"
        };
        var dialog = DialogService.Show<ConfirmDialog>(parameters["Title"]?.ToString()!, parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await AuthService.Logout();
            NavigationManager.NavigateTo("login", true);
        }
    }

    private async Task BeginSoftRefresh()
    {
        var options = new DialogOptions { CloseButton = false, MaxWidth = MaxWidth.Small };
        var parameters = new DialogParameters
        {
            ["Title"] = "دریافت آخرین تغییرات",
            ["ContentText"] = "آیا می‌خواهید برنامه را به‌روزرسانی کنید؟ (تنظیمات اتصال شما محفوظ می‌ماند)",
            ["ConfirmButtonText"] = "بله، آپدیت کن",
            ["CancelButtonText"] = "انصراف"
        };
        var dialog = DialogService.Show<ConfirmDialog>(parameters["Title"]?.ToString()!, parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                Snackbar.Add("در حال بررسی و دریافت آخرین نسخه...", MudBlazor.Severity.Info);
                var moduleVersion = System.Reflection.Assembly
                    .GetExecutingAssembly()
                    .ManifestModule
                    .ModuleVersionId
                    .ToString("N");
                var updateModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import",
                    $"./js/app-update.js?v={moduleVersion}");
                await updateModule.InvokeVoidAsync("refresh");
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error during soft refresh: {ex.Message}");
                Snackbar.Add("خطا در به‌روزرسانی.", MudBlazor.Severity.Error);
            }
        }
    }

    private async Task BeginFactoryReset()
    {
        var options = new DialogOptions { CloseButton = false, MaxWidth = MaxWidth.Small };
        var parameters = new DialogParameters
        {
            ["Title"] = "بازگشت به تنظیمات کارخانه",
            ["ContentText"] = "هشدار! با این کار تمامی تنظیمات از جمله آدرس سرور و اطلاعات دیتابیس پاک خواهد شد و باید مجدداً لاگین کنید. آیا مطمئن هستید؟",
            ["ConfirmButtonText"] = "بله، همه چیز پاک شود",
            ["CancelButtonText"] = "انصراف"
        };
        var dialog = DialogService.Show<ConfirmDialog>(parameters["Title"]?.ToString()!, parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            try
            {
                await JSRuntime.InvokeAsync<bool>("appCleanup.factoryReset");
                NavigationManager.NavigateTo("/", forceLoad: true);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error during factory reset: {ex.Message}");
                Snackbar.Add("خطا در ریست کارخانه.", MudBlazor.Severity.Error);
            }
        }
    }
}
