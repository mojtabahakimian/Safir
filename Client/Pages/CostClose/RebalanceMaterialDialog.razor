@using Safir.Shared.Models.CostClose
@using Safir.Client.Services
@inject CostCloseApiService Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <div dir="rtl" style="min-width:520px">
            <MudText Typo="Typo.body2" Class="mb-3">
                مقدار مصرف یک ماده را بین دو فرمولِ همین ماه جابه‌جا می‌کند — نه نرخ جذب دستمزد.
                جمع کل مصرف فیزیکی آن ماده ثابت می‌ماند، پس انحراف مصرف ایجاد نمی‌شود.
            </MudText>

            <MudAutocomplete T="FormulaMaterialDto" Label="ماده" Dense Variant="Variant.Outlined"
                              Class="mb-3" Value="_material" ValueChanged="OnMaterialChanged"
                              SearchFuncWithCancel="SearchMaterial" ToStringFunc="MaterialText"
                              Placeholder="نام یا کد ماده" />

            @if (_material is not null)
            {
                @if (_loadingConsumers)
                {
                    <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-3" />
                }
                else if (_consumers.Count < 2)
                {
                    <MudAlert Severity="Severity.Warning" Dense Class="mb-3">
                        این ماده در کمتر از دو فرمولِ این ماه مصرف شده — چیزی برای جابه‌جایی نیست.
                    </MudAlert>
                }
                else
                {
                    <MudSelect T="long?" Label="از کالا (کم می‌شود)" Dense Variant="Variant.Outlined"
                               Class="mb-3" Value="_fromCode" ValueChanged="OnFromChanged">
                        @foreach (var g in ConsumerGroups)
                        {
                            <MudSelectItem Value="@((long?)g.Key)" Disabled="@(!g.Any(Usable))">
                                @GroupLabel(g)
                            </MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="long?" Label="به کالا (اضافه می‌شود)" Dense Variant="Variant.Outlined"
                               Class="mb-3" Value="_toCode" ValueChanged="OnToChanged">
                        @foreach (var g in ConsumerGroups)
                        {
                            <MudSelectItem Value="@((long?)g.Key)" Disabled="@(!g.Any(Usable))">
                                @GroupLabel(g)
                            </MudSelectItem>
                        }
                    </MudSelect>

                    @* یک کالا می‌تواند در یک ماه چند فرمول داشته باشد. پیش‌فرض
                       «همه» است چون تغییرِ یکسان روی همه، کل مصرف فیزیکی ماه را
                       ثابت نگه می‌دارد و انحراف مصرف نمی‌سازد. *@
                    @if (InvolvedFormulas.Count > 2)
                    {
                        <MudAlert Severity="Severity.Info" Dense Class="mb-2">
                            یکی از این کالاها بیش از یک فرمول در این ماه دارد. تغییر
                            به یک میزان روی همه‌ی فرمول‌های تیک‌خورده پخش می‌شود تا
                            جمع مصرف ماه ثابت بماند و انحراف مصرف ایجاد نشود.
                        </MudAlert>

                        <div class="mb-3">
                            @foreach (var f in InvolvedFormulas)
                            {
                                <MudCheckBox T="bool" Dense
                                             Value="@IsPicked(f.FNUMB)"
                                             ValueChanged="@(v => PickFormula(f.FNUMB, v))"
                                             Label="@FormulaLabel(f)" />
                            }

                            @if (!HasPickOnBothSides)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error" style="display:block">
                                    از هر طرف دست‌کم یک فرمول باید تیک بخورد.
                                </MudText>
                            }
                        </div>
                    }

                    <div class="mb-3">
                        <MudNumericField T="double?" @bind-Value="_qty" Label="مقدار جابه‌جایی (واحد کاردکس ماده)"
                                          Dense Variant="Variant.Outlined" Min="0" />

                        @if (_suggestedQty is not null)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary" style="display:block">
                                پیشنهاد برای @(PrefillToCode is not null ? "صفر کردن کامل سود" : "جبران کامل زیان")
                                (@FormatAmount(PrefillLossAmount!.Value) ریال ÷
                                نرخ ماده @FormatAmount(_fromRate)): @_suggestedQty.Value.ToString("N3")
                                — قابل ویرایش است؛ برای اثر جزئی عدد کوچک‌تری بزن.
                            </MudText>
                        }
                    </div>

                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               Disabled="@(!CanPreview || _busy)" OnClick="LoadPreview" Class="mb-3">
                        پیش‌نمایش
                    </MudButton>

                    @if (_previewError is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense Class="mb-3">@_previewError</MudAlert>
                    }

                    @if (_preview is not null)
                    {
                        <MudSimpleTable Dense>
                            <thead>
                                <tr>
                                    <th>فرمول</th>
                                    <th style="text-align:left">مقدار قبل</th>
                                    <th style="text-align:left">مقدار بعد</th>
                                    <th style="text-align:left">مقدار کل قبل</th>
                                    <th style="text-align:left">مقدار کل بعد</th>
                                    <th style="text-align:left">بها قبل</th>
                                    <th style="text-align:left">بها بعد</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _preview)
                                {
                                    <tr>
                                        <td>
                                            @p.ParentName (@p.ParentCode)
                                            @if (_preview!.Count > 2)
                                            {
                                                <span class="cc-hint"> — فرمول @p.FNUMB</span>
                                            }
                                        </td>
                                        <td style="text-align:left">@p.MEGHBefore.ToString("N3")</td>
                                        <td style="text-align:left">@p.MEGHAfter.ToString("N3")</td>
                                        <td style="text-align:left">@p.MEGHkBefore.ToString("N3")</td>
                                        <td style="text-align:left">@p.MEGHkAfter.ToString("N3")</td>
                                        <td style="text-align:left">@p.CostPerUnitBefore.ToString("N0")</td>
                                        <td style="text-align:left">@p.CostPerUnitAfter.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                }
            }
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">انصراف</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(_preview is null || _busy)" OnClick="Apply">
            اعمال
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int RunId { get; set; }

    /// <summary>کد کالایی که این دیالوگ از ردیفش باز شده — پیش‌فرض «از کالا»</summary>
    [Parameter] public long? PrefillFromCode { get; set; }

    /// <summary>
    /// کد کالایی که دیالوگ از ردیفش باز شده، وقتی کالا سودده است — پیش‌فرض
    /// «به کالا». جهت برعکسِ حالت زیان‌ده است: برای پایین آوردن سود باید ماده
    /// به فرمول همان کالا **اضافه** شود، نه از آن کم.
    /// </summary>
    [Parameter] public long? PrefillToCode { get; set; }

    /// <summary>
    /// مبلغی که باید جبران شود (ریال) — زیان برای کالای زیان‌ده، سود برای کالای
    /// سودده. در هر دو حالت مقدار پیشنهادی = این مبلغ ÷ نرخ ماده.
    /// </summary>
    [Parameter] public double? PrefillLossAmount { get; set; }

    private FormulaMaterialDto? _material;
    private List<MaterialConsumerDto> _consumers = new();
    private bool _loadingConsumers;

    private long? _fromCode;
    private long? _toCode;
    private double? _qty;
    private double? _suggestedQty;
    private double  _fromRate;

    private List<RebalancePreviewDto>? _preview;
    private string? _previewError;
    private bool _busy;

    private static string MaterialText(FormulaMaterialDto? m)
        => m is null ? "" : $"{m.Name} ({m.Code})";

    private async Task<IEnumerable<FormulaMaterialDto>> SearchMaterial(string s, CancellationToken ct)
        => await Api.GetFormulaMaterialsAsync(RunId, s);

    private async Task OnMaterialChanged(FormulaMaterialDto? m)
    {
        _material = m;
        _consumers = new();
        _fromCode = null;
        _toCode = null;
        _preview = null;
        _previewError = null;

        if (m is null) return;

        _loadingConsumers = true;
        try
        {
            _consumers = await Api.GetMaterialConsumersAsync(RunId, m.Code);

            if (PrefillFromCode is not null && _consumers.Any(c => c.ParentCode == PrefillFromCode))
                _fromCode = PrefillFromCode;

            if (PrefillToCode is not null && _consumers.Any(c => c.ParentCode == PrefillToCode))
                _toCode = PrefillToCode;

            TrySuggestQty();
        }
        finally { _loadingConsumers = false; }
    }

    private void OnFromChanged(long? v)
    {
        _fromCode = v; _preview = null; ResetPicks(); TrySuggestQty();
    }

    private void OnToChanged(long? v)
    {
        _toCode = v; _preview = null; ResetPicks(); TrySuggestQty();
    }

    // ── فرمول‌های یک کالا ────────────────────────────────────────────
    // یک کالا می‌تواند در یک ماه بیش از یک فرمول داشته باشد (نمونه‌ی واقعی:
    // «شیر اسکیم» در اردیبهشت ۱۴۰۵ دو فرمول دارد). قبلاً هر فرمول یک ردیف
    // جدا در هر دو لیست بود — دو گزینه با نام و کد کاملاً یکسان، بدون هیچ
    // راهی برای تشخیص، درحالی‌که انتخاب هرکدام همان ParentCode را می‌فرستاد.

    private static bool Usable(MaterialConsumerDto c) => c.ProdQty is > 0;

    private IEnumerable<IGrouping<long, MaterialConsumerDto>> ConsumerGroups
        => _consumers.GroupBy(c => c.ParentCode);

    private static string GroupLabel(IGrouping<long, MaterialConsumerDto> g)
    {
        var usable = g.Where(Usable).ToList();
        var head   = $"{g.First().ParentName} ({g.Key})";

        if (usable.Count == 0) return head + " — بدون سند تولید";

        return usable.Count == 1
            ? $"{head} — مصرف {usable[0].MEGHk:N3}"
            : $"{head} — {usable.Count} فرمول";
    }

    /// <summary>فرمول‌های قابل‌استفاده‌ی دو طرف انتخاب‌شده</summary>
    private List<MaterialConsumerDto> InvolvedFormulas
        => _consumers
            .Where(c => Usable(c) && (c.ParentCode == _fromCode || c.ParentCode == _toCode))
            .OrderBy(c => c.ParentCode).ThenBy(c => c.FNUMB)
            .ToList();

    private readonly HashSet<int> _unpicked = new();

    private void ResetPicks() => _unpicked.Clear();

    private bool IsPicked(int fnumb) => !_unpicked.Contains(fnumb);

    private void PickFormula(int fnumb, bool picked)
    {
        if (picked) _unpicked.Remove(fnumb); else _unpicked.Add(fnumb);
        _preview = null;
    }

    private string FormulaLabel(MaterialConsumerDto f)
    {
        var side = f.ParentCode == _fromCode ? "کم" : "اضافه";
        return $"فرمول {f.FNUMB} — {f.ParentName} ({f.ParentCode}) — {side} می‌شود — "
             + $"مصرف {f.MEGHk:N3} · تولید {f.ProdQty:N0}";
    }

    private List<int> PickedFNUMBs
        => InvolvedFormulas.Where(f => IsPicked(f.FNUMB)).Select(f => f.FNUMB).ToList();

    private bool HasPickOnBothSides
        => InvolvedFormulas.Any(f => f.ParentCode == _fromCode && IsPicked(f.FNUMB))
        && InvolvedFormulas.Any(f => f.ParentCode == _toCode   && IsPicked(f.FNUMB));

    /// <summary>
    /// مقدار جابه‌جایی را از روی «مبلغ ÷ نرخ ماده» پیشنهاد می‌دهد تا کاربر
    /// مجبور نباشد خودش این تقسیم را دستی انجام دهد؛ همچنان قابل ویرایش است.
    ///
    /// دو جهت دارد و هر دو از همان کالایی می‌آیند که دیالوگ از رویش باز شده:
    ///   • کالای زیان‌ده  → سمت مبدأ است؛ ماده از فرمولش کم می‌شود تا بها پایین
    ///     بیاید و زیان جبران شود.
    ///   • کالای سودده   → سمت مقصد است؛ ماده به فرمولش اضافه می‌شود تا بها بالا
    ///     برود و سود تا صفر پایین بیاید.
    /// </summary>
    private void TrySuggestQty()
    {
        _suggestedQty = null;

        if (PrefillLossAmount is not > 0) return;

        // کالای سودده: مقصد است، پس نرخ ماده را از همان سمت می‌گیریم
        if (PrefillToCode is not null && _toCode == PrefillToCode)
        {
            var toConsumer = _consumers.FirstOrDefault(
                c => c.ParentCode == _toCode && c.Rate > 0);
            if (toConsumer is null) return;

            _fromRate = toConsumer.Rate;
            _suggestedQty = Math.Round(PrefillLossAmount.Value / toConsumer.Rate, 3);
            _qty = _suggestedQty;
            return;
        }

        if (_fromCode != PrefillFromCode) return;

        var fromConsumer = _consumers.FirstOrDefault(c => c.ParentCode == _fromCode);
        if (fromConsumer is null || fromConsumer.Rate <= 0) return;

        _fromRate = fromConsumer.Rate;
        _suggestedQty = Math.Round(PrefillLossAmount.Value / fromConsumer.Rate, 3);
        _qty = _suggestedQty;
    }

    private static string FormatAmount(double v) => v.ToString("N0");

    private bool CanPreview =>
        _fromCode is not null && _toCode is not null && _fromCode != _toCode &&
        _qty is > 0 && HasPickOnBothSides;

    private RebalanceMaterialRequest BuildRequest() => new()
    {
        MaterialCode   = _material!.Code,
        FromParentCode = _fromCode!.Value,
        ToParentCode   = _toCode!.Value,
        Qty            = _qty!.Value,
        // وقتی هیچ تیکی برداشته نشده، null می‌فرستیم تا رویه خودش «همه»
        // را بردارد — یک مسیر، نه دو مسیرِ موازی که بتوانند از هم جدا بیفتند.
        SelectedFNUMBs = _unpicked.Count == 0 ? null : PickedFNUMBs
    };

    private async Task LoadPreview()
    {
        _busy = true;
        _previewError = null;
        try
        {
            var (ok, preview, err) = await Api.RebalanceMaterialAsync(RunId, BuildRequest(), whatIf: true);
            if (!ok) { _previewError = err; _preview = null; return; }

            _preview = preview;
        }
        finally { _busy = false; }
    }

    private async Task Apply()
    {
        _busy = true;
        try
        {
            var (ok, _, err) = await Api.RebalanceMaterialAsync(RunId, BuildRequest(), whatIf: false);
            if (!ok)
            {
                Snackbar.Add(err ?? "اعمال ناموفق بود", Severity.Error);
                return;
            }

            Snackbar.Add("مصرف ماده جابه‌جا شد — نرخ‌ها باید دوباره منتشر شوند", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally { _busy = false; }
    }

    private void Cancel() => MudDialog.Cancel();
}
