@page "/cost-close/settings"
@using Safir.Shared.Models.CostClose
@using Safir.Shared.Constants
@using Safir.Client.Services
@inject CostCloseApiService Api
@inject Pay2AccessApiService Access
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>تنظیمات بهای تمام‌شده</PageTitle>

<div class="cc-page" dir="rtl">

    <div class="cc-toolbar">
        <CostBackButton />
        <MudText Typo="Typo.h6">تنظیمات</MudText>
    </div>

    @if (_busy) { <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-3" /> }

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_loadError</MudAlert>
    }

    <MudTabs Elevation="0" Rounded ApplyEffectsToContainer>

        <!-- واحدهای تولیدی -->
        <MudTabPanel Text="واحدهای تولیدی">
            <MudAlert Severity="Severity.Info" Dense Class="mb-3">
                هر واحد باید دقیقاً یک انبار با نقش «مبنای انحراف» داشته باشد.
                مانده آن انبار، انحراف مصرف همان واحد است.
            </MudAlert>

            @if (Access.CanInp(CostForms.Settings))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" Class="mb-3"
                           OnClick="OpenAddUnit">
                    افزودن واحد
                </MudButton>
            }

            @foreach (var u in _units)
            {
                <MudPaper Class="cc-rule-card mb-3" Elevation="0">
                    <div class="cc-rule-head">
                        <MudIcon Icon="@Icons.Material.Filled.Factory" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2">@u.UnitName</MudText>

                        @if (u.Depatman is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                دپارتمان @u.Depatman
                            </MudChip>
                        }

                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                 Color="@(u.SplitMode == 1 ? Color.Default : Color.Info)">
                            @(u.SplitMode == 1 ? "یک ضریب" : "دو ضریب مجزا")
                        </MudChip>

                        <MudSpacer />

                        @if (!HasBaseAnbar(u))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error"
                                     Variant="Variant.Text">
                                انبار مبنای انحراف ندارد
                            </MudChip>
                        }

                        @if (Access.CanUpd(CostForms.Settings))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           OnClick="@(() => OpenEditUnit(u))" />
                        }
                        @if (Access.CanDel(CostForms.Settings))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error" OnClick="@(() => DeleteUnit(u))" />
                        }
                    </div>

                    <MudText Typo="Typo.caption" Class="cc-hint mt-2">انبارها</MudText>
                    <MudTable Items="u.Anbars" Dense Elevation="0" T="CostUnitAnbarDto">
                        <HeaderContent>
                            <MudTh Style="width:80px">انبار</MudTh>
                            <MudTh>نام</MudTh>
                            <MudTh Style="width:150px">نقش</MudTh>
                            <MudTh Style="width:120px">انبارگردانی</MudTh>
                            <MudTh Style="width:90px"></MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd><span class="cc-num">@context.Anbar</span></MudTd>
                            <MudTd>@(context.AnbarName ?? "—")</MudTd>

                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                         Color="@(context.AnbarRole == 1 ? Color.Primary : Color.Default)">
                                    @context.RoleText
                                </MudChip>
                            </MudTd>

                            <MudTd>
                                <MudIcon Icon="@(context.DoStockCount
                                                 ? Icons.Material.Filled.CheckCircle
                                                 : Icons.Material.Filled.RemoveCircleOutline)"
                                         Color="@(context.DoStockCount ? Color.Success : Color.Default)"
                                         Size="Size.Small" />
                            </MudTd>

                            <MudTd>
                                @if (Access.CanUpd(CostForms.Settings))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   OnClick="@(() => OpenEditAnbar(u, context))" />
                                }
                                @if (Access.CanDel(CostForms.Settings))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   Color="Color.Error" OnClick="@(() => DeleteAnbar(u, context))" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>

                    @if (Access.CanInp(CostForms.Settings))
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add" Class="mt-1"
                                   OnClick="@(() => OpenAddAnbar(u))">
                            افزودن انبار
                        </MudButton>
                    }

                    <MudText Typo="Typo.caption" Class="cc-hint mt-3">حساب‌های دستمزد و سربار</MudText>
                    <MudTable Items="u.Accounts" Dense Elevation="0" T="CostUnitAccDto">
                        <HeaderContent>
                            <MudTh>کل</MudTh>
                            <MudTh>معین</MudTh>
                            <MudTh>تفصیلی</MudTh>
                            <MudTh Style="width:90px">نوع</MudTh>
                            <MudTh Style="width:80px">ضریب</MudTh>
                            <MudTh Style="width:70px">فعال</MudTh>
                            <MudTh>یادداشت</MudTh>
                            <MudTh Style="width:90px"></MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd><span class="cc-num">@context.HesKol</span> @(context.KolName ?? "")</MudTd>
                            <MudTd>
                                @if (context.HesMoin is not null)
                                {
                                    <span><span class="cc-num">@context.HesMoin</span> @(context.MoinName ?? "")</span>
                                }
                                else { <span class="cc-hint">همه</span> }
                            </MudTd>
                            <MudTd>
                                @if (context.HesTafsili is not null)
                                {
                                    <span><span class="cc-num">@context.HesTafsili</span> @(context.TafsiliName ?? "")</span>
                                }
                                else { <span class="cc-hint">همه</span> }
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                         Color="@(context.CostKind == 1 ? Color.Info : Color.Warning)">
                                    @context.CostKindText
                                </MudChip>
                            </MudTd>
                            <MudTd><span class="cc-num">@context.Ratio</span></MudTd>
                            <MudTd>
                                <MudIcon Icon="@(context.IsActive
                                                 ? Icons.Material.Filled.CheckCircle
                                                 : Icons.Material.Filled.RemoveCircleOutline)"
                                         Color="@(context.IsActive ? Color.Success : Color.Default)"
                                         Size="Size.Small" />
                            </MudTd>
                            <MudTd>@(context.Note ?? "—")</MudTd>
                            <MudTd>
                                @if (Access.CanUpd(CostForms.Settings))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   OnClick="@(() => OpenEditAcc(u, context))" />
                                }
                                @if (Access.CanDel(CostForms.Settings))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   Color="Color.Error" OnClick="@(() => DeleteAcc(u, context))" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>

                    @if (Access.CanInp(CostForms.Settings))
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add" Class="mt-1"
                                   OnClick="@(() => OpenAddAcc(u))">
                            افزودن حساب
                        </MudButton>
                    }
                </MudPaper>
            }
        </MudTabPanel>

        <!-- قواعد تشخیص -->
        <MudTabPanel Text="قواعد تشخیص">
            <MudAlert Severity="Severity.Info" Dense Class="mb-3">
                هر قاعده یک کنترل خودکار است. متن «راه رفع» همان چیزی است که
                هنگام بروز مغایرت به کاربر نشان داده می‌شود.
            </MudAlert>

            <MudPaper Class="cc-rule-card" Elevation="0">
                <MudTable Items="_rules" Dense Hover Elevation="0" T="CostCheckRuleDto">
                    <HeaderContent>
                        <MudTh Style="width:80px">کد</MudTh>
                        <MudTh Style="width:220px">قاعده</MudTh>
                        <MudTh Style="width:60px">گام</MudTh>
                        <MudTh Style="width:110px">شدت</MudTh>
                        <MudTh Style="text-align:left;width:90px">آستانه</MudTh>
                        <MudTh>راه رفع</MudTh>
                        <MudTh Style="width:70px">فعال</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd><span class="cc-num">@context.RuleCode</span></MudTd>
                        <MudTd>@context.RuleName</MudTd>
                        <MudTd><span class="cc-num">@context.StepCode</span></MudTd>

                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                     Color="@(context.DefaultSeverity == 2 ? Color.Error : Color.Warning)">
                                @(context.DefaultSeverity == 2 ? "مسدودکننده" : "هشدار")
                            </MudChip>
                        </MudTd>

                        <MudTd Style="text-align:left">
                            <span class="cc-num">
                                @(context.Threshold is null ? "—" : FormatThreshold(context.Threshold.Value))
                            </span>
                        </MudTd>

                        <MudTd>
                            <MudText Typo="Typo.caption">@context.RemedyText</MudText>
                            @if (!string.IsNullOrEmpty(context.FixButtonText))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                         Variant="Variant.Text" Class="mt-1">
                                    <MudIcon Icon="@Icons.Material.Filled.AutoFixHigh"
                                             Size="Size.Small" Class="ml-1" />
                                    @context.FixButtonText
                                </MudChip>
                            }
                        </MudTd>

                        <MudTd>
                            <MudIcon Icon="@(context.IsActive
                                             ? Icons.Material.Filled.CheckCircle
                                             : Icons.Material.Filled.RemoveCircleOutline)"
                                     Color="@(context.IsActive ? Color.Success : Color.Default)"
                                     Size="Size.Small" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudTabPanel>

    </MudTabs>
</div>

@code {
    private List<CostUnitDto>      _units = new();
    private List<CostCheckRuleDto> _rules = new();
    private bool _busy;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        await Access.EnsureLoadedAsync();

        _busy = true;
        try
        {
            _units = await Api.GetUnitsAsync();
            _rules = await Api.GetRulesAsync();
        }
        catch (Exception ex) { _loadError = FriendlyError(ex); }
        finally { _busy = false; }
    }

    private async Task ReloadUnits()
    {
        try { _units = await Api.GetUnitsAsync(); }
        catch (Exception ex) { Snackbar.Add(FriendlyError(ex), Severity.Error); }
    }

    // ───────── واحد ─────────

    private async Task OpenAddUnit()
    {
        var dlg = await Dialog.ShowAsync<UnitEditDialog>("افزودن واحد", new DialogParameters());
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: UpsertUnitRequest req })
        {
            var (ok, _, err) = await Api.CreateUnitAsync(req);
            if (ok) { Snackbar.Add("واحد افزوده شد.", Severity.Success); await ReloadUnits(); }
            else Snackbar.Add(err ?? "افزودن واحد ناموفق بود.", Severity.Error);
        }
    }

    private async Task OpenEditUnit(CostUnitDto u)
    {
        var p = new DialogParameters { ["Existing"] = u };
        var dlg = await Dialog.ShowAsync<UnitEditDialog>("ویرایش واحد", p);
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: UpsertUnitRequest req })
        {
            var (ok, err) = await Api.UpdateUnitAsync(u.UnitId, req);
            if (ok) { Snackbar.Add("واحد به‌روزرسانی شد.", Severity.Success); await ReloadUnits(); }
            else Snackbar.Add(err ?? "به‌روزرسانی واحد ناموفق بود.", Severity.Error);
        }
    }

    private async Task DeleteUnit(CostUnitDto u)
    {
        var ok = await Dialog.ShowMessageBox(
            "حذف واحد", $"واحد «{u.UnitName}» حذف شود؟ در صورت استفاده در اجراهای قبلی، حذف رد می‌شود.",
            yesText: "حذف", cancelText: "انصراف");
        if (ok != true) return;

        var (done, err) = await Api.DeleteUnitAsync(u.UnitId);
        if (done) { Snackbar.Add("واحد حذف شد.", Severity.Success); await ReloadUnits(); }
        else Snackbar.Add(err ?? "حذف واحد ناموفق بود.", Severity.Error);
    }

    // ───────── انبار واحد ─────────

    private async Task OpenAddAnbar(CostUnitDto u)
    {
        var dlg = await Dialog.ShowAsync<UnitAnbarEditDialog>("افزودن انبار", new DialogParameters());
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: UpsertUnitAnbarRequest req })
        {
            var (ok, err) = await Api.AddUnitWarehouseAsync(u.UnitId, req);
            if (ok) { Snackbar.Add("انبار افزوده شد.", Severity.Success); await ReloadUnits(); }
            else Snackbar.Add(err ?? "افزودن انبار ناموفق بود.", Severity.Error);
        }
    }

    private async Task OpenEditAnbar(CostUnitDto u, CostUnitAnbarDto a)
    {
        var p = new DialogParameters { ["Existing"] = a };
        var dlg = await Dialog.ShowAsync<UnitAnbarEditDialog>("ویرایش انبار", p);
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: UpsertUnitAnbarRequest req })
        {
            var (ok, err) = await Api.UpdateUnitWarehouseAsync(u.UnitId, a.Anbar, req);
            if (ok) { Snackbar.Add("انبار به‌روزرسانی شد.", Severity.Success); await ReloadUnits(); }
            else Snackbar.Add(err ?? "به‌روزرسانی انبار ناموفق بود.", Severity.Error);
        }
    }

    private async Task DeleteAnbar(CostUnitDto u, CostUnitAnbarDto a)
    {
        var ok = await Dialog.ShowMessageBox(
            "حذف انبار", $"انبار «{a.AnbarName ?? a.Anbar.ToString()}» از واحد «{u.UnitName}» حذف شود؟",
            yesText: "حذف", cancelText: "انصراف");
        if (ok != true) return;

        var (done, err) = await Api.DeleteUnitWarehouseAsync(u.UnitId, a.Anbar);
        if (done) { Snackbar.Add("انبار حذف شد.", Severity.Success); await ReloadUnits(); }
        else Snackbar.Add(err ?? "حذف انبار ناموفق بود.", Severity.Error);
    }

    // ───────── حساب دستمزد/سربار واحد ─────────

    private async Task OpenAddAcc(CostUnitDto u)
    {
        var dlg = await Dialog.ShowAsync<UnitAccEditDialog>("افزودن حساب", new DialogParameters());
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: UpsertUnitAccRequest req })
        {
            var (ok, err) = await Api.AddUnitAccountAsync(u.UnitId, req);
            if (ok) { Snackbar.Add("حساب افزوده شد.", Severity.Success); await ReloadUnits(); }
            else Snackbar.Add(err ?? "افزودن حساب ناموفق بود.", Severity.Error);
        }
    }

    private async Task OpenEditAcc(CostUnitDto u, CostUnitAccDto acc)
    {
        var p = new DialogParameters { ["Existing"] = acc };
        var dlg = await Dialog.ShowAsync<UnitAccEditDialog>("ویرایش حساب", p);
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: UpsertUnitAccRequest req })
        {
            var (ok, err) = await Api.UpdateUnitAccountAsync(u.UnitId, acc.Id, req);
            if (ok) { Snackbar.Add("حساب به‌روزرسانی شد.", Severity.Success); await ReloadUnits(); }
            else Snackbar.Add(err ?? "به‌روزرسانی حساب ناموفق بود.", Severity.Error);
        }
    }

    private async Task DeleteAcc(CostUnitDto u, CostUnitAccDto acc)
    {
        var ok = await Dialog.ShowMessageBox(
            "حذف حساب", $"حساب «{acc.HesKol}» از واحد «{u.UnitName}» حذف شود؟",
            yesText: "حذف", cancelText: "انصراف");
        if (ok != true) return;

        var (done, err) = await Api.DeleteUnitAccountAsync(u.UnitId, acc.Id);
        if (done) { Snackbar.Add("حساب حذف شد.", Severity.Success); await ReloadUnits(); }
        else Snackbar.Add(err ?? "حذف حساب ناموفق بود.", Severity.Error);
    }

    private static string FriendlyError(Exception ex)
    {
        if (ex is HttpRequestException http)
        {
            if (http.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                return "برای مشاهده این صفحه باید وارد شوید.";
            if (http.StatusCode == System.Net.HttpStatusCode.Forbidden)
                return "دسترسی لازم برای مشاهده تنظیمات را ندارید.";
        }

        return "خواندن تنظیمات ناموفق بود. اگر تکرار شد به پشتیبانی اطلاع دهید.";
    }

    /// <summary>بدون انبار مبنای انحراف، محاسبه انحراف آن واحد کار نمی‌کند</summary>
    private static bool HasBaseAnbar(CostUnitDto u)
        => u.Anbars.Any(a => a.AnbarRole == 1);

    private static string FormatThreshold(double v)
        => v < 1 ? $"{v * 100:N1}٪" : v.ToString("N0");
}
