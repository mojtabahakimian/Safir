@page "/cost-close/settings"
@using Safir.Shared.Models.CostClose
@using Safir.Shared.Constants
@using Safir.Client.Services
@inject CostCloseApiService Api
@inject Pay2AccessApiService Access
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>تنظیمات بهای تمام‌شده</PageTitle>

<div class="cc-page" dir="rtl">

    <div class="cc-toolbar">
        <CostBackButton />
        <MudText Typo="Typo.h6">تنظیمات</MudText>
    </div>

    @if (_busy) { <MudProgressLinear Indeterminate Color="Color.Primary" Class="mb-3" /> }

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_loadError</MudAlert>
    }

    <MudTabs Elevation="0" Rounded ApplyEffectsToContainer>

        <!-- واحدهای تولیدی -->
        <MudTabPanel Text="واحدهای تولیدی">
            <MudAlert Severity="Severity.Info" Dense Class="mb-3">
                هر واحد باید دقیقاً یک انبار با نقش «مبنای انحراف» داشته باشد.
                مانده آن انبار، انحراف مصرف همان واحد است.
            </MudAlert>

            @if (Access.CanInp(CostForms.Settings))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" Class="mb-3"
                           OnClick="OpenAddUnit">
                    افزودن واحد
                </MudButton>
            }

            @foreach (var u in _units)
            {
                <MudPaper Class="cc-rule-card mb-3" Elevation="0">
                    <div class="cc-rule-head">
                        <MudIcon Icon="@Icons.Material.Filled.Factory" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2">@u.UnitName</MudText>

                        @if (u.Depatman is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                دپارتمان @u.Depatman
                            </MudChip>
                        }

                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                 Color="@(u.SplitMode == 1 ? Color.Default : Color.Info)">
                            @(u.SplitMode == 1 ? "یک ضریب" : "دو ضریب مجزا")
                        </MudChip>

                        <MudSpacer />

                        @if (!HasBaseAnbar(u))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error"
                                     Variant="Variant.Text">
                                انبار مبنای انحراف ندارد
                            </MudChip>
                        }

                        @if (Access.CanUpd(CostForms.Settings))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           OnClick="@(() => OpenEditUnit(u))" />
                        }
                        @if (Access.CanDel(CostForms.Settings))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error" OnClick="@(() => DeleteUnit(u))" />
                        }
                    </div>

                    <MudText Typo="Typo.caption" Class="cc-hint mt-2">انبارها</MudText>
                    <MudTable Items="u.Anbars" Dense Elevation="0" T="CostUnitAnbarDto">
                        <HeaderContent>
                            <MudTh Style="width:80px">انبار</MudTh>
                            <MudTh>نام</MudTh>
                            <MudTh Style="width:150px">نقش</MudTh>
                            <MudTh Style="width:120px">انبارگردانی</MudTh>
                            <MudTh Style="width:90px"></MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd><span class="cc-num">@context.Anbar</span></MudTd>
                            <MudTd>@(context.AnbarName ?? "—")</MudTd>

                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                         Color="@(context.AnbarRole == 1 ? Color.Primary : Color.Default)">
                                    @context.RoleText
                                </MudChip>
                            </MudTd>

                            <MudTd>
                                <MudIcon Icon="@(context.DoStockCount
                                                 ? Icons.Material.Filled.CheckCircle
                                                 : Icons.Material.Filled.RemoveCircleOutline)"
                                         Color="@(context.DoStockCount ? Color.Success : Color.Default)"
                                         Size="Size.Small" />
                            </MudTd>

                            <MudTd>
                                @if (Access.CanUpd(CostForms.Settings))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   OnClick="@(() => OpenEditAnbar(u, context))" />
                                }
                                @if (Access.CanDel(CostForms.Settings))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   Color="Color.Error" OnClick="@(() => DeleteAnbar(u, context))" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>

                    @if (Access.CanInp(CostForms.Settings))
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add" Class="mt-1"
                                   OnClick="@(() => OpenAddAnbar(u))">
                            افزودن انبار
                        </MudButton>
                    }

                    <MudText Typo="Typo.caption" Class="cc-hint mt-3">حساب‌های دستمزد و سربار</MudText>
                    <MudTable Items="u.Accounts" Dense Elevation="0" T="CostUnitAccDto">
                        <HeaderContent>
                            <MudTh>کل</MudTh>
                            <MudTh>معین</MudTh>
                            <MudTh>تفصیلی</MudTh>
                            <MudTh Style="width:90px">نوع</MudTh>
                            <MudTh Style="width:80px">ضریب</MudTh>
                            <MudTh Style="width:70px">فعال</MudTh>
                            <MudTh>یادداشت</MudTh>
                            <MudTh Style="width:90px"></MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd><span class="cc-num">@context.HesKol</span> @(context.KolName ?? "")</MudTd>
                            <MudTd>
                                @if (context.HesMoin is not null)
                                {
                                    <span><span class="cc-num">@context.HesMoin</span> @(context.MoinName ?? "")</span>
                                }
                                else { <span class="cc-hint">همه</span> }
                            </MudTd>
                            <MudTd>
                                @if (context.HesTafsili is not null)
                                {
                                    <span><span class="cc-num">@context.HesTafsili</span> @(context.TafsiliName ?? "")</span>
                                }
                                else { <span class="cc-hint">همه</span> }
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                         Color="@(context.CostKind == 1 ? Color.Info : Color.Warning)">
                                    @context.CostKindText
                                </MudChip>
                            </MudTd>
                            <MudTd><span class="cc-num">@context.Ratio</span></MudTd>
                            <MudTd>
                                <MudIcon Icon="@(context.IsActive
                                                 ? Icons.Material.Filled.CheckCircle
                                                 : Icons.Material.Filled.RemoveCircleOutline)"
                                         Color="@(context.IsActive ? Color.Success : Color.Default)"
                                         Size="Size.Small" />
                            </MudTd>
                            <MudTd>@(context.Note ?? "—")</MudTd>
                            <MudTd>
                                @if (Access.CanUpd(CostForms.Settings))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   OnClick="@(() => OpenEditAcc(u, context))" />
                                }
                                @if (Access.CanDel(CostForms.Settings))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   Color="Color.Error" OnClick="@(() => DeleteAcc(u, context))" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>

                    @if (Access.CanInp(CostForms.Settings))
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add" Class="mt-1"
                                   OnClick="@(() => OpenAddAcc(u))">
                            افزودن حساب
                        </MudButton>
                    }
                </MudPaper>
            }
        </MudTabPanel>

        <!-- نگاشت انبار به حساب موجودی -->
        <MudTabPanel Text="نگاشت انبار⇄حساب">
            <MudAlert Severity="Severity.Info" Dense Class="mb-3">
                هر انبار زیر یک معین جداگانه در حسابداری ثبت می‌شود، نه یک معین
                مشترک برای همه. بدون این نگاشت، کنترل «مغایرت کارت انبار و
                حسابداری» (CHK-02) غیرفعال می‌ماند.
            </MudAlert>

            <div class="d-flex ga-2 mb-3 align-center">
                @if (Access.CanInp(CostForms.Settings))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenAddAnbarHes">
                        افزودن نگاشت انبار
                    </MudButton>
                }
                <ExcelExportButton T="CostAnbarHesDto" Items="_anbarHes" Columns="_anbarHesCols" FileName="نگاشت_انبار_حساب" />
            </div>

            <MudPaper Class="cc-rule-card" Elevation="0">
                <MudTable Items="_anbarHes" Dense Hover Elevation="0" T="CostAnbarHesDto">
                    <HeaderContent>
                        <MudTh Style="width:110px">انبار</MudTh>
                        <MudTh>کل</MudTh>
                        <MudTh>معین</MudTh>
                        <MudTh>یادداشت</MudTh>
                        <MudTh Style="width:90px"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><span class="cc-num">@context.Anbar</span> @(context.AnbarName ?? "")</MudTd>
                        <MudTd><span class="cc-num">@context.HesKol</span> @(context.KolName ?? "")</MudTd>
                        <MudTd><span class="cc-num">@context.HesMoin</span> @(context.MoinName ?? "")</MudTd>
                        <MudTd>@(context.Note ?? "—")</MudTd>
                        <MudTd>
                            @if (Access.CanUpd(CostForms.Settings))
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               OnClick="@(() => OpenEditAnbarHes(context))" />
                            }
                            @if (Access.CanDel(CostForms.Settings))
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               Color="Color.Error" OnClick="@(() => DeleteAnbarHes(context))" />
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudTabPanel>

        <!-- نرخ استاندارد دستمزد -->
        <MudTabPanel Text="نرخ استاندارد دستمزد">
            <MudAlert Severity="Severity.Info" Dense Class="mb-3">
                این ضریب (مثلاً بر مبنای وزن، حجم یا ارزش فروش) در گام S07B،
                دستمزد واقعیِ همان واحد تولیدی (از حساب ۷۵۱) را به نسبت
                (مقدار تولید × ضریب) بین کالاهای همان واحد تقسیم می‌کند و
                نتیجه را در IMBIBE_MANF فرمول همان کالا می‌نشاند؛ سربار
                (IMBIBE_SAR) دست‌نخورده باقی می‌ماند. کالاهای «کارمزدی» را
                به‌جای ضریب می‌توانید علامت بزنید — نرخشان همیشه ثابت
                می‌ماند، نه S07B و نه ضریب تعدیل S10 دست‌شان می‌زنند.
            </MudAlert>

            <div class="d-flex ga-2 mb-3">
                @if (Access.CanInp(CostForms.Settings))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenAddLaborRate">
                        افزودن ضریب دستمزد
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Sync"
                               OnClick="SyncLaborRatesFromFormulas">
                        همگام‌سازی از فرمول‌های تولید
                    </MudButton>
                }
                <ExcelExportButton T="CostLaborRateDto" Items="_laborRates" Columns="_laborRateCols" FileName="نرخ_استاندارد_دستمزد" />
            </div>

            <MudPaper Class="cc-rule-card" Elevation="0">
                <MudTable Items="_laborRates" Dense Hover Elevation="0" T="CostLaborRateDto">
                    <HeaderContent>
                        <MudTh Style="width:130px">واحد تولیدی</MudTh>
                        <MudTh Style="width:110px">کد کالا</MudTh>
                        <MudTh>نام کالا</MudTh>
                        <MudTh>ضریب دستمزد</MudTh>
                        <MudTh>ضریب سربار</MudTh>
                        <MudTh Style="width:100px"></MudTh>
                        <MudTh>یادداشت</MudTh>
                        <MudTh Style="width:90px"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@(context.UnitName ?? context.UnitId.ToString())</MudTd>
                        <MudTd><span class="cc-num">@context.Code</span></MudTd>
                        <MudTd>@(context.ItemName ?? "")</MudTd>
                        <MudTd>
                            @if (context.IsFixed)
                            {
                                <span class="cc-num">—</span>
                            }
                            else if (context.Coefficient is null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">هنوز تعیین نشده</MudChip>
                            }
                            else
                            {
                                <span class="cc-num">@context.Coefficient.Value.ToString("N3")</span>
                            }
                        </MudTd>
                        <MudTd>
                            @if (context.IsFixed)
                            {
                                <span class="cc-num">—</span>
                            }
                            else if (context.OverheadCoefficient is not null)
                            {
                                <span class="cc-num">@context.OverheadCoefficient.Value.ToString("N3")</span>
                            }
                            else if (context.Coefficient is not null)
                            {
                                <span class="cc-num" style="opacity:.6">@context.Coefficient.Value.ToString("N3") (از دستمزد)</span>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">هنوز تعیین نشده</MudChip>
                            }
                        </MudTd>
                        <MudTd>
                            @if (context.IsFixed)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">کارمزدی — نرخ ثابت</MudChip>
                            }
                        </MudTd>
                        <MudTd>@(context.Note ?? "—")</MudTd>
                        <MudTd>
                            @if (Access.CanUpd(CostForms.Settings))
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               OnClick="@(() => OpenEditLaborRate(context))" />
                            }
                            @if (Access.CanDel(CostForms.Settings))
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               Color="Color.Error" OnClick="@(() => DeleteLaborRate(context))" />
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudTabPanel>

        <!-- قواعد تشخیص -->
        <MudTabPanel Text="قواعد تشخیص">
            <MudAlert Severity="Severity.Info" Dense Class="mb-3">
                هر قاعده یک کنترل خودکار است. متن «راه رفع» همان چیزی است که
                هنگام بروز مغایرت به کاربر نشان داده می‌شود.
            </MudAlert>

            <div class="d-flex mb-3">
                <ExcelExportButton T="CostCheckRuleDto" Items="_rules" Columns="_ruleCols" FileName="قواعد_تشخیص" />
            </div>

            <MudPaper Class="cc-rule-card" Elevation="0">
                <MudTable Items="_rules" Dense Hover Elevation="0" T="CostCheckRuleDto">
                    <HeaderContent>
                        <MudTh Style="width:80px">کد</MudTh>
                        <MudTh Style="width:220px">قاعده</MudTh>
                        <MudTh Style="width:60px">گام</MudTh>
                        <MudTh Style="width:110px">شدت</MudTh>
                        <MudTh Style="text-align:left;width:90px">آستانه</MudTh>
                        <MudTh>راه رفع</MudTh>
                        <MudTh Style="width:70px">فعال</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd><span class="cc-num">@context.RuleCode</span></MudTd>
                        <MudTd>@context.RuleName</MudTd>
                        <MudTd><span class="cc-num">@context.StepCode</span></MudTd>

                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                     Color="@(context.DefaultSeverity == 2 ? Color.Error : Color.Warning)">
                                @(context.DefaultSeverity == 2 ? "مسدودکننده" : "هشدار")
                            </MudChip>
                        </MudTd>

                        <MudTd Style="text-align:left">
                            @if (_editingRuleCode == context.RuleCode)
                            {
                                <div style="display:flex;align-items:center;gap:4px">
                                    <MudNumericField T="double?" @bind-Value="_editingThreshold"
                                                      Format="0.######" Dense Immediate
                                                      Style="width:110px" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small"
                                                   Color="Color.Success"
                                                   OnClick="@(() => SaveThreshold(context.RuleCode))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   OnClick="@(() => _editingRuleCode = null)" />
                                </div>
                            }
                            else
                            {
                                <span class="cc-num">
                                    @(context.Threshold is null ? "—" : FormatThreshold(context.Threshold.Value))
                                </span>
                                @if (Access.CanUpd(CostForms.Settings))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   OnClick="@(() => StartEditThreshold(context))" />
                                }
                            }
                        </MudTd>

                        <MudTd>
                            <MudText Typo="Typo.caption">@context.RemedyText</MudText>
                            @if (!string.IsNullOrEmpty(context.FixButtonText))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                         Variant="Variant.Text" Class="mt-1">
                                    <MudIcon Icon="@Icons.Material.Filled.AutoFixHigh"
                                             Size="Size.Small" Class="ml-1" />
                                    @context.FixButtonText
                                </MudChip>
                            }
                        </MudTd>

                        <MudTd>
                            <MudIcon Icon="@(context.IsActive
                                             ? Icons.Material.Filled.CheckCircle
                                             : Icons.Material.Filled.RemoveCircleOutline)"
                                     Color="@(context.IsActive ? Color.Success : Color.Default)"
                                     Size="Size.Small" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudTabPanel>

    </MudTabs>
</div>

@code {
    private static readonly IReadOnlyList<ExcelCol<CostAnbarHesDto>> _anbarHesCols = new[]
    {
        new ExcelCol<CostAnbarHesDto> { Title = "انبار",   Text = r => $"{r.Anbar} {r.AnbarName}" },
        new ExcelCol<CostAnbarHesDto> { Title = "کل",      Text = r => $"{r.HesKol} {r.KolName}" },
        new ExcelCol<CostAnbarHesDto> { Title = "معین",    Text = r => $"{r.HesMoin} {r.MoinName}" },
        new ExcelCol<CostAnbarHesDto> { Title = "یادداشت", Text = r => r.Note ?? "" },
    };

    private static readonly IReadOnlyList<ExcelCol<CostLaborRateDto>> _laborRateCols = new[]
    {
        new ExcelCol<CostLaborRateDto> { Title = "واحد تولیدی", Text = r => r.UnitName ?? r.UnitId.ToString() },
        new ExcelCol<CostLaborRateDto> { Title = "کد کالا",     Text = r => r.Code },
        new ExcelCol<CostLaborRateDto> { Title = "نام کالا",    Text = r => r.ItemName ?? "" },
        new ExcelCol<CostLaborRateDto> { Title = "ضریب دستمزد", IsNumber = true, Number = r => r.IsFixed ? null : r.Coefficient },
        new ExcelCol<CostLaborRateDto> { Title = "ضریب سربار",  IsNumber = true, Number = r => r.IsFixed ? null : (r.OverheadCoefficient ?? r.Coefficient) },
        new ExcelCol<CostLaborRateDto> { Title = "کارمزدی",     Text = r => r.IsFixed ? "بله" : "" },
        new ExcelCol<CostLaborRateDto> { Title = "یادداشت",     Text = r => r.Note ?? "" },
    };

    private static readonly IReadOnlyList<ExcelCol<CostCheckRuleDto>> _ruleCols = new[]
    {
        new ExcelCol<CostCheckRuleDto> { Title = "کد",     Text = r => r.RuleCode },
        new ExcelCol<CostCheckRuleDto> { Title = "قاعده",  Text = r => r.RuleName },
        new ExcelCol<CostCheckRuleDto> { Title = "گام",    Text = r => r.StepCode },
        new ExcelCol<CostCheckRuleDto> { Title = "شدت",    Text = r => r.DefaultSeverity == 2 ? "مسدودکننده" : "هشدار" },
        new ExcelCol<CostCheckRuleDto> { Title = "آستانه", IsNumber = true, Number = r => r.Threshold },
        new ExcelCol<CostCheckRuleDto> { Title = "راه رفع", Text = r => r.RemedyText ?? "" },
        new ExcelCol<CostCheckRuleDto> { Title = "فعال",   Text = r => r.IsActive ? "بله" : "خیر" },
    };

    private List<CostUnitDto>      _units = new();
    private List<CostCheckRuleDto> _rules = new();
    private List<CostAnbarHesDto>  _anbarHes = new();
    private List<CostLaborRateDto> _laborRates = new();
    private bool _busy;
    private string? _loadError;

    private string? _editingRuleCode;
    private double? _editingThreshold;

    protected override async Task OnInitializedAsync()
    {
        await Access.EnsureLoadedAsync();

        _busy = true;
        try
        {
            _units      = await Api.GetUnitsAsync();
            _rules      = await Api.GetRulesAsync();
            _anbarHes   = await Api.GetAnbarHesAsync();
            _laborRates = await Api.GetLaborRatesAsync();
        }
        catch (Exception ex) { _loadError = FriendlyError(ex); }
        finally { _busy = false; }
    }

    private async Task ReloadAnbarHes()
    {
        try { _anbarHes = await Api.GetAnbarHesAsync(); }
        catch (Exception ex) { Snackbar.Add(FriendlyError(ex), Severity.Error); }
    }

    private async Task OpenAddAnbarHes()
    {
        var dlg = await Dialog.ShowAsync<AnbarHesEditDialog>("افزودن نگاشت انبار", new DialogParameters());
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: UpsertAnbarHesRequest req })
        {
            var (ok, err) = await Api.AddAnbarHesAsync(req);
            if (ok) { Snackbar.Add("نگاشت افزوده شد.", Severity.Success); await ReloadAnbarHes(); }
            else Snackbar.Add(err ?? "افزودن نگاشت ناموفق بود.", Severity.Error);
        }
    }

