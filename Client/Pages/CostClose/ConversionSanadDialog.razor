@using Safir.Shared.Models.CostClose
@using Safir.Client.Services
@inject ItemConversionApiService Api

@*
    سند یک برگه‌ی تبدیل — سربرگ و آرتیکل‌ها.

    ── چرا آرتیکل‌ها هم ──
    شماره‌ی سند به‌تنهایی نمی‌گوید سند *درست* است. یک سند تبدیل باید
    دقیقاً دو طرف داشته باشد و هم‌مبلغ باشد؛ اگر یک‌طرفه یا نامتوازن
    باشد، فقط با دیدن آرتیکل‌ها معلوم می‌شود.
*@

<MudDialog>
    <DialogContent>
        <div dir="rtl" style="min-width:560px">

            @if (_busy)
            {
                <MudProgressLinear Indeterminate Color="Color.Primary" />
            }
            else if (_sanad is null)
            {
                <MudAlert Severity="Severity.Warning" Dense>
                    برای این برگه سندی صادر نشده است.
                </MudAlert>
            }
            else
            {
                <MudPaper Class="pa-3 mb-3" Elevation="0" Style="background:var(--mud-palette-background-grey)">
                    <div class="d-flex justify-space-between mb-1">
                        <span>شماره سند</span>
                        <b>@_sanad.SanadNo</b>
                    </div>
                    <div class="d-flex justify-space-between mb-1">
                        <span>تاریخ</span>
                        <b>@FormatDate(_sanad.DateS)</b>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_sanad.UserName))
                    {
                        <div class="d-flex justify-space-between">
                            <span>کاربر</span>
                            <b>@_sanad.UserName</b>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_sanad.SharhS))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">
                            @_sanad.SharhS
                        </MudText>
                    }
                </MudPaper>

                @if (_sanad.Articles.Count == 0)
                {
                    <MudAlert Severity="Severity.Error" Dense>
                        سربرگ سند هست ولی هیچ آرتیکلی ندارد — سندی که هیچ رقمی ثبت نکرده.
                    </MudAlert>
                }
                else
                {
                    <MudSimpleTable Dense Bordered="false" Striped>
                        <thead>
                            <tr>
                                <th style="text-align:right">حساب</th>
                                <th style="text-align:right">شرح</th>
                                <th style="text-align:left">بدهکار</th>
                                <th style="text-align:left">بستانکار</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in _sanad.Articles)
                            {
                                <tr>
                                    <td>
                                        <div dir="ltr" style="text-align:right">@a.Hes</div>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@a.Name</MudText>
                                    </td>
                                    <td><MudText Typo="Typo.caption">@a.Sharh</MudText></td>
                                    <td style="text-align:left">@Money(a.Bed)</td>
                                    <td style="text-align:left">@Money(a.Bes)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2"><b>جمع</b></td>
                                <td style="text-align:left"><b>@Money(_sanad.TotalBed)</b></td>
                                <td style="text-align:left"><b>@Money(_sanad.TotalBes)</b></td>
                            </tr>
                        </tfoot>
                    </MudSimpleTable>

                    @* سند تبدیل باید دقیقاً متوازن باشد — دو طرف، یک مبلغ. *@
                    @if (!_sanad.IsBalanced)
                    {
                        <MudAlert Severity="Severity.Error" Dense Class="mt-3">
                            سند نامتوازن است: اختلاف @Money(_sanad.TotalBed - _sanad.TotalBes) ریال.
                            سند را دوباره صادر کنید.
                        </MudAlert>
                    }
                    else if (_sanad.TotalBed == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense Class="mt-3">
                            سند متوازن است ولی مبلغش صفر است — حرکت ثبت شده، ارزشی جابه‌جا نشده.
                        </MudAlert>
                    }
                }
            }
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">بستن</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public double Number { get; set; }

    private SanadViewDto? _sanad;
    private bool _busy = true;

    protected override async Task OnInitializedAsync()
    {
        _sanad = await Api.GetSanadAsync(Number);
        _busy  = false;
    }

    private static string FormatDate(long d)
        => d <= 0 ? "" : $"{d / 10000:0000}/{d / 100 % 100:00}/{d % 100:00}";

    private static string Money(double v) => Math.Round(v).ToString("N0");
}
