    private sealed class DateDriftRef
    {
        public string Kind    { get; set; } = "";
        public long   ADate   { get; set; }
        public long   BDate   { get; set; }
    }

    private static (string A, string B) DateDriftLabels(string kind) => kind switch
    {
        "sale"                => ("فاکتور فروش", "حواله انبار"),
        "invoiceVsAccounting" => ("فاکتور", "سند حسابداری"),
        _                     => ("سند الف", "سند ب")
    };

    private async Task OpenDateMismatchFix(CostExceptionDto ex)
    {
        DateDriftRef refData;
        try
        {
            refData = System.Text.Json.JsonSerializer.Deserialize<DateDriftRef>(
                          ex.RefList ?? "", new System.Text.Json.JsonSerializerOptions
                          { PropertyNameCaseInsensitive = true })
                      ?? throw new Exception();
        }
        catch
        {
            Snackbar.Add("اطلاعات لازم برای اصلاح این مورد ثبت نشده.", Severity.Error);
            return;
        }

        var (labelA, labelB) = DateDriftLabels(refData.Kind);

        var choice = await Dialog.ShowMessageBox(
            "اصلاح تاریخ",
            $"{ex.Description}\n\nکدام تاریخ درست است؟",
            yesText: $"{labelA} ({FormatDate(refData.ADate)}) درست است",
            noText: $"{labelB} ({FormatDate(refData.BDate)}) درست است",
            cancelText: "انصراف");

        if (choice is null) return;

        _busy = true;
        try
        {
            var (ok, error) = await Api.FixDateMismatchAsync(ex.ExceptionId, useA: choice == true);
            Snackbar.Add(ok ? "تاریخ اصلاح شد" : (error ?? "اصلاح ناموفق بود"),
                         ok ? Severity.Success : Severity.Error);
            if (ok) await Load();
        }
        finally { _busy = false; }
    }

