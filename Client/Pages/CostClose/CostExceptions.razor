    private async Task AcceptPermanently(CostExceptionDto ex)
    {
        var confirm = await Dialog.ShowMessageBox(
            "پذیرش دائمی",
            $"«{ex.RuleName}» برای این مورد دیگر در ماه‌های بعد هشدار نخواهد داد. مطمئن‌اید؟",
            yesText: "بله، بپذیر", cancelText: "انصراف");

        if (confirm != true) return;

        var (ok, err) = await Api.AcceptPermanentlyAsync(ex.ExceptionId, "پذیرش توسط کاربر از صفحه مغایرت‌ها");
