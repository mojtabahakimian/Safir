@page "/cost-close/exceptions"
@using Safir.Shared.Models.CostClose
@using Safir.Shared.Constants
@using Safir.Client.Services
@inject CostCloseApiService Api
@inject Pay2AccessApiService Access
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>مغایرت‌های بهای تمام‌شده</PageTitle>

<div class="cc-page" dir="rtl">

    <div class="cc-toolbar">
        <MudSelect T="byte" @bind-Value="_month" Label="ماه" Dense Variant="Variant.Outlined"
                   Style="max-width:120px">
            @for (byte m = 1; m <= 12; m++)
            {
                var mm = m;
                <MudSelectItem Value="@mm">@CostPeriod.MonthName(mm)</MudSelectItem>
            }
        </MudSelect>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PlayArrow"
                   OnClick="RunPreflight" Disabled="_busy">
            بازبینی مجدد
        </MudButton>

        <MudSpacer />

        <MudChipSet T="string" SelectedValue="@_filter" SelectedValueChanged="OnFilterChanged"
                    SelectionMode="SelectionMode.SingleSelection">
            <MudChip T="string" Value="@("blocking")" Color="Color.Error" Variant="Variant.Text">
                مسدودکننده @_blockingCount
            </MudChip>
            <MudChip T="string" Value="@("warning")" Color="Color.Warning" Variant="Variant.Text">
                هشدار @_warningCount
            </MudChip>
            <MudChip T="string" Value="@("resolved")" Variant="Variant.Text">
                رفع‌شده
            </MudChip>
        </MudChipSet>
    </div>

    @if (_busy)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate Class="my-3" />
    }

    @if (_blockingCount > 0 && _filter == "blocking")
    {
        <MudAlert Severity="Severity.Warning" Dense Class="mb-3">
            تا رفع نشدن موارد مسدودکننده، گام‌های محاسباتی اجرا نمی‌شوند.
        </MudAlert>
    }

    @if (!_busy && _rows.Count == 0)
    {
        <MudPaper Class="pa-8 text-center" Elevation="0">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
            <MudText Typo="Typo.h6" Class="mt-2">موردی یافت نشد</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                برای بررسی وضعیت این ماه، «بازبینی مجدد» را بزنید.
            </MudText>
        </MudPaper>
    }

    @foreach (var g in _rows.GroupBy(r => new { r.RuleCode, r.RuleName }))
    {
        <MudPaper Class="cc-rule-card mb-3" Elevation="0">
            <div class="cc-rule-head">
                <MudIcon Icon="@(g.First().IsBlocking
                                 ? Icons.Material.Filled.Block
                                 : Icons.Material.Filled.Warning)"
                         Color="@(g.First().IsBlocking ? Color.Error : Color.Warning)"
                         Size="Size.Small" />
                <MudText Typo="Typo.subtitle2">@g.Key.RuleName</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@g.Count() مورد</MudChip>

                <MudSpacer />

                @if (g.First().CanAutoFix && !string.IsNullOrEmpty(g.First().FixButtonText)
                     && Access.CanRun(CostForms.ActAutoFix))
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AutoFixHigh"
                               OnClick="@(() => OpenAutoFix(null))">
                        @g.First().FixButtonText (همه)
                    </MudButton>
                }
            </div>

            @if (!string.IsNullOrEmpty(g.First().RemedyText))
            {
                <div class="cc-remedy">
                    <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Size="Size.Small" />
                    <span>@g.First().RemedyText</span>
                </div>
            }

            <MudTable Items="g" Dense Hover Breakpoint="Breakpoint.Sm" Elevation="0">
                <HeaderContent>
                    <MudTh>کالا</MudTh>
                    <MudTh>شرح</MudTh>
                    <MudTh Style="text-align:left">برگه‌ها</MudTh>
                    <MudTh Style="text-align:left">مبلغ / مقدار</MudTh>
                    <MudTh Style="width:150px"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        @if (context.Code is not null)
                        {
                            <div class="cc-item">
                                <span class="cc-num">@context.Code</span>
                                <span>@context.ItemName</span>
                            </div>
                        }
                        else { <span class="mud-text-secondary">—</span> }
                    </MudTd>

                    <MudTd>
                        <MudText Typo="Typo.body2">@context.Description</MudText>
                        @if (context.DocDate is not null)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @CostPeriod.FormatDate(context.DocDate.Value)
                            </MudText>
                        }
                    </MudTd>

                    <MudTd Style="text-align:left">
                        @if (!string.IsNullOrEmpty(context.RefList))
                        {
                            <MudTooltip Text="@context.RefList">
                                <span class="cc-num cc-reflist">@Shorten(context.RefList)</span>
                            </MudTooltip>
                        }
                        else if (context.DocNumber is not null)
                        {
                            <span class="cc-num">@context.DocNumber</span>
                        }
                        else { <span class="mud-text-secondary">—</span> }
                    </MudTd>

                    <MudTd Style="text-align:left">
                        <span class="cc-num">@FormatAmount(context.Amount)</span>
                    </MudTd>

                    <MudTd Style="text-align:left">
                        @if (context.CanAutoFix && Access.CanRun(CostForms.ActAutoFix))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.AutoFixHigh"
                                           Size="Size.Small" Color="Color.Primary"
                                           Title="@context.FixButtonText"
                                           OnClick="@(() => OpenAutoFix(context.ExceptionId))" />
                        }
                        @if (!context.IsResolved && Access.CanRun(CostForms.ActResolve))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Check"
                                           Size="Size.Small" Title="رفع شد"
                                           OnClick="@(() => Resolve(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.DoNotDisturbOn"
                                           Size="Size.Small" Title="پذیرش دائمی"
                                           OnClick="@(() => AcceptPermanently(context))" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
</div>

@code {
    private byte _month = 5;
    private string _filter = "blocking";
    private bool _busy;

    private List<CostExceptionDto> _all = new();
    private List<CostExceptionDto> _rows = new();

    private int _blockingCount;
    private int _warningCount;

    private long DateFrom => CostPeriod.From(_month);
    private long DateTo   => CostPeriod.To(_month);

    protected override async Task OnInitializedAsync()
    {
        await Access.EnsureLoadedAsync();
        await Load();
    }

    private async Task Load()
    {
        _busy = true;
        try
        {
            _all = await Api.GetExceptionsAsync(includeResolved: true);
            Recount();
            ApplyFilter();
        }
        finally { _busy = false; }
    }

    private async Task RunPreflight()
    {
        _busy = true;
        StateHasChanged();
        try
        {
            await Api.RunPreflightAsync(_month, DateFrom, DateTo);
            _all = await Api.GetExceptionsAsync(includeResolved: true);
            Recount();
            ApplyFilter();
            Snackbar.Add($"بازبینی انجام شد — {_blockingCount} مسدودکننده، {_warningCount} هشدار",
                         _blockingCount > 0 ? Severity.Warning : Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private void Recount()
    {
        _blockingCount = _all.Count(x => !x.IsResolved && x.Severity == 2);
        _warningCount  = _all.Count(x => !x.IsResolved && x.Severity == 1);
    }

    private void OnFilterChanged(string v) { _filter = v; ApplyFilter(); }

    private void ApplyFilter() => _rows = _filter switch
    {
        "blocking" => _all.Where(x => !x.IsResolved && x.Severity == 2).ToList(),
        "warning"  => _all.Where(x => !x.IsResolved && x.Severity == 1).ToList(),
        _          => _all.Where(x =>  x.IsResolved).ToList()
    };

    // ───────── اصلاح خودکار ─────────

    private async Task OpenAutoFix(long? exceptionId)
    {
        // گام ۱ — پیش‌نمایش
        var preview = await Api.FixMissingFormulaAsync(new AutoFixRequest
        {
            PeriodMonth = _month, DateFrom = DateFrom, DateTo = DateTo,
            ExceptionId = exceptionId, WhatIf = true
        });

        if (preview is null || preview.RowCount == 0)
        {
            Snackbar.Add(preview?.Message ?? "موردی برای اصلاح یافت نشد", Severity.Info);
            return;
        }

        var body = $"{preview.RowCount} سطر از برگه‌های تولید اصلاح می‌شود "
                 + "و فرمول همان ماه به آنها نسبت داده خواهد شد.";

        if (preview.Warnings.Count > 0)
            body += "\n\n" + string.Join("\n", preview.Warnings);

        body += "\n\nپس از اصلاح، خروج مواد باید بازسازی شود.";

        var ok = await Dialog.ShowMessageBox(
            "تأیید اصلاح خودکار", body, yesText: "اصلاح کن", cancelText: "انصراف");

        if (ok != true) return;

        // گام ۲ — اجرای واقعی
        _busy = true;
        try
        {
            var res = await Api.FixMissingFormulaAsync(new AutoFixRequest
            {
                PeriodMonth = _month, DateFrom = DateFrom, DateTo = DateTo,
                ExceptionId = exceptionId, WhatIf = false
            });

            Snackbar.Add(res?.Message ?? "انجام شد", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task Resolve(CostExceptionDto ex)
    {
        if (await Api.ResolveAsync(ex.ExceptionId, null))
        {
            Snackbar.Add("رفع شد", Severity.Success);
            await Load();
        }
    }

    private async Task AcceptPermanently(CostExceptionDto ex)
    {
        var reason = await Dialog.ShowMessageBox(
            "پذیرش دائمی",
            $"«{ex.RuleName}» برای این مورد دیگر در ماه‌های بعد هشدار نخواهد داد. مطمئن‌اید؟",
            yesText: "بله، بپذیر", cancelText: "انصراف");

        if (reason != true) return;

        if (await Api.AcceptPermanentlyAsync(ex.ExceptionId, "پذیرش توسط کاربر از صفحه مغایرت‌ها"))
        {
            Snackbar.Add("به فهرست استثناهای پذیرفته‌شده اضافه شد", Severity.Success);
            await Load();
        }
    }

    // ───────── کمکی ─────────

    private static string Shorten(string s, int max = 28)
        => s.Length <= max ? s : s[..max] + " …";

    private static string FormatAmount(double? v)
        => v is null ? "—" : v.Value < 0
            ? $"{Math.Abs(v.Value):N0}-"
            : v.Value.ToString("N0");


}
