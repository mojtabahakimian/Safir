    private async Task OpenRebuildRates()
    {
        if (RunId is null) return;

        var ok = await Dialog.ShowMessageBox(
            "تأیید بازسازی نرخ",
            "تراز هزینه تبدیل و انتشار نرخ برای این اجرا دوباره محاسبه می‌شود. "
          + "اگر بعد از این هم نرخی منتشرنشده باقی بماند، یعنی خودِ فرمول ایراد دارد.",
            yesText: "بازسازی کن", cancelText: "انصراف");

        if (ok != true) return;

        _busy = true;
        try
        {
            var (success, remaining, error) = await Api.RebuildRatesAsync(RunId.Value);
            if (!success)
            {
                Snackbar.Add(error ?? "بازسازی ناموفق بود", Severity.Error);
            }
            else
            {
                Snackbar.Add(remaining == 0
                    ? "بازسازی انجام شد — نرخ منتشرنشده‌ای باقی نماند"
                    : $"بازسازی انجام شد — {remaining} کالا هنوز نرخ منتشرنشده دارد؛ فرمول آنها را بررسی کنید",
                    remaining == 0 ? Severity.Success : Severity.Warning);
                await Load();
            }
        }
        finally { _busy = false; }
    }

