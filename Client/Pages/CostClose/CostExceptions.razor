        {
            Snackbar.Add("به فهرست استثناهای پذیرفته‌شده اضافه شد", Severity.Success);
            await Load();
        }
        else
        {
            Snackbar.Add(err ?? "پذیرش دائمی ناموفق بود", Severity.Error);
        }
    }

    // ───────── کمکی ─────────

    private static string Shorten(string s, int max = 28)
        => s.Length <= max ? s : s[..max] + " …";

    /// <summary>
    /// یک ستون، دو جور عدد: بعضی کنترل‌ها ریال می‌گذارند (CHK-02، CHK-08)
    /// و بعضی مقدار (CHK-01 موجودیِ منفی، CHK-13 حواله‌ی صفر).
    ///
    /// ⚠️ قبلاً همه با N0 چاپ می‌شدند، یعنی صفر رقم اعشار. برای ریال درست
    /// است، ولی موجودیِ منفیِ ۰٫۰۰۲۹ واحد می‌شد «۰-» — کاربر عددی می‌دید
    /// که نه غلط بود نه درست، فقط هیچ نمی‌گفت. کدهایی مثل مایه پنیر که
    /// حواله‌هایشان هزارمِ واحد است، کلِ ستونشان «۰-» بود.
    ///
    /// پس اندازه تصمیم می‌گیرد: هزار به بالا ریال است و اعشار بی‌معنا؛
    /// پایین‌تر مقدار است و اعشار همه‌ی حرف. زیر یک‌میلیونیم هم دیگر عدد
    /// نیست، باقیمانده‌ی اعشاریِ محاسبه است — با نماد علمی نشان داده
    /// می‌شود تا با صفر اشتباه نشود.
    /// </summary>
    private static string FormatAmount(double? v)
    {
        if (v is null) return "—";

        var x = v.Value;
        if (x == 0) return "0";

        var abs = Math.Abs(x);
        var body = abs >= 1000      ? abs.ToString("N0")
                 : abs >= 0.000001  ? abs.ToString("0.######")
                 : abs.ToString("0.0e+0");

        return x < 0 ? body + "-" : body;
    }

    private static string FormatDate(long d)
        => $"{d / 10000}/{d / 100 % 100:00}/{d % 100:00}";

    private static string PersianMonth(byte m) => m switch
    {
        1 => "فروردین", 2 => "اردیبهشت", 3 => "خرداد",
        4 => "تیر",     5 => "مرداد",    6 => "شهریور",
        7 => "مهر",     8 => "آبان",     9 => "آذر",
        10 => "دی",     11 => "بهمن",    12 => "اسفند",
        _ => m.ToString()
    };
}
