    // ───────── انتخاب دسته‌جمعی و رفع با سند اصلاحی ─────────

    private readonly HashSet<long> _selected = new();

    private bool AllSelected(IEnumerable<CostExceptionDto> group)
    {
        var list = group as IList<CostExceptionDto> ?? group.ToList();
        return list.Count > 0 && list.All(x => _selected.Contains(x.ExceptionId));
    }

    private void ToggleSelectAll(IEnumerable<CostExceptionDto> group, bool value)
    {
        foreach (var x in group)
        {
            if (value) _selected.Add(x.ExceptionId);
            else _selected.Remove(x.ExceptionId);
        }
    }

    private void ToggleOne(long exceptionId, bool value)
    {
        if (value) _selected.Add(exceptionId);
        else _selected.Remove(exceptionId);
    }

    private async Task BulkResolve(IEnumerable<CostExceptionDto> group)
    {
        var ids = group.Where(x => _selected.Contains(x.ExceptionId)).Select(x => x.ExceptionId).ToList();
        if (ids.Count == 0) return;

        var confirm = await Dialog.ShowMessageBox(
            "نادیده گرفتن دسته‌جمعی",
            $"{ids.Count} مورد بدون صدور سند رفع می‌شود. مطمئن‌اید؟",
            yesText: "بله، رفع کن", cancelText: "انصراف");

        if (confirm != true) return;

        var (ok, count, err) = await Api.BulkResolveAsync(ids, "نادیده‌گرفتن دسته‌جمعی از صفحه مغایرت‌ها");
        if (ok)
        {
            foreach (var id in ids) _selected.Remove(id);
            Snackbar.Add($"{count} مورد رفع شد", Severity.Success);
            await Load();
        }
        else
        {
            Snackbar.Add(err ?? "رفع دسته‌جمعی ناموفق بود", Severity.Error);
        }
    }

    private async Task BulkAcceptPermanently(IEnumerable<CostExceptionDto> group)
    {
        var ids = group.Where(x => _selected.Contains(x.ExceptionId)).Select(x => x.ExceptionId).ToList();
        if (ids.Count == 0) return;

        var confirm = await Dialog.ShowMessageBox(
            "پذیرش دائمی دسته‌جمعی",
            $"{ids.Count} مورد دیگر نه در همین اجرا، نه در ماه‌های بعد هشدار نخواهد داد. مطمئن‌اید؟",
            yesText: "بله، بپذیر", cancelText: "انصراف");

        if (confirm != true) return;

        var (ok, count, err) = await Api.AcceptPermanentlyBulkAsync(
            ids, "پذیرش دائمی دسته‌جمعی از صفحه مغایرت‌ها");
        if (ok)
        {
            foreach (var id in ids) _selected.Remove(id);
            Snackbar.Add($"{count} مورد به فهرست استثناهای پذیرفته‌شده اضافه شد", Severity.Success);
            await Load();
        }
        else
        {
            Snackbar.Add(err ?? "پذیرش دائمی دسته‌جمعی ناموفق بود", Severity.Error);
        }
    }

    private async Task OpenPostCorrection(IEnumerable<CostExceptionDto> group)
    {
        var ids = group.Where(x => _selected.Contains(x.ExceptionId)).Select(x => x.ExceptionId).ToList();
        if (ids.Count == 0) return;

        var p = new DialogParameters { ["ExceptionIds"] = ids, ["DateS"] = DateTo };
        var dlg = await Dialog.ShowAsync<PostCorrectionDialog>("سند اصلاحی مغایرت", p);
        var result = await dlg.Result;

        if (result is { Canceled: false })
        {
            foreach (var id in ids) _selected.Remove(id);
            await Load();
        }
    }

    private async Task Resolve(CostExceptionDto ex)
    {
        var (ok, err) = await Api.ResolveAsync(ex.ExceptionId, null);
        if (ok)
        {
            Snackbar.Add("رفع شد", Severity.Success);
            await Load();
        }
        else
        {
            // بدون این else، شکست درخواست کاملاً بی‌صدا بود: نه پیام خطا، نه
            // تغییری در ردیف — کاربر نمی‌فهمید عملیات واقعاً انجام شد یا نه.
            Snackbar.Add(err ?? "رفع مورد ناموفق بود", Severity.Error);
        }
    }

