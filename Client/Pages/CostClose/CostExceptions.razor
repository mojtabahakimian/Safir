@page "/cost-close/exceptions"
@using Safir.Shared.Models.CostClose
@using Safir.Shared.Constants
@using Safir.Shared.Utility
@using Safir.Client.Services
@inject CostCloseApiService Api
@inject Pay2AccessApiService Access
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>مغایرت‌های بهای تمام‌شده</PageTitle>

<div class="cc-page" dir="rtl">

    <div class="cc-toolbar">
        <CostBackButton />

        @if (RunId is null)
        {
            <MudSelect T="short" @bind-Value="_year" Label="سال" Dense Variant="Variant.Outlined"
                       Style="max-width:110px">
                @foreach (var y in YearChoices)
                {
                    var yy = y;
                    <MudSelectItem Value="@yy">@yy</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="byte" @bind-Value="_month" Label="ماه" Dense Variant="Variant.Outlined"
                       Style="max-width:120px">
                @for (byte m = 1; m <= 12; m++)
                {
                    var mm = m;
                    <MudSelectItem Value="@mm">@PersianMonth(mm)</MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            @* وقتی از داخل یک اجرای مشخص باز شده‌ایم، ماه/سال باید همان دورهٔ
               واقعی آن اجرا باشد و غیرقابل‌تغییر — وگرنه «بازبینی مجدد» با
               بازهٔ تاریخ یک ماه نامرتبط صدا زده می‌شود و می‌تواند استثناهای
               واقعیِ همین اجرا را با نتیجهٔ بازبینیِ ماه اشتباه جایگزین کند. *@
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                     Icon="@Icons.Material.Filled.Lock">
                دورهٔ این اجرا: @PersianMonth(_month) @_year
            </MudChip>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PlayArrow"
                   OnClick="RunPreflight" Disabled="_busy">
            بازبینی مجدد
        </MudButton>

        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.VisibilityOff"
                   OnClick="OpenAcceptedExceptions">
            استثناهای پذیرفته‌شده
        </MudButton>

        <MudSelect T="int?" Value="_anbarFilter" ValueChanged="OnAnbarFilterChanged"
                   Label="انبار" Dense Variant="Variant.Outlined" Clearable Style="min-width:170px">
            @foreach (var a in AnbarChoices)
            {
                @* T="int?" باید صریح باشد؛ اگر از روی a.Anbar (که int است، نه
                   int?) استنتاج شود، نوع آیتم با نوع MudSelect جور در نمی‌آید
                   و آیتم‌ها بی‌صدا توی لیست ظاهر نمی‌شوند. *@
                <MudSelectItem T="int?" Value="@((int?)a.Anbar)">@a.Anbar — @(a.AnbarName ?? "؟")</MudSelectItem>
            }
        </MudSelect>

        <MudSpacer />

        @* MudBlazor 6.21: MudChipSet در این نسخه SelectedValue/SelectionMode ندارد،
           پس فیلتر با سه چیپ مستقل و OnClick پیاده شده است. *@
        <MudChip Color="Color.Error" Size="Size.Small"
                 Variant="@FilterVariant("blocking")"
                 OnClick="@(() => SetFilter("blocking"))">
            مسدودکننده @_blockingCount
        </MudChip>
        <MudChip Color="Color.Warning" Size="Size.Small"
                 Variant="@FilterVariant("warning")"
                 OnClick="@(() => SetFilter("warning"))">
            هشدار @_warningCount
        </MudChip>
        <MudChip Color="Color.Default" Size="Size.Small"
                 Variant="@FilterVariant("resolved")"
                 OnClick="@(() => SetFilter("resolved"))">
            رفع‌شده
        </MudChip>

        <ExcelExportButton T="CostExceptionDto" Items="_rows" Columns="_exceptionCols" FileName="مغایرت‌ها" />
    </div>

    @if (_busy)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate Class="my-3" />
    }

    @if (_blockingCount > 0 && _filter == "blocking")
    {
        <MudAlert Severity="Severity.Warning" Dense Class="mb-3">
            تا رفع نشدن موارد مسدودکننده، گام‌های محاسباتی اجرا نمی‌شوند.
        </MudAlert>
    }

    @if (!_busy && _rows.Count == 0)
    {
        <MudPaper Class="pa-8 text-center" Elevation="0">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
            <MudText Typo="Typo.h6" Class="mt-2">موردی یافت نشد</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                برای بررسی وضعیت این ماه، «بازبینی مجدد» را بزنید.
            </MudText>
        </MudPaper>
    }

    @foreach (var g in _rows.GroupBy(r => new { r.RuleCode, r.RuleName }))
    {
        <MudPaper Class="cc-rule-card mb-3" Elevation="0">
            <div class="cc-rule-head">
                <MudIcon Icon="@(g.First().IsBlocking
                                 ? Icons.Material.Filled.Block
                                 : Icons.Material.Filled.Warning)"
                         Color="@(g.First().IsBlocking ? Color.Error : Color.Warning)"
                         Size="Size.Small" />
                <MudText Typo="Typo.subtitle2">@g.Key.RuleName</MudText>
                <MudChip Size="Size.Small" Variant="Variant.Text">@g.Count() مورد</MudChip>

                <MudSpacer />

                @if (g.First().CanAutoFix && !string.IsNullOrEmpty(g.First().FixButtonText)
                     && Access.CanRun(CostForms.ActAutoFix))
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.AutoFixHigh"
                               OnClick="@(() => OpenAutoFix(null))">
                        @g.First().FixButtonText (همه)
                    </MudButton>
                }

                @if (g.Key.RuleCode == "CHK-09" && Access.CanRun(CostForms.ActRollup))
                {
                    @if (RunId is not null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Sync"
                                   OnClick="OpenRebuildRates">
                            بازسازی نرخ
                        </MudButton>
                    }
                    else
                    {
                        <MudTooltip Text="برای بازسازی نرخ باید از داخل یک اجرای مشخص وارد شوید.">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                فقط از صفحه اجرا قابل رفع است
                            </MudChip>
                        </MudTooltip>
                    }
                }

                @if (g.Key.RuleCode == "CHK-08" && Access.CanRun(CostForms.ActRebuildDocs))
                {
                    @if (RunId is not null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.ReceiptLong"
                                   OnClick="OpenRebuildMaterialIssueDocs">
                            بازسازی سند حواله خروج مواد
                        </MudButton>
                    }
                    else
                    {
                        <MudTooltip Text="برای بازسازی سند باید از داخل یک اجرای مشخص وارد شوید.">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                فقط از صفحه اجرا قابل رفع است
                            </MudChip>
                        </MudTooltip>
                    }
                }
            </div>

            @if (!string.IsNullOrEmpty(g.First().RemedyText))
            {
                <div class="cc-remedy">
                    <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Size="Size.Small" />
                    <span>@g.First().RemedyText</span>
                </div>
            }

            @{ var groupSelectedCount = g.Count(x => _selected.Contains(x.ExceptionId)); }
            @if (groupSelectedCount > 0)
            {
                <div class="cc-bulk-toolbar">
                    <MudText Typo="Typo.body2">@groupSelectedCount انتخاب‌شده</MudText>

                    @if (Access.CanRun(CostForms.ActResolve))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.DoDisturb"
                                   OnClick="@(() => BulkResolve(g))">
                            نادیده گرفتن
                        </MudButton>
                    }

                    @* «نادیده گرفتن» فقط همین اجرا را رفع می‌کند (IsResolved، مقید به
                       RunId)؛ ماه بعد که یک اجرای تازه ساخته می‌شود دوباره برمی‌گردد —
                       دقیقاً همان چیزی که برای مغایرت‌های افتتاحیه در فروردین اتفاق
                       افتاد. برای «دیگر هیچ‌وقت نشان نده» باید این دکمه (پذیرش دائمی،
                       CC_AcceptedException بدون قید RunId) زده شود، نه آن یکی.
                       ⚠️ فرمِ جداگانه (ActResolvePermanent)، نه Upd روی ActResolve —
                       نگاه کنید توضیح CostForms.cs. *@
                    @if (Access.CanRun(CostForms.ActResolvePermanent))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.DoNotDisturbOn"
                                   OnClick="@(() => BulkAcceptPermanently(g))">
                            پذیرش دائمی (این ماه و بعدها)
                        </MudButton>
                    }

                    @if (g.Key.RuleCode == "CHK-02" && Access.CanRun(CostForms.ActPostCorrection))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.ReceiptLong"
                                   OnClick="@(() => OpenPostCorrection(g))">
                            زدن سند اصلاحی
                        </MudButton>
                    }
                </div>
            }

            @if (g.Key.RuleCode == "CHK-02")
            {
                @* مغایرت‌های افتتاحیه (کارت انبار صفر، فقط یک سند بدهکار بدون
                   گردش — یعنی موجودی اول دوره در STUF_FSK seed نشده) اکثریت
                   CHK-02 را تشکیل می‌دهند و معمولاً همه‌شان یک‌جا با یک حساب
                   مقصد بسته می‌شوند — به همین خاطر جدا و با «انتخاب همه»ی
                   مستقل نشان داده می‌شوند، نه قاطی بقیه‌ی مغایرت‌ها. *@
                var opening = g.Where(x => x.IsOpeningOnly).ToList();
                var other   = g.Where(x => !x.IsOpeningOnly).ToList();

                if (opening.Count > 0)
                {
                    @* تفکیک دو جهت: هرکدام سند اصلاحیِ متفاوتی می‌خواهند، پس
                       یک‌کاسه نشان دادنشان کمکی نمی‌کند. OpeningKind خالی
                       یعنی سطرِ قدیمی، پیش از افزوده‌شدنِ آن ستون. *@
                    var missing = opening.Count(x => x.OpeningKind == 1);
                    var extra   = opening.Count(x => x.OpeningKind == 2);

                    <MudText Typo="Typo.caption" Class="cc-subgroup-label">
                        مغایرت افتتاحیه — از گردش این ماه نیست (@opening.Count مورد)
                        @if (missing > 0)
                        {
                            <span> · @missing مورد: کاردکس موجودی اول دوره دارد، سند افتتاحیه ندارد</span>
                        }
                        @if (extra > 0)
                        {
                            <span> · @extra مورد: سند افتتاحیه هست، کاردکس موجودی اول دوره ندارد</span>
                        }
                    </MudText>
                    @ExceptionTable(opening)
                }
                if (other.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="cc-subgroup-label">
                        سایر مغایرت‌ها (@other.Count مورد)
                    </MudText>
                    @ExceptionTable(other)
                }
            }
            else
            {
                @ExceptionTable(g.ToList())
            }
        </MudPaper>
    }

    @{
        RenderFragment ExceptionTable(List<CostExceptionDto> rows) => @<MudTable T="CostExceptionDto" Items="rows" Dense Hover Breakpoint="Breakpoint.Sm" Elevation="0">
            <HeaderContent>
                <MudTh Style="width:40px">
                    <MudCheckBox T="bool" Dense Value="@AllSelected(rows)"
                                 ValueChanged="@(v => ToggleSelectAll(rows, v))" />
                </MudTh>
                <MudTh>کالا</MudTh>
                <MudTh>شرح</MudTh>
                <MudTh Style="text-align:left">برگه‌ها</MudTh>
                <MudTh Style="text-align:left">مبلغ / مقدار</MudTh>
                <MudTh Style="width:150px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudCheckBox T="bool" Dense Value="@_selected.Contains(context.ExceptionId)"
                                 ValueChanged="@(v => ToggleOne(context.ExceptionId, v))" />
                </MudTd>
                <MudTd>
                    @if (context.Code is not null)
                    {
                        <div class="cc-item">
                            <span class="cc-num">@context.Code</span>
                            <span>@context.ItemName</span>
                        </div>
                    }
                    else { <span class="mud-text-secondary">—</span> }
                </MudTd>

                <MudTd>
                    <MudText Typo="Typo.body2">@context.Description</MudText>
                    @if (context.DocDate is not null)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @FormatDate(context.DocDate.Value)
                        </MudText>
                    }
                </MudTd>

                <MudTd Style="text-align:left">
                    @* RefList دو کاربردِ متفاوت دارد: برای CHK-04 فهرستِ خوانای
                       شماره‌برگه‌هاست، ولی برای CHK-18/CHK-19/CHK-21 یک JSONِ
                       داخلی است که فقط دیالوگِ «اصلاح تاریخ» می‌خواند (نگاه کنید
                       OpenDateMismatchFix/DateDriftRef) — نباید خامش اینجا نشان
                       داده شود. *@
                    @if (context.RuleCode is "CHK-18" or "CHK-19" or "CHK-21")
                    {
                        @if (context.DocNumber is not null)
                        {
                            <span class="cc-num">@context.DocNumber</span>
                        }
                        else { <span class="mud-text-secondary">—</span> }
                    }
                    else if (!string.IsNullOrEmpty(context.RefList))
                    {
                        <MudTooltip Text="@context.RefList">
                            <span class="cc-num cc-reflist">@Shorten(context.RefList)</span>
                        </MudTooltip>
                    }
                    else if (context.DocNumber is not null)
                    {
                        <span class="cc-num">@context.DocNumber</span>
                    }
                    else { <span class="mud-text-secondary">—</span> }
                </MudTd>

                <MudTd Style="text-align:left">
                    <span class="cc-num">@FormatAmount(context.Amount)</span>
                </MudTd>

                <MudTd Style="text-align:left">
                    @if (context.CanAutoFix && Access.CanRun(CostForms.ActAutoFix))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.AutoFixHigh"
                                       Size="Size.Small" Color="Color.Primary"
                                       Title="@context.FixButtonText"
                                       OnClick="@(() => OpenAutoFix(context.ExceptionId))" />
                    }
                    @* CHK-04 وقتی اصلاح خودکار ممکن نیست: کالا برای این ماه
                       هیچ فرمولی ندارد، پس چیزی نیست که نسبت داده شود. راهِ
                       باقی‌مانده کپیِ فرمول از ماهِ دیگر است — پیش‌فرض ماهِ
                       قبل، با انتخاب کاربر. *@
                    @if (context.RuleCode == "CHK-04" && !context.CanAutoFix
                         && !context.IsResolved && context.Code is not null
                         && Access.CanRun(CostForms.ActAutoFix))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                       Size="Size.Small" Color="Color.Primary"
                                       Title="کپی فرمول از ماه دیگر"
                                       OnClick="@(() => OpenFormulaCopy(context))" />
                    }
                    @if (context.RuleCode == "CHK-15" && !context.IsResolved
                         && Access.CanRun(CostForms.ActAutoFix))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Build"
                                       Size="Size.Small" Color="Color.Primary"
                                       Title="اصلاح سطر فرمول منفی"
                                       OnClick="@(() => OpenNegativeFormulaFix(context))" />
                    }
                    @if (context.RuleCode is "CHK-18" or "CHK-21" && !context.IsResolved
                         && Access.CanRun(CostForms.ActFixDateMismatch))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.EditCalendar"
                                       Size="Size.Small" Color="Color.Primary"
                                       Title="اصلاح تاریخ"
                                       OnClick="@(() => OpenDateMismatchFix(context))" />
                    }
                    @* CHK-19: بر خلاف CHK-18، اینجا مستقیم تاریخ سند حسابداری را
                       UPDATE نمی‌کنیم — یک سند (حالت «سند روزانه») می‌تواند
                       مشترکِ ده‌ها فاکتورِ دیگر باشد (نمونه‌ی واقعی: سند ۶۴۱۴،
                       ۴۲ فاکتور)، پس عوض‌کردن تاریخِ خودِ سند همه‌ی فاکتورهای
                       دیگرش را هم غلط می‌کرد. راه‌حل درست (طبق GENSANADFROOSH
                       اصلی) این است که فقط بازسازیِ سند فروش را برای همین یک
                       فاکتور دوباره اجرا کنیم؛ SaleRebuildService از قبل با
                       تاریخِ فعلیِ فاکتور یا سندِ همان‌روز را پیدا می‌کند یا
                       تازه می‌سازد، بدون دست‌زدن به فاکتورهای دیگرِ سند قدیم. *@
                    @if (context.RuleCode == "CHK-19" && !context.IsResolved
                         && Access.CanRun(CostForms.ActRebuildDocs))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.ReceiptLong"
                                       Size="Size.Small" Color="Color.Primary"
                                       Title="بازسازی سند فروش همین فاکتور"
                                       OnClick="@(() => RebuildSaleDocForOne(context))" />
                    }
                    @if (!context.IsResolved && Access.CanRun(CostForms.ActResolve))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Check"
                                       Size="Size.Small" Title="رفع شد"
                                       OnClick="@(() => Resolve(context))" />
                    }
                    @* پذیرش دائمی یک فرمِ دسترسیِ جداگانه دارد (ActResolvePermanent)،
                       نه Upd روی همان فرمِ «رفع شد» — چون «بستن استثنا» در صفحه‌ی
                       «عملیات حساس» فقط یک تیکِ Run دارد و هرگز به ستونِ Upد دسترسی
                       نمی‌دهد؛ کاربری که همه‌چیز را در آن صفحه تیک بزند هم بدونِ این
                       فرمِ جدا هرگز این دکمه را نمی‌دید. *@
                    @if (!context.IsResolved && Access.CanRun(CostForms.ActResolvePermanent))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.DoNotDisturbOn"
                                       Size="Size.Small" Title="پذیرش دائمی"
                                       OnClick="@(() => AcceptPermanently(context))" />
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>;
    }
</div>

@code {
    private static readonly IReadOnlyList<ExcelCol<CostExceptionDto>> _exceptionCols = new[]
    {
        new ExcelCol<CostExceptionDto> { Title = "قاعده",  Text = r => r.RuleName ?? r.RuleCode ?? "" },
        new ExcelCol<CostExceptionDto> { Title = "انبار",  Text = r => r.AnbarName ?? (r.Anbar?.ToString() ?? "") },
        new ExcelCol<CostExceptionDto> { Title = "کالا",   Text = r => r.ItemName ?? (r.Code?.ToString() ?? "") },
        new ExcelCol<CostExceptionDto> { Title = "شرح",    Text = r => r.Description },
        new ExcelCol<CostExceptionDto> { Title = "سند",    Text = r => r.DocNumber?.ToString() ?? "" },
        new ExcelCol<CostExceptionDto> { Title = "تاریخ سند", Text = r => r.DocDate is long d ? FormatDate(d) : "" },
        new ExcelCol<CostExceptionDto> { Title = "مبلغ/مقدار", IsNumber = true, Money = true, Sum = true, Number = r => r.Amount },
        new ExcelCol<CostExceptionDto> { Title = "وضعیت",  Text = r => r.IsResolved ? "رفع‌شده" : (r.Severity == 2 ? "مسدودکننده" : "هشدار") },
    };

    // اگر از صفحهٔ پایش یک اجرا آمده باشیم، RunId ست می‌شود — فقط آن‌وقت
    // دکمهٔ «بازسازی نرخ» (CHK-09) معنا دارد، چون S10/S11 نتیجه را به یک
    // اجرای مشخص وصل می‌کنند، نه به بازبینی سراسری بدون اجرا.
    [SupplyParameterFromQuery(Name = "runId")]
    public int? RunId { get; set; }

    // سال و ماه از تاریخ جاری سیستم گرفته می‌شوند، نه عدد ثابت.
    // نسخهٔ اول این صفحه سال ۱۴۰۵ را hard-code کرده بود؛ سال بعد بی‌صدا
    // بازهٔ اشتباه را کوئری می‌کرد.
    private short _year  = (short)(CL_Tarikh.GetCurrentPersianDateAsLong() / 10000);
    private byte  _month = (byte)(CL_Tarikh.GetCurrentPersianDateAsLong() / 100 % 100);

    /// <summary>سال جاری و دو سال قبل — بستن ماه گذشته‌نگر است، نه آینده‌نگر.</summary>
    private IEnumerable<short> YearChoices
    {
        get
        {
            var now = (short)(CL_Tarikh.GetCurrentPersianDateAsLong() / 10000);
            for (short y = now; y >= (short)(now - 2); y--) yield return y;
        }
    }

    private string _filter = "blocking";
    private bool _busy;

    private List<CostExceptionDto> _all = new();
    private List<CostExceptionDto> _rows = new();

    private int _blockingCount;
    private int _warningCount;

    private long DateFrom => (long)_year * 10000 + _month * 100 + 1;

    // پایان ماه از تقویم شمسی گرفته می‌شود (۲۹/۳۰/۳۱ بسته به ماه و سال کبیسه)،
    // نه عدد ثابت ۳۱.
    private long DateTo   => CL_Tarikh.GetPersianMonthEndAsLong(DateFrom);

    protected override async Task OnInitializedAsync()
    {
        await Access.EnsureLoadedAsync();

        if (RunId is not null)
        {
            // بدون این، _year/_month روی ماه جاری سیستم می‌ماندند (پیش‌فرض
            // پایین‌تر) در حالی که داریم مغایرت‌های یک اجرای واقعاً مربوط به
            // ماه دیگری را می‌بینیم — و «بازبینی مجدد» همان مقدار غلط را به
            // preflight می‌داد.
            var state = await Api.GetRunStateAsync(RunId.Value);
            if (state?.Run is not null)
            {
                _year  = state.Run.FiscalYear;
                _month = state.Run.PeriodMonth;
            }
        }

        await Load();
    }

    private async Task Load()
    {
        _busy = true;
        try
        {
            _all = await Api.GetExceptionsAsync(runId: RunId, includeResolved: true);
            Recount();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            // بدون این catch، یک ۴۰۱/۴۰۳ ساده از OnInitializedAsync بیرون می‌زد و
            // کامپوننت با پیام انگلیسیِ .NET می‌شکست («Response status code does not
            // indicate success»). کاربر باید پیام فارسی ببیند و صفحه سرِپا بماند.
            _all = new();
            Recount();
            ApplyFilter();
            Snackbar.Add(FriendlyError(ex), Severity.Error);
        }
        finally { _busy = false; }
    }

    /// <summary>
    /// پیام سرور اگر فارسی و روشن باشد نمایش داده می‌شود؛ وگرنه پیام عمومی فارسی.
    /// مسیرهای api/cost-close/ زیر پوشش Pay2ForbiddenHandler نیستند، پس متن ۴۰۳
    /// سرور اینجا به دست ما نمی‌رسد و باید جایگزین قابل‌فهم داشته باشیم.
    /// </summary>
    private static string FriendlyError(Exception ex)
    {
        if (ex is HttpRequestException http)
        {
            if (http.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                return "برای مشاهده این صفحه باید وارد شوید.";
            if (http.StatusCode == System.Net.HttpStatusCode.Forbidden)
                return "دسترسی لازم برای مشاهده مغایرت‌های بهای تمام‌شده را ندارید.";
        }

        return "خواندن فهرست مغایرت‌ها ناموفق بود. اگر تکرار شد به پشتیبانی اطلاع دهید.";
    }

    private async Task RunPreflight()
    {
        _busy = true;
        StateHasChanged();
        try
        {
            await Api.RunPreflightAsync(_month, DateFrom, DateTo, RunId);
            _all = await Api.GetExceptionsAsync(runId: RunId, includeResolved: true);
            Recount();
            ApplyFilter();
            Snackbar.Add($"بازبینی انجام شد — {_blockingCount} مسدودکننده، {_warningCount} هشدار",
                         _blockingCount > 0 ? Severity.Warning : Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(FriendlyError(ex), Severity.Error); }
        finally { _busy = false; }
    }

    private void Recount()
    {
        _blockingCount = _all.Count(x => !x.IsResolved && x.Severity == 2);
        _warningCount  = _all.Count(x => !x.IsResolved && x.Severity == 1);
    }

    private void SetFilter(string v) { _filter = v; ApplyFilter(); }

    private Variant FilterVariant(string v) => _filter == v ? Variant.Filled : Variant.Text;

    // فیلتر انبار — مستقل از فیلتر شدت/رفع‌شده، هر دو با هم اعمال می‌شوند.
    private int? _anbarFilter;

    private IEnumerable<(int Anbar, string? AnbarName)> AnbarChoices
        => _all.Where(x => x.Anbar is not null)
               .Select(x => (Anbar: x.Anbar!.Value, x.AnbarName))
               .Distinct()
               .OrderBy(x => x.Anbar);

    private void OnAnbarFilterChanged(int? v) { _anbarFilter = v; ApplyFilter(); }

    private void ApplyFilter()
    {
        IEnumerable<CostExceptionDto> rows = _filter switch
        {
            "blocking" => _all.Where(x => !x.IsResolved && x.Severity == 2),
            "warning"  => _all.Where(x => !x.IsResolved && x.Severity == 1),
            _          => _all.Where(x =>  x.IsResolved)
        };

        if (_anbarFilter is not null)
            rows = rows.Where(x => x.Anbar == _anbarFilter);

        _rows = rows.ToList();
    }

    // ───────── اصلاح خودکار ─────────

    private async Task OpenAutoFix(long? exceptionId)
    {
        // گام ۱ — پیش‌نمایش
        //
        // ⚠️ RunId باید فرستاده شود: رویه با شرطِ
        //     ISNULL(e.RunId,-1) = ISNULL(@RunId,-1)
        // استثناها را انتخاب می‌کند، پس با RunIdِ تهی فقط استثناهایی پیدا
        // می‌شوند که خودشان RunId ندارند. وقتی کاربر از داخل یک اجرا وارد
        // شده (?runId=…)، استثنا RunId دارد و بدون این، هیچ سطری پیدا
        // نمی‌شد و دکمه بی‌صدا «موردی برای اصلاح یافت نشد» می‌گفت.
        // نمونه‌ی واقعی: تیر ۱۴۰۵، کد ۳۵۵۹، استثنا ۱۸۶۳۰ در اجرای ۹ —
        // درحالی‌که خودِ رویه با پارامتر درست، برگه ۲۲۹ را بی‌مشکل اصلاح
        // می‌کرد.
        var preview = await Api.FixMissingFormulaAsync(new AutoFixRequest
        {
            PeriodMonth = _month, DateFrom = DateFrom, DateTo = DateTo,
            RunId = RunId, ExceptionId = exceptionId, WhatIf = true
        });

        if (preview is null || preview.RowCount == 0)
        {
            Snackbar.Add(preview?.Message ?? "موردی برای اصلاح یافت نشد", Severity.Info);
            return;
        }

        var body = $"{preview.RowCount} سطر از برگه‌های تولید اصلاح می‌شود "
                 + "و فرمول همان ماه به آنها نسبت داده خواهد شد.";

        if (preview.Warnings.Count > 0)
            body += "\n\n" + string.Join("\n", preview.Warnings);

        body += "\n\nپس از اصلاح، خروج مواد باید بازسازی شود.";

        var ok = await Dialog.ShowMessageBox(
            "تأیید اصلاح خودکار", body, yesText: "اصلاح کن", cancelText: "انصراف");

        if (ok != true) return;

        // گام ۲ — اجرای واقعی
        _busy = true;
        try
        {
            var res = await Api.FixMissingFormulaAsync(new AutoFixRequest
            {
                PeriodMonth = _month, DateFrom = DateFrom, DateTo = DateTo,
                RunId = RunId, ExceptionId = exceptionId, WhatIf = false
            });

            Snackbar.Add(res?.Message ?? "انجام شد", Severity.Success);
            await Load();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

