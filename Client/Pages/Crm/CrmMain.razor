    private async Task AddNewCompany()
    {
        var parameters = new DialogParameters
        {
            ["Company"] = new CrmCompanyDto(),
            ["StatusList"] = _statusList
        };

        var dialog = await DialogService.ShowAsync<CrmCompanyModal>("افزودن شرکت / مشتری جدید", parameters);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is CrmCompanyDto newComp)
        {
            await RefreshData();
            var match = _companies.FirstOrDefault(c => c.ID == newComp.ID);
            if (match != null) SelectCompany(match);
        }
    }

    private async Task EditCompany(CrmCompanyDto company)
    {
        var parameters = new DialogParameters
        {
            ["Company"] = company,
            ["StatusList"] = _statusList
        };

        var dialog = await DialogService.ShowAsync<CrmCompanyModal>("ویرایش اطلاعات مشتری", parameters);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await RefreshData();
        }
    }

    private async Task DeleteCompany(CrmCompanyDto company)
    {
        if (company.ID == null) return;
        bool? confirm = await DialogService.ShowMessageBox(
            "حذف مشتری",
            $"آیا از حذف شرکت «{company.COMPANY_NAME}» و کلیه سوابق پیگیری آن اطمینان دارید؟",
            yesText: "بله، حذف شود", cancelText: "انصراف");

        if (confirm == true)
        {
            var ok = await CrmApi.DeleteCompanyAsync(company.ID.Value);
            if (ok)
            {
                Snackbar.Add("مشتری با موفقیت حذف شد.", Severity.Success);
                await RefreshData();
            }
        }
    }

    private async Task DeleteEvent(CrmEventDto ev)
    {
        if (ev.IDDE == null) return;
        bool? confirm = await DialogService.ShowMessageBox(
            "حذف پیگیری",
            "آیا از حذف این پیگیری اطمینان دارید؟",
            yesText: "بله، حذف شود", cancelText: "انصراف");

        if (confirm == true)
        {
            var ok = await CrmApi.DeleteEventAsync(ev.IDDE.Value);
            if (ok)
            {
                Snackbar.Add("پیگیری حذف شد.", Severity.Success);
                if (_selectedCompany?.ID != null)
                {
                    _events = await CrmApi.GetEventsByCompanyIdAsync(_selectedCompany.ID.Value);
                }
                await LoadCompanies();
                await LoadDashboardSummary();
            }
        }
    }

