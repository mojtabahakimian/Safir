@code {
    private int _activeTabIndex = 0;
    private int _todayInt;

    private List<CrmCompanyDto> _companies = new();
    private List<CrmCompanyDto> _filteredCompanies = new();
    private List<CrmEventDto> _events = new();
    private List<CrmStatusDto> _statusList = new();
    private CrmDashboardSummaryDto _summary = new();

    private CrmCompanyDto? _selectedCompany;
    private CrmFilterDto _filter = new() { OnlyMyCompanies = true };

    // وضعیت دسترسی کاربر. وقتی محدودیت فعال باشد و کاربر مجوز «مشاهده همه»
    // نداشته باشد، چک‌باکس «مشتریان من» پنهان می‌شود چون دیگر کاری نمی‌کند —
    // فیلتر مالکیت سمت سرور اجباری است.
    private CrmAccessDto _access = new();
    private int? _selectedStatus;

    // متغیرهای باکس ثبت سریع پیگیری
    private string _quickComment = string.Empty;
    private int? _quickStatus;
    private string _quickNextDate = string.Empty;
    private string _quickNextTime = string.Empty;
    private bool _quickIsMeeting;
    private bool _savingQuickEvent;

    // متغیرهای دفترچه تلفن
    private string _phoneSearchQuery = string.Empty;
    private List<CrmPhoneBookItemDto> _phoneItems = new();
    private bool _loadingPhonebook;

    // متغیرهای یادداشت‌ها (Notes)
    private List<CrmNoteDto> _notes = new();
    private string _newNoteText = string.Empty;
    private bool _onlyPendingNotes = true;
    private bool _loadingNotes;
    private bool _savingNote;

    private bool _loadingCompanies = true;
    private bool _loadingEvents;

    protected override async Task OnInitializedAsync()
    {
        _todayInt = int.TryParse(CL_Tarikh.Current_FullDate, out var td) ? td : 0;

        _access = await CrmApi.GetAccessAsync();
        if (_access.RestrictToOwn)
        {
            // در این حالت سرور همیشه فقط داده‌ی خود کاربر را برمی‌گرداند،
            // پس مقدار این فیلتر بی‌اثر است. true نگه داشته می‌شود تا اگر
            // محدودیت بعداً خاموش شد، رفتار پیش‌فرض عوض نشود.
            _filter.OnlyMyCompanies = true;
        }

        await RefreshData();
    }

    private void SwitchToTab(int index)
    {
        _activeTabIndex = index;
    }

    private async Task RefreshData()
    {
        // اجرای همزمان و موازی واکشی‌های ضروری صفحه اول برای حداکثر سرعت
        await Task.WhenAll(
            LoadStatusList(),
            LoadCompanies(),
            LoadDashboardSummary()
        );

        // واکشی‌های تکمیلی برای سایر تب‌ها در پس‌زمینه
        _ = SearchPhoneBook();
        _ = LoadNotes();
    }

    private async Task LoadStatusList()
    {
        try
        {
            _statusList = await CrmApi.GetStatusListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در بارگذاری وضعیت‌ها: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadDashboardSummary()
    {
        try
        {
            _summary = await CrmApi.GetDashboardSummaryAsync();
        }
        catch { }
    }

    private async Task LoadCompanies()
    {
        _loadingCompanies = true;
        try
        {
            _companies = await CrmApi.GetCompaniesAsync(_filter);
            ApplyLocalFilter();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در بارگذاری شرکت‌ها: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingCompanies = false;
        }
    }

    private void ApplyLocalFilter()
    {
        if (_selectedStatus.HasValue && _selectedStatus.Value > 0)
        {
            _filteredCompanies = _companies.Where(c => c.STATUS == _selectedStatus.Value).ToList();
        }
        else
        {
            _filteredCompanies = _companies.ToList();
        }

        // حفظ یا به‌روزرسانی مشتری منتخب
        if (_selectedCompany != null)
        {
            _selectedCompany = _filteredCompanies.FirstOrDefault(c => c.ID == _selectedCompany.ID);
            if (_selectedCompany == null && _filteredCompanies.Count > 0)
            {
                SelectCompany(_filteredCompanies[0]);
            }
        }
        else if (_filteredCompanies.Count > 0)
        {
            SelectCompany(_filteredCompanies[0]);
        }
    }

    private async void SelectCompany(CrmCompanyDto company)
    {
        _selectedCompany = company;
        _quickStatus = company.STATUS;
        _quickComment = string.Empty;
        _quickNextDate = string.Empty;
        _quickNextTime = string.Empty;
        _quickIsMeeting = false;

        if (company.ID.HasValue)
        {
            _loadingEvents = true;
            StateHasChanged();
            try
            {
                _events = await CrmApi.GetEventsByCompanyIdAsync(company.ID.Value);
            }
            finally
            {
                _loadingEvents = false;
                StateHasChanged();
            }
        }
        else
        {
            _events.Clear();
            StateHasChanged();
        }
    }

    private async Task SubmitQuickEvent()
    {
        if (_selectedCompany?.ID == null)
        {
            Snackbar.Add("لطفاً ابتدا یک مشتری را انتخاب کنید.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_quickComment))
        {
            Snackbar.Add("لطفاً شرح پیگیری یا نتیجه مذاکره را وارد کنید.", Severity.Warning);
            return;
        }

        _savingQuickEvent = true;
        try
        {
            var newEv = new CrmEventDto
            {
                IDC = _selectedCompany.ID.Value,
                COMPANY_NAME = _selectedCompany.COMPANY_NAME,
                COMMENT = _quickComment.Trim(),
                STATUS = _quickStatus ?? _selectedCompany.STATUS,
                MITING = _quickIsMeeting ? -1 : 0
            };

            if (int.TryParse(_quickNextDate, out var nd)) newEv.NEXT_DATE = nd;
            if (int.TryParse(_quickNextTime, out var nt)) newEv.NEXT_TIME = nt;

            var id = await CrmApi.SaveEventAsync(newEv);
            if (id > 0)
            {
                Snackbar.Add("پیگیری با موفقیت ثبت شد.", Severity.Success);
                _quickComment = string.Empty;
                _quickNextDate = string.Empty;
                _quickNextTime = string.Empty;
                _quickIsMeeting = false;

                // بارگذاری مجدد سوابق و آمار
                _events = await CrmApi.GetEventsByCompanyIdAsync(_selectedCompany.ID.Value);
                await LoadCompanies();
                await LoadDashboardSummary();
            }
            else
            {
                Snackbar.Add("خطا در ثبت پیگیری.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا: {ex.Message}", Severity.Error);
        }
        finally
        {
            _savingQuickEvent = false;
        }
    }

    private void SelectStatusFilter(int? statusCode)
    {
        _selectedStatus = statusCode;
        ApplyLocalFilter();
    }

    private async Task OpenSendSmsDialog()
    {
        if (_selectedCompany == null || string.IsNullOrWhiteSpace(_selectedCompany.MOBILE))
        {
            Snackbar.Add("شماره موبایل برای این مشتری ثبت نشده است.", Severity.Warning);
            return;
        }

        bool? confirm = await DialogService.ShowMessageBox(
            "ارسال پیامک به مشتری",
            $"آیا مایل به ارسال پیامک به شماره {_selectedCompany.MOBILE} ({_selectedCompany.COMPANY_NAME}) هستید؟",
            yesText: "ارسال پیامک", cancelText: "انصراف");

        if (confirm == true)
        {
            var req = new CrmSendSmsRequestDto
            {
                Mobile = _selectedCompany.MOBILE,
                Message = $"سلام {_selectedCompany.MANAGER ?? _selectedCompany.COMPANY_NAME} عزیز، جهت پیگیری درخواست شما تماس گرفته شد.",
                CompanyName = _selectedCompany.COMPANY_NAME
            };
            var sent = await CrmApi.SendSmsAsync(req);
            if (sent)
            {
                Snackbar.Add("پیامک با موفقیت ارسال شد.", Severity.Success);
            }
            else
            {
                Snackbar.Add("ارسال پیامک با خطا مواجه شد. لطفاً تنظیمات درگاه پیامک را بررسی کنید.", Severity.Error);
            }
        }
    }

