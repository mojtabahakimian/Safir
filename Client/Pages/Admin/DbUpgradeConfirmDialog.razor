@* تأییدیه‌ی اجرا.

   برای اجرای واقعی، دکمه‌ی تأیید تا وقتی نامِ دیتابیس دقیقاً تایپ نشده و
   تیکِ بکاپ خورده نباشد غیرفعال می‌ماند. سرور هم همین دو شرط را دوباره
   بررسی می‌کند؛ این صفحه فقط جلوی اشتباه را می‌گیرد، نه جلوی سوءاستفاده. *@

<MudDialog>
    <DialogContent>
        @if (Preview)
        {
            <MudAlert Severity="Severity.Info" Dense Class="mb-3">
                بررسی خشک هیچ تغییری در دیتابیس نمی‌دهد؛ فقط پارامترها و
                دسترسی بررسی می‌شوند.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Error" Dense Class="mb-3">
                این کار ساختار دیتابیس را تغییر می‌دهد و <b>برگشت‌پذیر نیست</b>.
                تنها راه بازگشت، بازگرداندن بکاپ است.
            </MudAlert>
        }

        <MudSimpleTable Dense Class="mb-3">
            <tbody>
                <tr><td class="mud-text-secondary">سرور</td><td><b>@Server</b></td></tr>
                <tr><td class="mud-text-secondary">دیتابیس</td><td><b>@Database</b></td></tr>
            </tbody>
        </MudSimpleTable>

        @if (!Preview)
        {
            <MudTextField T="string" @bind-Value="_typed" Immediate
                          Label="@($"برای تأیید، نام دیتابیس را تایپ کنید: {Database}")"
                          Variant="Variant.Outlined" Dense Class="mb-2" />

            <MudCheckBox @bind-Value="_backup" Color="Color.Primary"
                          Label="از این دیتابیس بکاپ کامل گرفته‌ام." />

            <MudCheckBox @bind-Value="_baseData" Color="Color.Primary"
                          Label="بلوک «اطلاعات پایه» هم اجرا شود" />

            @* توضیح لازم است چون اسمِ این بلوک گمراه‌کننده است: فقط درجِ
               داده نیست، بیشترش تغییر ساختار است. *@
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                این بلوک حدود ۸۴ تغییرِ ساختاری دارد که همه‌ی دیتابیس‌ها لازم‌شان
                دارند، به‌علاوه چهار فهرستِ مرجع: ارز، کشور، رتبه و نحوه‌ی پرداخت.
                این چهار فهرست عمومی‌اند و مخصوصِ هیچ شرکتی نیستند؛ اگر از قبل
                موجود باشند دوباره درج نمی‌شوند.
                <br />
                خاموش کردنش آن ۸۴ تغییر ساختاری را هم می‌خواباند — فقط وقتی
                خاموشش کنید که دلیل مشخصی دارید.
            </MudText>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">انصراف</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="@(Preview ? Color.Primary : Color.Error)"
                   Disabled="@(!CanConfirm)"
                   OnClick="Confirm">
            @(Preview ? "اجرای بررسی خشک" : "بله، اجرا کن")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Database { get; set; } = string.Empty;
    [Parameter] public string Server   { get; set; } = string.Empty;
    [Parameter] public bool   Preview  { get; set; }

    private string _typed  = string.Empty;
    private bool   _backup;
    private bool   _baseData = true;

    private bool CanConfirm =>
        Preview ||
        (_backup && string.Equals(_typed.Trim(), Database, StringComparison.OrdinalIgnoreCase));

    private void Confirm() => MudDialog.Close(DialogResult.Ok(_baseData));
    private void Cancel()  => MudDialog.Cancel();
}
