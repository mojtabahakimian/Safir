@inject Safir.Client.Services.Pay2AccessApiService Pay2Access
﻿@using Safir.Shared.Models
@using Safir.Shared.Models.Salary
@using Safir.Shared.Utility
@inject Safir.Client.Services.Pay2SettingsApiService SettingsApi
@inject ISnackbar Snackbar
@inject ConnectionManagerService ConnectionManager

<div class="pay2-tab-container" style="display: flex; flex-direction: column; height: 100%;">

    <div class="card-custom" style="padding:24px; padding-bottom: 150px; flex-grow: 1; overflow-y: auto;">
        <div style="margin-bottom:22px;">
            <h3 style="margin:0 0 8px 0;">پیکربندی سیستم (PAY2_CONFIG)</h3>
            <div class="p2-text-muted">
                کلیه تنظیمات پویا و متغیرهای محاسباتی سیستم در این بخش قابل ویرایش هستند.
            </div>
        </div>

        @if (IsLoading)
        {
            <div style="height:300px; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:12px;">
                <span class="p2-spinner" style="width:38px;height:38px;border-color:var(--p2-primary);border-top-color:transparent;"></span>
                <span class="p2-text-muted">در حال دریافت تنظیمات...</span>
            </div>
        }
        else
        {
            @foreach (var section in _orderedSections)
            {
                <div style="border-top:1px solid var(--p2-border-light); padding-top:28px; margin-top:28px;">
                    <h4 style="color:var(--p2-primary); margin:0 0 18px 0;">
                        @GetSectionNumber(section). @GetSectionTitle(section)
                    </h4>

                    <!-- 🚀 استفاده از CSS Grid برای ستون‌بندی دقیق و بی‌نقص -->
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px 16px; align-items: start;">
                        @foreach (var cfg in _groupedConfigs[section])
                        {
                            <div class="form-field @(IsChanged(cfg) ? "p2-field-changed" : "")" style="display: flex; flex-direction: column; grid-column: span @GetColumnSpan(cfg.CFG_KEY);">

                                <!-- 🚀 فیکس کردن ارتفاع لیبل‌ها: این کار باعث می‌شود تمام Input ها در یک خط تراز شوند -->
                                <label style="min-height: 38px; display: flex; align-items: flex-end; gap:6px; padding-bottom: 6px; line-height: 1.4; margin: 0;">
                                    <span>@cfg.LABEL_FA</span>
                                    @if (IsDeprecated(cfg))
                                    {
                                        <span class="p2-badge-neutral" style="padding:1px 8px; font-size:10px;" title="این تنظیم دیگر اثری ندارد؛ فقط برای سازگاری نگه داشته شده است.">منسوخ</span>
                                    }
                                    else if (IsAclOnly(cfg))
                                    {
                                        <span class="p2-badge-warning" style="padding:1px 8px; font-size:10px;" title="فقط با دسترسی «مدیریت دسترسی‌ها» قابل تغییر است.">دسترسی ادمین</span>
                                    }
                                    else if (IsCritical(cfg))
                                    {
                                        <span class="p2-badge-warning" style="padding:1px 8px; font-size:10px;" title="تنظیمی حساس — تغییرش نیاز به مجوز جداگانه دارد.">حساس</span>
                                    }
                                </label>

                                <div style="position: relative; width: 100%; display:flex; align-items:center; gap:8px;">
                                    @if (IsLocked(cfg))
                                    {
                                        <div class="pay2-input p2-readonly-field" title="@cfg.DESC_FA">
                                            <i class="bi bi-lock-fill"></i>
                                            <span class="p2-text-mono">@(string.IsNullOrWhiteSpace(cfg.CFG_VALUE) ? "—" : cfg.CFG_VALUE)</span>
                                        </div>
                                    }
                                    else if (cfg.CFG_KEY == "TAX_YEAR")
                                    {
                                        <div style="display:flex; gap:8px; align-items: stretch; height: var(--p2-input-h, 42px); flex-grow:1;">
                                            <div style="flex-grow: 1;">
                                                <Safir.Client.Pages.Salary.Tabs.Pay2NumericInput @bind-Value="cfg.CFG_VALUE"
                                                                                                 Direction="ltr"
                                                                                                 MaxLength="4" />
                                            </div>
                                            <button class="btn-outline-pay2"
                                                    style="white-space:nowrap; padding: 0 16px; height: 100%; margin: 0;"
                                                    @onclick="OpenTaxModal">
                                                مدیریت پله‌های مالیاتی
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="flex-grow:1;">
                                            @if (!string.IsNullOrWhiteSpace(cfg.CFG_OPTIONS) || cfg.DATA_TYPE?.Equals("BOOL", StringComparison.OrdinalIgnoreCase) == true)
                                            {
                                                <Safir.Client.Pages.Salary.Tabs.Pay2Select TItem="LookupDto<string>"
                                                                                           TValue="string"
                                                                                           Items="@_optionsCache[cfg.CFG_KEY]"
                                                                                           @bind-Value="cfg.CFG_VALUE"
                                                                                           TextSelector="x => x.Name"
                                                                                           ValueSelector="x => x.Id"
                                                                                           Editable="false"
                                                                                           Clearable="false" />
                                            }
                                            else if (cfg.DATA_TYPE?.Equals("INT", StringComparison.OrdinalIgnoreCase) == true ||
                                            cfg.DATA_TYPE?.Equals("DECIMAL", StringComparison.OrdinalIgnoreCase) == true)
                                            {
                                                <Safir.Client.Pages.Salary.Tabs.Pay2NumericInput @bind-Value="cfg.CFG_VALUE"
                                                                                                 InputMode="@(cfg.DATA_TYPE == "DECIMAL" ? Safir.Client.Pages.Salary.Tabs.Pay2NumericInput.NumericInputMode.Percentage : Safir.Client.Pages.Salary.Tabs.Pay2NumericInput.NumericInputMode.Amount)"
                                                                                                 IsDigitGroupActive="false"
                                                                                                 ThreeTwoZero="false"
                                                                                                 Direction="ltr" />
                                            }
                                            else
                                            {
                                                <input class="pay2-input" type="text" style="direction:ltr; text-align:left;" @bind="cfg.CFG_VALUE" />
                                            }
                                        </div>

                                        @if (!string.IsNullOrEmpty(cfg.CFG_DEFAULT) && cfg.CFG_VALUE != cfg.CFG_DEFAULT)
                                        {
                                            <button type="button" class="p2-field-reset-btn" title="بازگشت به مقدار پیش‌فرض (@cfg.CFG_DEFAULT)" @onclick="() => ResetToDefault(cfg)">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        }
                                    }
                                </div>

                                <!-- توضیحات کامل — دیگر با … بریده نمی‌شود -->
                                <div class="p2-text-muted" style="font-size:11px; margin-top:6px; line-height:1.6;">
                                    @cfg.DESC_FA
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <!-- دکمه ذخیره در پایین‌ترین قسمت صفحه فیکس شده است -->
    <div class="card-custom" style="padding: 16px 24px; margin-top: 16px; display: flex; justify-content: flex-end; align-items: center; gap:12px; background: var(--p2-bg-white); border-radius: var(--p2-radius-lg); flex-shrink: 0;">
        @if (!IsLoading && ChangedCount == 0)
        {
            <span class="p2-text-muted" style="font-size:12px;">تغییری برای ذخیره نیست.</span>
        }
        <button class="btn-primary-pay2" @onclick="SaveAllSettingsAsync"
                disabled="@(IsSaving || ChangedCount == 0 || !Pay2Access.CanUpd(Safir.Shared.Constants.Pay2Forms.Settings))"
                title="@(!Pay2Access.CanUpd(Safir.Shared.Constants.Pay2Forms.Settings) ? "دسترسی لازم برای ویرایش تنظیمات را ندارید." : "")"
                style="min-width: 250px;">
            @if (IsSaving)
            {
                <span class="p2-spinner"></span>
            }
            else if (ChangedCount > 0)
            {
                <span><i class="bi bi-save"></i> ذخیره @ChangedCount مورد تغییریافته</span>
            }
            else
            {
                <span><i class="bi bi-save"></i> ذخیره تمامی تنظیمات مرکزی</span>
            }
        </button>
    </div>
</div>

@if (ShowTaxModal)
{
    <div class="pay2-select-backdrop"
         style="background:rgba(15,23,42,0.6); z-index:2999;"
         @onclick="CloseTaxModal"></div>

    <div class="card-custom pay2-modal-container" style="max-width:850px; height:700px;">
        <div class="pay2-modal-header p2-card-header" style="margin:0;">
            <h5 style="margin:0;">مدیریت مالیات پلکانی سالانه (PAY2_TAX_BRACKET)</h5>
            <button class="btn-ghost-pay2" @onclick="CloseTaxModal">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="pay2-modal-body" style="padding:18px; overflow:auto;">
            <!-- ۱) کدام سال واقعاً در محاسبه‌ی حقوق استفاده می‌شود -->
            @if (SelectedTaxYearStr == ActiveTaxYearStr)
            {
                <div style="background:var(--p2-success-bg); border:1px solid #a7f3d0; color:#166534; border-radius:10px; padding:10px 14px; margin-bottom:14px; font-size:13px;">
                    <i class="bi bi-check-circle"></i>
                    محاسبه‌ی حقوق با پله‌های <b>سال @ActiveTaxYearStr</b> انجام می‌شود — همین جدولی که می‌بینید.
                </div>
            }
            else
            {
                <div style="background:var(--p2-warning-bg); border:1px solid var(--p2-warning-border); color:#92400e; border-radius:10px; padding:10px 14px; margin-bottom:14px; font-size:13px; display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
                    <div style="flex-grow:1;">
                        <i class="bi bi-exclamation-triangle"></i>
                        این جدول <b>سال @SelectedTaxYearStr</b> است، ولی محاسبه‌ی حقوق الان با <b>سال @ActiveTaxYearStr</b> انجام می‌شود.
                    </div>
                    <button class="btn-outline-pay2"
                            @onclick="UseSelectedYearForPayrollAsync"
                            disabled="@(!CanActivateSelectedYear)"
                            title="@(ActivateYearBlockReason ?? $"سال مالیاتی محاسبه‌ی حقوق {SelectedTaxYearStr} می‌شود")">
                        <i class="bi bi-arrow-repeat"></i> محاسبه‌ی حقوق با سال @SelectedTaxYearStr انجام شود
                    </button>
                </div>
            }

            <!-- ۲) انتخاب سال، سال جدید، کپی -->
            <div style="background: var(--p2-bg-main); border: 1px solid var(--p2-border-light); border-radius: var(--p2-radius-md); padding: 16px; margin-bottom: 16px;">
                <div style="display:flex; gap:16px; align-items:flex-end; flex-wrap: wrap;">
                    <div class="form-field" style="width:170px;">
                        <label>سال مالیاتی</label>
                        <Safir.Client.Pages.Salary.Tabs.Pay2Select TItem="LookupDto<string>"
                                                                   TValue="string"
                                                                   Items="_availableTaxYears"
                                                                   Value="@SelectedTaxYearStr"
                                                                   ValueChanged="OnTaxYearChanged"
                                                                   TextSelector="x => x.Name"
                                                                   ValueSelector="x => x.Id"
                                                                   Editable="false"
                                                                   Clearable="false"
                                                                   Disabled="_taxDirty" />
                    </div>

                    <div class="form-field" style="width:120px;">
                        <label>سال جدید</label>
                        <Safir.Client.Pages.Salary.Tabs.Pay2NumericInput @bind-Value="_newTaxYearStr"
                                                                         MaxLength="4"
                                                                         Direction="ltr"
                                                                         Placeholder="مثلاً 1406"
                                                                         Disabled="_taxDirty"
                                                                         CssClass="pay2-input" />
                    </div>
                    <button class="btn-outline-pay2" @onclick="CreateTaxYearAsync" disabled="@(_taxDirty || string.IsNullOrWhiteSpace(_newTaxYearStr))">
                        <i class="bi bi-plus-lg"></i> ایجاد سال
                    </button>

                    @if (!TaxBrackets.Any() && CopySourceYears.Any())
                    {
                        <div class="form-field" style="width:150px;">
                            <label>کپی پله‌ها از سال</label>
                            <Safir.Client.Pages.Salary.Tabs.Pay2Select TItem="LookupDto<string>"
                                                                       TValue="string"
                                                                       Items="CopySourceYears"
                                                                       @bind-Value="_copySourceYearStr"
                                                                       TextSelector="x => x.Name"
                                                                       ValueSelector="x => x.Id"
                                                                       Editable="false"
                                                                       Clearable="false" />
                        </div>
                        <button class="btn-outline-pay2" @onclick="CopyTaxYearAsync" disabled="@(!CanEditTax || string.IsNullOrWhiteSpace(_copySourceYearStr))">
                            <i class="bi bi-copy"></i> کپی
                        </button>
                    }
                </div>
                @if (_taxDirty)
                {
                    <div class="p2-text-muted" style="font-size:11px; margin-top:8px;">
                        تغییرات این جدول هنوز ذخیره نشده است؛ برای رفتن به سال دیگر، اول ذخیره کنید یا «انصراف» بزنید.
                    </div>
                }
            </div>

            <!-- ۳) جدول پله‌ها -->
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <b style="font-size:13px;">
                    پله‌های سال @SelectedTaxYearStr
                    @if (_taxLoading)
                    {
                        <span class="p2-text-muted" style="font-weight:normal;"> — در حال بارگذاری…</span>
                    }
                    else if (!_savedTaxYears.Contains(SelectedTaxYear))
                    {
                        <span class="p2-badge-warning" style="padding:1px 8px; font-size:10px; font-weight:normal;">هنوز ذخیره نشده</span>
                    }
                </b>
                <button class="btn-primary-pay2" @onclick="AddTaxBracketRow">
                    <i class="bi bi-plus-circle"></i> افزودن پله
                </button>
            </div>

            <div class="pay2-table-responsive">
                <table class="p2-table">
                    <thead style="position: sticky; top: 0; z-index: 10;">
                        <tr>
                            <th style="text-align:center;width:50px;">پله</th>
                            <th style="text-align:left;">از درآمد سالانه (ریال)</th>
                            <th style="text-align:left;">تا درآمد سالانه (ریال)</th>
                            <th style="text-align:center;width:100px;">نرخ (%)</th>
                            <th style="text-align:left;">مالیات پله‌های قبل (خودکار)</th>
                            <th style="text-align:center;width:60px;"></th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!TaxBrackets.Any() && !_taxLoading)
                        {
                            <tr>
                                <td colspan="6" style="text-align:center; padding:24px; color:var(--p2-text-muted);">
                                    برای سال @SelectedTaxYearStr پله‌ای ثبت نشده است.
                                    @if (CopySourceYears.Any())
                                    {
                                        <span>از بالا «کپی پله‌ها از سال» را بزنید، یا با «افزودن پله» دستی وارد کنید.</span>
                                    }
                                    else
                                    {
                                        <span>با «افزودن پله» وارد کنید.</span>
                                    }
                                </td>
                            </tr>
                        }

                        @{
                            long rowFrom = 0;
                        }
                        @foreach (var row in TaxBrackets.OrderBy(x => x.SORT_ORDER))
                        {
                            var from = rowFrom;
                            long.TryParse(NormalizeNumericText(row.UPPER_LIMIT_STR), out var rowTo);
                            rowFrom = rowTo;
                            <tr>
                                <td style="text-align:center; font-weight: bold;">
                                    @row.SORT_ORDER
                                </td>

                                <td class="p2-text-mono p2-text-muted" style="text-align:left;">
                                    @from.ToString("N0")
                                </td>

                                <td>
                                    <Safir.Client.Pages.Salary.Tabs.Pay2NumericInput Value="@row.UPPER_LIMIT_STR"
                                                                                     ValueChanged="@((string val) => { if (NormalizeNumericText(val) != NormalizeNumericText(row.UPPER_LIMIT_STR)) _taxDirty = true; row.UPPER_LIMIT_STR = val; RecalculateLiveFixedTax(); })"
                                                                                     InputMode="Safir.Client.Pages.Salary.Tabs.Pay2NumericInput.NumericInputMode.Amount"
                                                                                     IsDigitGroupActive="true"
                                                                                     ThreeTwoZero="true"
                                                                                     Direction="ltr"
                                                                                     Placeholder="سقف این پله"
                                                                                     CssClass="pay2-input" />
                                </td>

                                <td>
                                    <Safir.Client.Pages.Salary.Tabs.Pay2NumericInput Value="@row.RATE_PCT_STR"
                                                                                     ValueChanged="@((string val) => { if (NormalizeNumericText(val) != NormalizeNumericText(row.RATE_PCT_STR)) _taxDirty = true; row.RATE_PCT_STR = val; RecalculateLiveFixedTax(); })"
                                                                                     InputMode="Safir.Client.Pages.Salary.Tabs.Pay2NumericInput.NumericInputMode.Percentage"
                                                                                     MaxDecimalPlaces="2"
                                                                                     Direction="ltr"
                                                                                     Placeholder="%"
                                                                                     CssClass="pay2-input" />
                                </td>

                                <td class="p2-text-mono" style="text-align:left; color:var(--p2-success-text); font-weight:800; font-size: 14px;">
                                    @row.FIXED_TAX.ToString("N0")
                                </td>

                                <td style="text-align:center;">
                                    <button class="btn-ghost-pay2 p2-text-danger" title="حذف این پله"
                                            @onclick="() => RemoveTaxBracketRow(row)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="margin-top:12px; padding:12px; background:var(--p2-info-bg); border:1px solid var(--p2-info-border); border-radius:10px; color:#075985; font-size:12px; line-height:1.9;">
                <b>راهنما</b><br />
                • هر پله از سقف پله‌ی قبل شروع می‌شود؛ فقط «تا» و «نرخ» را وارد کنید.<br />
                • مبالغ <b>سالانه</b>اند و روی درآمد مشمول <b>بعد از کسر معافیت</b> حساب می‌شوند. معافیت ماهانه‌ی فعلی:
                <b class="p2-text-mono">@TaxExemptMonthlyText</b> ریال (در بخش «تنظیمات مالیات» همین صفحه).<br />
                • برای پله‌ی آخر یک عدد خیلی بزرگ بگذارید (مثلاً ۹۹٬۹۹۹٬۹۹۹٬۹۹۹) یعنی «و بالاتر».<br />
                • «مالیات پله‌های قبل» خودکار حساب می‌شود و لازم نیست واردش کنید.
            </div>

        </div>

        <div class="pay2-modal-footer" style="justify-content:flex-end;">
            @* هشدار کنار دکمه‌هاست، نه ته محتوای قابل‌اسکرول؛ آنجا دیده نمی‌شد و «انصراف» بی‌اثر به‌نظر می‌رسید *@
            @if (_confirmCloseTax)
            {
                <div style="flex-grow:1; padding:8px 12px; background:var(--p2-danger-bg); border:1px solid #fecaca; color:#991b1b; border-radius:10px; font-size:12px;">
                    <i class="bi bi-exclamation-octagon"></i>
                    تغییرات ذخیره نشده است. برای بستن <b>بدون ذخیره</b> دوباره «انصراف» یا × را بزنید.
                </div>
            }
            <button class="btn-outline-pay2" @onclick="CloseTaxModal" style="margin-left:10px;">انصراف</button>

            <button class="btn-primary-pay2" @onclick="SaveTaxBracketsAsync" disabled="@(IsSavingTax || !CanEditTax)">
                @if (IsSavingTax)
                {
                    <span class="p2-spinner"></span>
                }
                else
                {
                    <span>ذخیره پله‌ها برای سال @SelectedTaxYearStr</span>
                }
            </button>
        </div>
    </div>
}

@code {
    /// <summary>بعد از ذخیره‌ی تنظیمات صدا زده می‌شود تا صفحه‌ی میزبان با دسترسی‌های تازه رندر شود.</summary>
    [Parameter] public EventCallback OnAccessChanged { get; set; }

    List<Pay2ConfigDto> Configs = new();
    List<Pay2TaxBracketDto> TaxBrackets = new();

    // کش‌های اختصاصی
    Dictionary<string, List<Pay2ConfigDto>> _groupedConfigs = new();
    Dictionary<string, List<LookupDto<string>>> _optionsCache = new();
    List<string> _orderedSections = new();

    // مقدار خام هر تنظیم درست بعد از لود — برای فهمیدن اینکه کاربر واقعاً
    // چه چیزی را دست‌کاری کرده. بدون این، دکمه‌ی «ذخیره» همیشه هر ۴۵ ردیف
    // را می‌فرستد، حتی آن‌هایی که دست نخورده‌اند؛ و سرور چون بین ارسالی‌ها
    // یک کلید ACL_ یا حساس می‌بیند، مجوز مدیر ارشد می‌خواهد — حتی برای
    // کسی که فقط می‌خواست یک ضریب اضافه‌کار را عوض کند.
    Dictionary<string, string> _originalValues = new();

    bool IsChanged(Pay2ConfigDto cfg) =>
        _originalValues.TryGetValue(cfg.CFG_KEY, out var orig) ? orig != (cfg.CFG_VALUE ?? "") : true;

    int ChangedCount => Configs.Count(IsChanged);

    void ResetToDefault(Pay2ConfigDto cfg) => cfg.CFG_VALUE = cfg.CFG_DEFAULT;

    // دو فیلدی که فقط رویه‌ی تأییدشده‌ی دیتابیس مقداردهی می‌کند، نه اپراتور
    // (توضیح خودشان در DESC_FA همین را می‌گوید).
    static bool IsSystemManaged(Pay2ConfigDto cfg) =>
        cfg.CFG_KEY is "INS_NON_SUBJECT_OPT_IN" or "INS_NON_SUBJECT_EFFECTIVE_FROM";

    // تنظیمات منسوخ با همان قراردادی که در دیتابیس ثبت شده (DESC_FA با
    // «منسوخ» شروع می‌شود) شناسایی می‌شوند، نه با نام کلید — تا اگر فردا
    // تنظیم دیگری هم منسوخ شد، فقط کافی است توضیحش را همین‌طور بنویسند.
    static bool IsDeprecated(Pay2ConfigDto cfg) =>
        cfg.DESC_FA?.StartsWith("منسوخ", StringComparison.Ordinal) == true;

    static bool IsLocked(Pay2ConfigDto cfg) => IsSystemManaged(cfg) || IsDeprecated(cfg);

    static bool IsCritical(Pay2ConfigDto cfg) => cfg.ACCESS_LEVEL == 1;

    static bool IsAclOnly(Pay2ConfigDto cfg) =>
        cfg.CFG_KEY.StartsWith("ACL_", StringComparison.OrdinalIgnoreCase);

    // کش سال‌های مالیاتی برای Pay2Select
    List<LookupDto<string>> _availableTaxYears = new();

    // سال‌هایی که واقعاً در دیتابیس پله دارند (بدون ردیف «جدید»)
    List<short> _savedTaxYears = new();

    // کپی از هر سالِ ذخیره‌شده‌ی دیگر — نه فقط «سال قبل» (۱۴۰۵ از ۱۴۰۳ هم باید قابل کپی باشد)
    List<LookupDto<string>> CopySourceYears =>
        _savedTaxYears.Where(y => y != SelectedTaxYear)
                      .OrderByDescending(y => y)
                      .Select(y => new LookupDto<string> { Id = y.ToString(), Name = $"سال {y}" })
                      .ToList();

    string _newTaxYearStr = "";
    string _copySourceYearStr = "";
    bool _taxDirty;          // جدول تغییر ذخیره‌نشده دارد
    bool _taxLoading;        // تا پاسخ نیامده «پله‌ای ثبت نشده» نشان داده نشود
    bool _confirmCloseTax;   // بار اولِ بستن با تغییر ذخیره‌نشده فقط هشدار می‌دهد

    // مقدار ذخیره‌شده (نه ویرایشِ ذخیره‌نشده‌ی همین صفحه)
    string ActiveTaxYearStr => _originalValues.TryGetValue("TAX_YEAR", out var v) ? v : "";
    string TaxExemptMonthlyText =>
        _originalValues.TryGetValue("TAX_EXEMPT_MONTHLY", out var v) && long.TryParse(v, out var n) ? n.ToString("N0") : "—";

    // سرور برای ذخیره‌ی پله‌ها، کپی و TAX_YEAR هر دو را می‌خواهد (ویرایش تنظیمات + تنظیمات حساس)؛
    // با فقط یکی، دکمه فعال می‌ماند و کلیک همیشه ۴۰۳ می‌گرفت.
    bool CanEditTax =>
        Pay2Access.CanUpd(Safir.Shared.Constants.Pay2Forms.Settings) &&
        Pay2Access.Access.CanRun(Safir.Shared.Constants.Pay2Forms.ActConfigCritical);

    string? ActivateYearBlockReason =>
        !CanEditTax ? "برای تغییر سال مالیاتی دسترسی لازم را ندارید"
        : _taxDirty ? "اول پله‌ها را ذخیره کنید"
        : !_savedTaxYears.Contains(SelectedTaxYear) ? $"برای سال {SelectedTaxYear} هنوز پله‌ای ذخیره نشده است"
        : null;
    bool CanActivateSelectedYear => ActivateYearBlockReason == null;

    bool IsLoading = true;
    bool IsSaving = false;
    bool ShowTaxModal = false;
    bool IsSavingTax = false;

    short SelectedTaxYear;
    string SelectedTaxYearStr
    {
        get => SelectedTaxYear.ToString();
        set { if (short.TryParse(value, out short y)) SelectedTaxYear = y; }
    }

    protected override async Task OnInitializedAsync()
    {
        await ConnectionManager.LoadSettingsAsync();
        await LoadSettingsAsync();
    }

    async Task LoadSettingsAsync()
    {
        IsLoading = true;

        try
        {
            Configs = await SettingsApi.GetConfigsAsync();

            _orderedSections = Configs
                .Select(x => x.CFG_SECTION)
                .Distinct()
                .OrderBy(GetSectionOrder)
                .ToList();

            _groupedConfigs = Configs
                .GroupBy(x => x.CFG_SECTION)
                .ToDictionary(g => g.Key, g => g.ToList());

            _optionsCache.Clear();
            _originalValues = Configs.ToDictionary(c => c.CFG_KEY, c => c.CFG_VALUE ?? "");
            foreach (var cfg in Configs)
            {
                if (!string.IsNullOrWhiteSpace(cfg.CFG_OPTIONS))
                {
                    _optionsCache[cfg.CFG_KEY] = GetOptionsAsLookup(cfg);
                }
                else if (cfg.DATA_TYPE?.Equals("BOOL", StringComparison.OrdinalIgnoreCase) == true)
                {
                    _optionsCache[cfg.CFG_KEY] = GetBoolOptions();
                }
            }

            var taxYear = GetConfig("TAX_YEAR");
            if (short.TryParse(taxYear?.CFG_VALUE, out var y))
            {
                SelectedTaxYear = y;
            }
            else
            {
                string currentShamsi = CL_Tarikh.GetCurrentPersianDateAsLong().ToString();
                SelectedTaxYear = short.Parse(currentShamsi.Substring(0, 4));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private List<LookupDto<string>> GetOptionsAsLookup(Pay2ConfigDto cfg)
    {
        var opts = SplitOptions(cfg.CFG_OPTIONS);
        var lbls = SplitOptions(cfg.OPT_LABELS);

        // اگر ستون OPT_LABELS خالی باشد و نوع BOOL باشد، به‌جای نمایش خودِ
        // مقدار خام («۰»/«۱») یک برچسب قابل‌فهم می‌گذاریم. این دقیقاً همان
        // چیزی بود که چهار کلید ACL_ (اضافه‌شده در همین PR) را نشان می‌داد،
        // چون OPT_LABELS‌شان خالی ماند — و برای هر کلید BOOL دیگری هم که در
        // آینده بدون برچسب اضافه شود، همین اتفاق تکرار می‌شد.
        bool useGenericBoolLabel = lbls.Count == 0 &&
            cfg.DATA_TYPE?.Equals("BOOL", StringComparison.OrdinalIgnoreCase) == true;

        var result = new List<LookupDto<string>>();
        for (int i = 0; i < opts.Count; i++)
        {
            string name = i < lbls.Count
                ? lbls[i]
                : useGenericBoolLabel
                    ? opts[i] switch { "1" => "فعال", "0" => "غیرفعال", _ => opts[i] }
                    : opts[i];

            result.Add(new LookupDto<string> { Id = opts[i], Name = name });
        }
        return result;
    }

    private List<LookupDto<string>> GetBoolOptions()
    {
        return new List<LookupDto<string>>
        {
            new LookupDto<string> { Id = "1", Name = "بله" },
            new LookupDto<string> { Id = "0", Name = "خیر" }
        };
    }

    async Task SaveAllSettingsAsync()
    {
        // فقط فیلدهایی که واقعاً دست‌کاری شده‌اند فرستاده می‌شوند — نه هر ۴۵
        // ردیف. قبلاً همه‌چیز یک‌جا می‌رفت، پس اگر کاربر فقط یک ضریب معمولی
        // را عوض می‌کرد ولی یک کلید ACL_ یا حساس هم (دست‌نخورده) در فهرست
        // بود، سرور مجوز مدیر ارشد می‌خواست و کل ذخیره با ۴۰۳ رد می‌شد.
        var changed = Configs.Where(IsChanged).ToList();
        if (changed.Count == 0) return;

        IsSaving = true;

        try
        {
            await SettingsApi.SaveConfigsAsync(new Pay2ConfigSaveRequest
            {
                Items = changed,
                ChangeNote = "بروزرسانی از صفحه تنظیمات سیستم"
            });

            Snackbar.Add($"{changed.Count} مورد با موفقیت ذخیره شد.", MudBlazor.Severity.Success);
            await LoadSettingsAsync();

            // کلیدهای ACL_* رفتار کل صفحه را عوض می‌کنند (نوار هشدار، منوها، دکمه‌ها).
            // Pay2AccessApiService یک بار در شروع لود می‌شود و تا رفرش کامل مرورگر
            // همان مقدار قدیمی را نگه می‌دارد؛ پس اینجا صریحاً تازه‌اش می‌کنیم.
            await Pay2Access.EnsureLoadedAsync(forceReload: true);
            await OnAccessChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            IsSaving = false;
        }
    }

    async Task OpenTaxModal()
    {
        // پنجره روی همان سالی باز می‌شود که محاسبه‌ی حقوق با آن انجام می‌شود
        if (short.TryParse(ActiveTaxYearStr, out var active)) SelectedTaxYear = active;
        _taxDirty = false;
        _confirmCloseTax = false;
        _newTaxYearStr = "";
        _taxLoading = true;
        ShowTaxModal = true;
        await LoadTaxYearsLookupAsync();
        await LoadTaxBracketsAsync();
    }

    void CloseTaxModal()
    {
        if (_taxDirty && !_confirmCloseTax)
        {
            _confirmCloseTax = true;
            return;
        }
        ShowTaxModal = false;
        _taxDirty = false;
        _confirmCloseTax = false;
    }

    async Task LoadTaxYearsLookupAsync()
    {
        try
        {
            _savedTaxYears = (await SettingsApi.GetTaxYearsAsync()).ToList();
            _availableTaxYears = _savedTaxYears.Select(y => new LookupDto<string>
            {
                Id = y.ToString(),
                Name = $"سال {y}"
            }).ToList();

            // سالی که تازه ایجاد شده و هنوز پله‌ی ذخیره‌شده ندارد. برچسبش عمداً همان «سال X» است:
            // Pay2Select متن نمایش‌داده‌شده را با عوض شدن برچسبِ همان مقدار تازه نمی‌کند، پس «(جدید)»
            // بعد از ذخیره روی کادر می‌ماند. وضعیت «ذخیره‌نشده» کنار عنوان جدول نشان داده می‌شود.
            if (SelectedTaxYear > 0 && !_savedTaxYears.Contains(SelectedTaxYear))
            {
                _availableTaxYears.Insert(0, new LookupDto<string> { Id = SelectedTaxYearStr, Name = $"سال {SelectedTaxYearStr}" });
            }

            _copySourceYearStr = CopySourceYears.FirstOrDefault()?.Id ?? "";
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
    }

    async Task OnTaxYearChanged(string newYear)
    {
        if (string.IsNullOrWhiteSpace(newYear) || _taxDirty) return;

        SelectedTaxYearStr = newYear;
        await LoadTaxYearsLookupAsync();
        await LoadTaxBracketsAsync();
    }

    async Task CreateTaxYearAsync()
    {
        var text = NormalizeNumericText(_newTaxYearStr);
        if (!short.TryParse(text, out var year) || year < 1300 || year > 1499)
        {
            Snackbar.Add("سال را ۴ رقمی وارد کنید (مثلاً 1406).", MudBlazor.Severity.Warning);
            return;
        }

        SelectedTaxYear = year;
        _newTaxYearStr = "";
        await LoadTaxYearsLookupAsync();
        await LoadTaxBracketsAsync();
    }

    async Task LoadTaxBracketsAsync()
    {
        _taxLoading = true;
        try
        {
            TaxBrackets = await SettingsApi.GetTaxBracketsAsync(SelectedTaxYear);
            NormalizeTaxBracketStrings();
            _taxDirty = false;
            _confirmCloseTax = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _taxLoading = false;
        }
    }

    async Task CopyTaxYearAsync()
    {
        if (!short.TryParse(_copySourceYearStr, out var source)) return;

        try
        {
            await SettingsApi.CopyTaxYearAsync(new Pay2TaxBracketCopyRequest
            {
                SourceYear = source,
                TargetYear = SelectedTaxYear
            });

            Snackbar.Add($"پله‌های سال {source} به سال {SelectedTaxYear} کپی و ذخیره شد. اگر پله‌ها برای این سال فرق دارند، اصلاح و ذخیره کنید.", MudBlazor.Severity.Success);
            await LoadTaxYearsLookupAsync();
            await LoadTaxBracketsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
    }

    // TAX_YEAR را مستقیم ذخیره می‌کند؛ بدون این، کاربر پله‌های سال جدید را ثبت می‌کرد ولی محاسبه
    // بی‌صدا با سال قبلی ادامه می‌داد (همان اتفاقی که برای یزدسپار افتاد: پله‌ی ۱۴۰۵ بود، سال ۱۴۰۳ ماند).
    async Task UseSelectedYearForPayrollAsync()
    {
        var cfg = GetConfig("TAX_YEAR");
        if (cfg == null || !CanActivateSelectedYear) return;

        try
        {
            await SettingsApi.SaveConfigsAsync(new Pay2ConfigSaveRequest
            {
                Items = new List<Pay2ConfigDto> { new() { CFG_KEY = cfg.CFG_KEY, CFG_VALUE = SelectedTaxYearStr } },
                ChangeNote = "تغییر سال مالیاتی از پنجره‌ی پله‌های مالیاتی"
            });

            // فقط همین کلید در صفحه به‌روز می‌شود تا ویرایش‌های ذخیره‌نشده‌ی دیگرِ صفحه از بین نرود
            cfg.CFG_VALUE = SelectedTaxYearStr;
            _originalValues["TAX_YEAR"] = SelectedTaxYearStr;

            Snackbar.Add($"از این به بعد محاسبه‌ی حقوق با پله‌های سال {SelectedTaxYearStr} انجام می‌شود. معافیت ماهانه‌ی این سال را هم در «تنظیمات مالیات» بررسی کنید.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
    }

    void AddTaxBracketRow()
    {
        var nextOrder = TaxBrackets.Count == 0
            ? 1
            : TaxBrackets.Max(x => x.SORT_ORDER) + 1;

        // سطر جدید خالی است؛ قبلاً با ۹٬۹۹۹٬۹۹۹٬۹۹۹ پر می‌شد و سطر دوم با آن هم‌سقف می‌شد
        TaxBrackets.Add(new Pay2TaxBracketDto
        {
            TAX_YEAR = SelectedTaxYear,
            SORT_ORDER = (short)nextOrder,
            UPPER_LIMIT_STR = "",
            RATE_PCT_STR = "",
            FIXED_TAX_STR = "0"
        });

        _taxDirty = true;
        RecalculateLiveFixedTax();
    }

    void RemoveTaxBracketRow(Pay2TaxBracketDto row)
    {
        TaxBrackets.Remove(row);

        short order = 1;
        foreach (var item in TaxBrackets.OrderBy(x => x.SORT_ORDER))
            item.SORT_ORDER = order++;

        _taxDirty = true;
        RecalculateLiveFixedTax();
    }

    // 🚀 محاسبه لحظه‌ای مالیات در UI (مشابه نسخه WPF)
    void RecalculateLiveFixedTax()
    {
        long prevLimit = 0;
        long fixedTax = 0;

        foreach (var row in TaxBrackets.OrderBy(x => x.SORT_ORDER))
        {
            row.FIXED_TAX = fixedTax;

            long.TryParse(NormalizeNumericText(row.UPPER_LIMIT_STR), out long currentLimit);
            decimal.TryParse(NormalizeNumericText(row.RATE_PCT_STR), out decimal currentRate);

            var taxableInThisStep = currentLimit - prevLimit;
            if (taxableInThisStep < 0) taxableInThisStep = 0;

            fixedTax += (long)Math.Round(taxableInThisStep * (double)currentRate / 100D);
            prevLimit = currentLimit;
        }

        StateHasChanged();
    }

    async Task SaveTaxBracketsAsync()
    {
        IsSavingTax = true;

        if (SelectedTaxYear < 1300 || SelectedTaxYear > 1499)
        {
            Snackbar.Add("سال مالیاتی نامعتبر است.", MudBlazor.Severity.Warning);
            IsSavingTax = false;
            return;
        }

        try
        {
            if (!TaxBrackets.Any())
                throw new InvalidOperationException("حداقل یک پله وارد کنید.");

            long previousUpper = 0;
            foreach (var row in TaxBrackets.OrderBy(x => x.SORT_ORDER))
            {
                var upperText = NormalizeNumericText(row.UPPER_LIMIT_STR);
                var rateText = NormalizeNumericText(row.RATE_PCT_STR);

                if (!long.TryParse(upperText, out var upper) || upper <= 0)
                    throw new InvalidOperationException($"پله {row.SORT_ORDER}: ستون «تا درآمد سالانه» را وارد کنید.");

                if (upper <= previousUpper)
                    throw new InvalidOperationException($"پله {row.SORT_ORDER}: «تا» باید از سقف پله‌ی قبل ({previousUpper:N0}) بیشتر باشد.");

                if (!decimal.TryParse(rateText, out var rate) || rate < 0 || rate > 100)
                    throw new InvalidOperationException($"پله {row.SORT_ORDER}: نرخ را بین ۰ تا ۱۰۰ وارد کنید.");

                row.TAX_YEAR = SelectedTaxYear;
                row.UPPER_LIMIT = upper;
                row.RATE_PCT = rate;
                previousUpper = upper;
            }

            await SettingsApi.SaveTaxBracketsAsync(new Pay2TaxBracketSaveRequest
            {
                TAX_YEAR = SelectedTaxYear,
                Items = TaxBrackets
            });

            Snackbar.Add($"پله‌های مالیاتی سال {SelectedTaxYearStr} ذخیره شد.", MudBlazor.Severity.Success);

            // به‌روزرسانی لیست سال‌های دراپ‌داون در صورت ایجاد سال جدید
            await LoadTaxYearsLookupAsync();
            await LoadTaxBracketsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            IsSavingTax = false;
        }
    }

    void NormalizeTaxBracketStrings()
    {
        foreach (var row in TaxBrackets)
        {
            row.UPPER_LIMIT_STR = row.UPPER_LIMIT.ToString();
            row.RATE_PCT_STR = row.RATE_PCT.ToString("0.##");
            row.FIXED_TAX_STR = row.FIXED_TAX.ToString();
        }
    }

    Pay2ConfigDto? GetConfig(string key)
    {
        return Configs.FirstOrDefault(x => x.CFG_KEY == key);
    }

    static List<string> SplitOptions(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return new();

        return text.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
    }

    static int GetSectionOrder(string section) => section switch
    {
        "محاسبه" => 1,
        "بیمه" => 2,
        "INSURANCE" => 3,   // زیرمجموعه‌ی بیمه (استثنای شیفت/اضافه‌کار) — بلافاصله بعد از «بیمه»
        "مالیات" => 4,
        "مساعده" => 5,
        "مرخصی" => 6,
        "تسویه" => 7,
        "امنیت" => 8,
        _ => 99
    };

    static string GetSectionTitle(string section) => section switch
    {
        "محاسبه" => "تنظیمات پایه و محاسباتی",
        "بیمه" => "تنظیمات بیمه",
        "INSURANCE" => "استثنائات بیمه (شیفت و اضافه‌کار)",
        "مالیات" => "تنظیمات مالیات",
        "مساعده" => "مساعده هوشمند (Smart Advances)",
        "مرخصی" => "مرخصی",
        "تسویه" => "تسویه حساب، عیدی و سنوات",
        "امنیت" => "امنیت و دسترسی‌ها",
        _ => section
    };

    static int GetColumnSpan(string key) => key switch
    {
        "TAX_YEAR" => 2,
        _ => 1
    };

    static int GetSectionNumber(string section) => GetSectionOrder(section);

    static string NormalizeNumericText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "";

        var result = new List<char>();

        foreach (var ch in value.Trim())
        {
            if (ch >= '0' && ch <= '9')
                result.Add(ch);
            else if (ch >= '۰' && ch <= '۹')
                result.Add((char)('0' + (ch - '۰')));
            else if (ch >= '٠' && ch <= '٩')
                result.Add((char)('0' + (ch - '٠')));
            else if (ch == '.' || ch == '-')
                result.Add(ch);
        }

        return new string(result.ToArray());
    }
}