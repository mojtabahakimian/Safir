        public string PermFlagFa => PermFlag switch
        {
            "Run" => "اجرا / ورود",
            "See" => "مشاهده",
            "Inp" => "ایجاد",
            "Upd" => "ویرایش",
            "Del" => "حذف",
            _ => PermFlag ?? "—"
        };
    }

    private static string FormatPersianDateTime(DateTime dt)
    {
        if (dt == default || dt == DateTime.MinValue) return "—";
        try
        {
            var pc = new System.Globalization.PersianCalendar();
            int year = pc.GetYear(dt);
            int month = pc.GetMonth(dt);
            int day = pc.GetDayOfMonth(dt);
            return $"{year:0000}/{month:00}/{day:00} {dt:HH:mm}";
        }
        catch
        {
            return dt.ToString("yyyy/MM/dd HH:mm");
        }
    }

    /// <summary>
    /// «اجرا» پیش‌نیاز بقیه است: با روشن‌شدن هر مجوزی خودش روشن می‌شود
    /// (رفتار قبلی) و با خاموش‌شدنش بقیه هم پاک می‌شوند — وگرنه ترکیبی
    /// ذخیره می‌شد که کاربر اصلاً نمی‌تواند وارد فرم شود ولی مجوز
    /// ویرایش دارد.
    /// </summary>
    private void SetPerm(Pay2FormPermDto perm, string prop, bool val)
    {
        if (prop == "Run")
        {
            perm.Run = val;
            if (!val)
            {
                perm.See = perm.Inp = perm.Upd = perm.Del = false;
            }
            return;
        }

        if (prop == "See") perm.See = val;
        else if (prop == "Upd") perm.Upd = val;
        else if (prop == "Inp") perm.Inp = val;
        else if (prop == "Del") perm.Del = val;

        if (val && !perm.Run) perm.Run = true;
    }
}
