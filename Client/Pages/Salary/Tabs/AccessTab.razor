@page "/salary/access-tab"
@using Safir.Shared.Models.Permissions
@inject Safir.Client.Services.Pay2AccessApiService Pay2Access
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject MudBlazor.IDialogService DialogService
@implements IDisposable

<style>
    .p2-access-card {
        position: relative;
        min-height: 400px;
    }

    .p2-access-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.65);
        z-index: 20;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: var(--p2-radius-lg);
        backdrop-filter: blur(3px);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s ease, visibility 0.25s ease;
    }

        .p2-access-overlay.active {
            opacity: 1;
            visibility: visible;
        }

    .p2-access-body {
        transition: opacity 0.25s ease, filter 0.25s ease;
    }

        .p2-access-body.loading {
            opacity: 0.35;
            filter: grayscale(20%);
            pointer-events: none;
        }
</style>

<div class="pay2-tab-container">
    <div class="pay2-two-panel">

        @* ══════════════════════════════════════════
           پنل راست: فهرست کاربران سیستم
           ══════════════════════════════════════════ *@
        <div class="pay2-two-panel-list">

            <div class="pay2-card-header" style="padding: 18px; border-bottom: 1px solid var(--p2-border-light); margin: 0;">
                <h5><i class="bi bi-people"></i> کاربران سیستم</h5>
            </div>

            <div style="padding: 14px 18px; border-bottom: 1px solid var(--p2-border-light);">
                <div class="pay2-search-wrapper">
                    <i class="bi bi-search"></i>
                    <input type="text" class="pay2-search-input" style="width: 100%; border: none; background: var(--p2-bg-main);"
                           placeholder="جستجوی کاربر..." @bind="_searchUser" @bind:event="oninput" />
                </div>
            </div>

            @if (!FilteredUsers.Any())
            {
                <div class="p2-empty-state">
                    <i class="bi bi-person-x"></i>
                    <h4>کاربری یافت نشد</h4>
                </div>
            }
            else
            {
                <div style="max-height: calc(100vh - 260px); overflow-y: auto;">
                    <table class="p2-table">
                        <tbody>
                            @foreach (var u in FilteredUsers)
                            {
                                <tr class="workshop-row @(_selectedUser?.UserId == u.UserId || _loadingUserId == u.UserId ? "active" : "")"
                                    @onclick="() => SelectUserAsync(u)">
                                    <td>
                                        @if (_loadingUserId == u.UserId)
                                        {
                                            <span class="p2-spinner" style="width: 14px; height: 14px; border-width: 2px; margin-left: 8px; display: inline-block; vertical-align: middle;"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-circle p2-text-muted" style="margin-left: 8px;"></i>
                                        }
                                        <span class="p2-text-bold">@u.UserName</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @* ══════════════════════════════════════════
           پنل چپ: تنظیم دسترسی کاربر انتخاب‌شده
           ══════════════════════════════════════════ *@
        <div class="pay2-two-panel-form">

            @if (_selectedUser == null)
            {
                <div class="card-custom">
                    <div class="p2-empty-state">
                        <i class="bi bi-shield-lock"></i>
                        <h4>کاربری انتخاب نشده است</h4>
                        <p>برای تنظیم دسترسی، یک کاربر را از فهرست کنار انتخاب کنید.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="card-custom p2-access-card">

                    <div class="p2-access-overlay @(_isLoadingUserAccess ? "active" : "")">
                        <div class="p2-spinner"></div>
                        <span style="margin-top: 10px; font-size: 13px; font-weight: 600; color: var(--p2-primary);">در حال به‌روزرسانی دسترسی‌ها...</span>
                    </div>

                    <div class="p2-access-body @(_isLoadingUserAccess ? "loading" : "")">

                        <div class="pay2-card-header">
                            <h5 style="color: var(--p2-primary);">
                                <i class="bi bi-shield-check"></i> دسترسی‌های «@_selectedUser.UserName»
                            </h5>
                            <button class="btn-primary-pay2" @onclick="SaveAccess" disabled="@(_isSaving || _isLoadingUserAccess)">
                                @if (_isSaving)
                                {
                                    <span class="p2-spinner"></span>
                                    <span>در حال ذخیره...</span>
                                }
                                else
                                {
                                    <i class="bi bi-save"></i>
                                    <span>ذخیره دسترسی‌ها</span>
                                }
                            </button>
                        </div>

                        @* نوار بخش‌ها — با همان واژگان دکمه‌های سیستم، نه MudTabs *@
                        <div class="p2-table-toolbar p2-mt-16">
                            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                                @foreach (var s in Sections)
                                {
                                    <button class="@(_section == s.Key ? "btn-primary-pay2" : "btn-outline-pay2") p2-btn-sm"
                                            @onclick="() => _section = s.Key">
                                        <i class="bi @s.Icon"></i>
                                        <span>@s.Title</span>
                                    </button>
                                }
                            </div>
                        </div>

                        @* ── بخش ۱: دسترسی فرم‌ها ─────────────────────────── *@
                        @if (_section == "forms")
                        {
                            @if (IsEditingSelf)
                            {
                                <div class="p2-mt-16" style="display:flex; align-items:center; gap:8px; padding:10px 14px; font-size:12.5px; border-radius:var(--p2-radius-md); background:var(--p2-info-bg); color:var(--p2-info-text); border:1px solid var(--p2-info-border);">
                                    <i class="bi bi-shield-lock"></i>
                                    <span>نمی‌توانید دسترسی «مدیریت دسترسی‌ها» را از حساب خودتان بردارید — این محافظ جلوی قفل‌شدن کل سیستم را می‌گیرد. برای تغییر مدیر، اول به نفر جدید این دسترسی را بدهید، بعد با حساب او دسترسی نفر قبلی را بردارید.</span>
                                </div>
                            }
                            <div class="p2-mt-16" style="display:flex; align-items:center; gap:8px;">
                                <button class="btn-outline-pay2 p2-btn-sm" disabled="@_syncingForms" @onclick="SyncCostForms">
                                    @if (_syncingForms)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-repeat"></i>
                                    }
                                    <span>همگام‌سازی فرم‌های بستن ماه</span>
                                </button>
                                <span style="font-size:11.5px;color:var(--p2-text-secondary)">
                                    اگر بعد از یک به‌روزرسانیِ نرم‌افزار، فرمِ تازه‌ای در این فهرست نبود، این را بزنید.
                                </span>
                            </div>

                            <div class="p2-sub-card">
                                <div class="p2-sub-card-title">اعمال سریع قالب آماده</div>
                                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                                    @foreach (var p in Presets)
                                    {
                                        // «حذف کامل دسترسی» روی حساب خودتان عمداً غیرفعال است — همان محافظی
                                        // که سرور هم اعمال می‌کند (SaveUserAccess/ApplyPreset)، ولی اینجا
                                        // پیش از فرستادن درخواست، همان‌جا با یک توضیح روشن جلویش گرفته می‌شود.
                                        var blockedForSelf = p.Key == "NONE" && IsEditingSelf;
                                        <button class="@(p.Key == "NONE" ? "btn-outline-danger-pay2" : "btn-outline-pay2") p2-btn-sm"
                                                disabled="@blockedForSelf"
                                                title="@(blockedForSelf ? "برای جلوگیری از قفل‌شدن خودتان بیرون از سیستم، نمی‌توانید تمام دسترسی‌های حساب خودتان را حذف کنید." : "")"
                                                @onclick="() => ConfirmAndApplyPreset(p)">
                                            <i class="bi @p.Icon"></i>
                                            <span>@p.Title</span>
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="pay2-table-responsive p2-mt-16">
                                <table class="p2-table">
                                    <thead>
                                        <tr>
                                            <th>نام فرم / بخش</th>
                                            <th class="p2-text-center">اجرا (ورود به فرم)</th>
                                            <th class="p2-text-center">مشاهده</th>
                                            <th class="p2-text-center">ایجاد</th>
                                            <th class="p2-text-center">ویرایش</th>
                                            <th class="p2-text-center">حذف</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var f in _forms.Where(x => x.IsAction == 0))
                                        {
                                            var perm = GetOrCreatePerm(f.FormName, f.Caption);
                                            // ردیف «مدیریت دسترسی‌ها»ی خودِ کاربرِ لاگین‌کرده: چک‌باکس «اجرا» را
                                            // قفل و همیشه تیک‌خورده نگه می‌داریم تا کسی نتواند از همین‌جا خودش
                                            // را از این صفحه بیرون بیندازد. سرور هم همین قانون را اعمال می‌کند
                                            // (این فقط جلوگیریِ زودتر و با توضیح روشن‌تر است، نه جایگزین آن).
                                            var lockRun = f.FormName == Safir.Shared.Constants.Pay2Forms.AdminAcl && IsEditingSelf;
                                            if (lockRun) perm.Run = true;
                                            <tr>
                                                <td>@f.Caption</td>
                                                <td class="p2-text-center">
                                                    <input type="checkbox" checked="@perm.Run" disabled="@lockRun"
                                                           title="@(lockRun ? "برای جلوگیری از قفل‌شدن خودتان بیرون از سیستم، این مجوز روی حساب خودتان قابل حذف نیست." : "")"
                                                           @onchange='e => SetPerm(perm, "Run", (bool)e.Value!)' />
                                                </td>
                                                <td class="p2-text-center">
                                                    <input type="checkbox" checked="@perm.See"
                                                           @onchange='e => SetPerm(perm, "See", (bool)e.Value!)' />
                                                </td>
                                                <td class="p2-text-center">
                                                    <input type="checkbox" checked="@perm.Inp"
                                                           @onchange='e => SetPerm(perm, "Inp", (bool)e.Value!)' />
                                                </td>
                                                <td class="p2-text-center">
                                                    <input type="checkbox" checked="@perm.Upd"
                                                           @onchange='e => SetPerm(perm, "Upd", (bool)e.Value!)' />
                                                </td>
                                                <td class="p2-text-center">
                                                    <input type="checkbox" checked="@perm.Del"
                                                           @onchange='e => SetPerm(perm, "Del", (bool)e.Value!)' />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @* ── بخش ۲: عملیات حساس ───────────────────────────── *@
                        @if (_section == "actions")
                        {
                            <div class="pay2-table-responsive p2-mt-16">
                                <table class="p2-table">
                                    <thead>
                                        <tr>
                                            <th>عملیات</th>
                                            <th class="p2-text-center">مجاز است</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var f in _forms.Where(x => x.IsAction == 1))
                                        {
                                            var perm = GetOrCreatePerm(f.FormName, f.Caption);
                                            <tr>
                                                <td>@f.Caption</td>
                                                <td class="p2-text-center">
                                                    <input type="checkbox" checked="@perm.Run"
                                                           @onchange='e => SetPerm(perm, "Run", (bool)e.Value!)' />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @* ── بخش ۳: کارگاه‌های مجاز ───────────────────────── *@
                        @if (_section == "workshops")
                        {
                            <div class="p2-sub-card">
                                <label class="pay2-wpf-checkbox-box">
                                    <input type="checkbox" checked="@AllWorkshopsSelected"
                                           @onchange="e => ToggleAllWorkshops((bool)e.Value!)" />
                                    <span class="pay2-wpf-checkbox-label">انتخاب همه کارگاه‌ها</span>
                                </label>
                            </div>

                            @if (!_workshops.Any())
                            {
                                <div class="p2-empty-state">
                                    <i class="bi bi-building"></i>
                                    <h4>کارگاهی تعریف نشده است</h4>
                                </div>
                            }
                            else
                            {
                                <div class="form-grid-3 p2-mt-16">
                                    @foreach (var ws in _workshops)
                                    {
                                        <label class="pay2-wpf-checkbox-box">
                                            <input type="checkbox" checked="@IsWorkshopSelected(ws.WS_ID)"
                                                   @onchange="e => SetWorkshop(ws.WS_ID, (bool)e.Value!)" />
                                            <span class="pay2-wpf-checkbox-label">@ws.WS_NAME</span>
                                        </label>
                                    }
                                </div>
                            }
                        }

                        @* ── بخش ۴: سابقه دسترسی ─────────────────────────── *@
                        @if (_section == "audit")
                        {
                            <div class="p2-table-toolbar p2-mt-16">
                                <span class="p2-text-muted p2-text-sm">
                                    تلاش‌های مجاز و مسدودشده‌ی این کاربر روی بخش حقوق و دستمزد
                                </span>
                                <button class="btn-outline-pay2 p2-btn-sm" @onclick="LoadAudit">
                                    <i class="bi bi-arrow-clockwise"></i>
                                    <span>به‌روزرسانی</span>
                                </button>
                            </div>

                            @if (!_logs.Any())
                            {
                                <div class="p2-empty-state">
                                    <i class="bi bi-clock-history"></i>
                                    <h4>سابقه‌ای ثبت نشده</h4>
                                    <p>دکمه «به‌روزرسانی» را بزنید تا سابقه خوانده شود.</p>
                                </div>
                            }
                            else
                            {
                                <div class="pay2-table-responsive">
                                    <table class="p2-table">
                                        <thead>
                                            <tr>
                                                <th>تاریخ و زمان</th>
                                                <th>فرم / بخش</th>
                                                <th class="p2-text-center">سطح دسترسی</th>
                                                <th>توضیحات عملیات</th>
                                                <th class="p2-text-center">وضعیت</th>
                                                <th class="p2-text-center">IP</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var l in _logs)
                                            {
                                                <tr>
                                                    <td class="p2-text-mono p2-text-sm">@FormatPersianDateTime(l.CRT)</td>
                                                    <td style="font-weight: 600;">@(string.IsNullOrWhiteSpace(l.FormCaption) ? l.FormName : l.FormCaption)</td>
                                                    <td class="p2-text-center">
                                                        <span class="p2-badge-neutral">@l.PermFlagFa</span>
                                                    </td>
                                                    <td class="p2-text-sm p2-text-muted">@l.Details</td>
                                                    <td class="p2-text-center">
                                                        @if (l.Allowed)
                                                        {
                                                            <span class="p2-badge-success">مجاز</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="p2-badge-danger">مسدود</span>
                                                        }
                                                    </td>
                                                    <td class="p2-text-center p2-text-mono p2-text-sm">@(l.Ip == "::1" ? "127.0.0.1" : l.Ip)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }

                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {

    public class Pay2UserDto { public int UserId { get; set; } public string UserName { get; set; } = ""; }
    public class Pay2FormSimpleDto { public string FormName { get; set; } = ""; public string Caption { get; set; } = ""; public int IsAction { get; set; } }
    public class Pay2WsDto { public int WS_ID { get; set; } public string WS_NAME { get; set; } = ""; }

    /// <summary>بخش‌های این صفحه — به‌جای MudTabs، با همان دکمه‌های سیستم.</summary>
    private record Section(string Key, string Title, string Icon);
    private static readonly Section[] Sections =
    {
        new("forms",     "دسترسی فرم‌ها",    "bi-ui-checks-grid"),
        new("actions",   "عملیات حساس",      "bi-exclamation-triangle"),
        new("workshops", "کارگاه‌های مجاز",  "bi-building"),
        new("audit",     "سابقه دسترسی",     "bi-clock-history"),
    };

    private record Preset(string Key, string Title, string Icon);
    private static readonly Preset[] Presets =
    {
        new("PAYROLL_MANAGER", "مدیر حقوق",          "bi-person-badge"),
        new("PAYROLL_OFFICER", "کارشناس حقوق",       "bi-person-workspace"),
        new("HR_OFFICER",      "کارگزینی",           "bi-person-vcard"),
        new("ACCOUNTANT",      "حسابدار",            "bi-calculator"),
        new("VIEWER",          "ناظر (فقط مشاهده)",  "bi-eye"),
        new("NONE",            "حذف کامل دسترسی",    "bi-x-octagon"),
    };

    private List<Pay2UserDto> _users = new();
    private List<Pay2FormSimpleDto> _forms = new();
    private List<Pay2WsDto> _workshops = new();

    private Pay2UserDto? _selectedUser;
    private string _searchUser = "";
    private string _section = "forms";
    private bool _isSaving = false;
    private bool _isLoadingUserAccess = false;
    private int? _loadingUserId;

    private CancellationTokenSource? _selectUserCts;
    private long _selectUserVersion = 0;

    private List<Pay2FormPermDto> _userForms = new();
    private List<int> _userWsIds = new();
    private List<Pay2AuditEntry> _logs = new();

    private IEnumerable<Pay2UserDto> FilteredUsers =>
        _users.Where(x => string.IsNullOrEmpty(_searchUser) || x.UserName.Contains(_searchUser, StringComparison.OrdinalIgnoreCase));

    /// <summary>آیا کاربرِ در حال ویرایش، همان کاربرِ لاگین‌کرده است؟</summary>
    private bool IsEditingSelf => _selectedUser != null && Pay2Access.Access.UserCo == _selectedUser.UserId;

    private bool AllWorkshopsSelected =>
        _workshops.Any() && _workshops.All(w => _userWsIds.Contains(w.WS_ID));

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _users = await Http.GetFromJsonAsync<List<Pay2UserDto>>("api/pay2/access/users") ?? new();
            _forms = await Http.GetFromJsonAsync<List<Pay2FormSimpleDto>>("api/pay2/access/forms") ?? new();
            // عمداً از api/pay2/workshops استفاده نمی‌کنیم: آن فهرست به محدوده‌ی
            // کارگاهیِ خودِ مدیر محدود می‌شود و اینجا همان محدوده در حال تعیین است.
            _workshops = await Http.GetFromJsonAsync<List<Pay2WsDto>>("api/pay2/access/workshops") ?? new();
        }
        catch
        {
            Snackbar.Add("خطا در بارگذاری اطلاعات اولیه.", Severity.Error);
        }
    }

    private bool _syncingForms;

    private async Task SyncCostForms()
    {
        _syncingForms = true;
        try
        {
            var res = await Http.PostAsync("api/pay2/access/sync-cost-forms", null);
            if (!res.IsSuccessStatusCode)
            {
                Snackbar.Add("همگام‌سازی ناموفق بود.", Severity.Error);
                return;
            }

            var body = await res.Content.ReadFromJsonAsync<SyncCostFormsResult>();
            if (body is { addedCount: > 0 })
            {
                Snackbar.Add($"{body.addedCount} فرم جدید اضافه شد: {string.Join("، ", body.added)}", Severity.Success);
                _forms = await Http.GetFromJsonAsync<List<Pay2FormSimpleDto>>("api/pay2/access/forms") ?? new();
            }
            else
            {
                Snackbar.Add("همه‌ی فرم‌ها از قبل ثبت بودند — چیزی اضافه نشد.", Severity.Info);
            }
        }
        catch
        {
            Snackbar.Add("همگام‌سازی ناموفق بود.", Severity.Error);
        }
        finally
        {
            _syncingForms = false;
        }
    }

    private sealed class SyncCostFormsResult
    {
        public List<string> added { get; set; } = new();
        public int addedCount { get; set; }
        public int alreadyPresent { get; set; }
    }

    private async Task SelectUserAsync(Pay2UserDto user)
    {
        if (_loadingUserId == user.UserId) return;

        CancelSelectUser();

        var myVersion = Interlocked.Increment(ref _selectUserVersion);
        var cts = new CancellationTokenSource();
        _selectUserCts = cts;
        var token = cts.Token;

        _loadingUserId = user.UserId;
        _isLoadingUserAccess = true;
        StateHasChanged();

        var startTime = DateTime.UtcNow;

        try
        {
            var res = await Http.GetFromJsonAsync<Safir.Shared.Models.Permissions.Pay2AccessDto>(
                $"api/pay2/access/user/{user.UserId}", token);

            if (token.IsCancellationRequested || myVersion != _selectUserVersion)
                return;

            var elapsedMs = (DateTime.UtcNow - startTime).TotalMilliseconds;
            if (elapsedMs < 120)
            {
                await Task.Delay(120 - (int)elapsedMs, token);
            }

            if (token.IsCancellationRequested || myVersion != _selectUserVersion)
                return;

            if (res != null)
            {
                _selectedUser = user;
                _userForms = res.Forms ?? new();
                _userWsIds = res.AllowedWorkshopIds ?? new();
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            if (token.IsCancellationRequested || myVersion != _selectUserVersion)
                return;

            Snackbar.Add("خطا در دریافت دسترسی کاربر.", Severity.Error);
        }
        finally
        {
            if (myVersion == _selectUserVersion)
            {
                _loadingUserId = null;
                _isLoadingUserAccess = false;
                StateHasChanged();
            }
        }
    }

    private async Task ReloadSelectedUserAccessAsync()
    {
        if (_selectedUser == null) return;
        await SelectUserAsync(_selectedUser);
    }

    private void CancelSelectUser()
    {
        var cts = _selectUserCts;
        _selectUserCts = null;

        if (cts == null)
            return;

        try { cts.Cancel(); } catch { }
        try { cts.Dispose(); } catch { }
    }

    public void Dispose()
    {
        CancelSelectUser();
    }

    private Pay2FormPermDto GetOrCreatePerm(string formName, string caption)
    {
        var f = _userForms.FirstOrDefault(x => x.FormName == formName);
        if (f == null)
        {
            f = new Pay2FormPermDto { FormName = formName, Caption = caption };
            _userForms.Add(f);
        }
        return f;
    }

    private bool IsWorkshopSelected(int wsId) => _userWsIds.Contains(wsId);

    private void SetWorkshop(int wsId, bool value)
    {
        if (value && !_userWsIds.Contains(wsId)) _userWsIds.Add(wsId);
        else if (!value && _userWsIds.Contains(wsId)) _userWsIds.Remove(wsId);
    }

    private void ToggleAllWorkshops(bool val)
    {
        _userWsIds.Clear();
        if (val)
        {
            foreach (var w in _workshops)
            {
                _userWsIds.Add(w.WS_ID);
            }
        }
    }

    private async Task ConfirmAndApplyPreset(Preset preset)
    {
        if (_selectedUser == null) return;

        bool isDeleteAll = preset.Key == "NONE";

        var title = isDeleteAll ? "تایید حذف دسترسی‌ها" : "تایید اعمال قالب دسترسی";
        var message = isDeleteAll
            ? $"آیا از حذف کامل تمامی دسترسی‌های کاربر «{_selectedUser.UserName}» در سیستم حقوق و دستمزد اطمینان دارید؟\n\nتذکر: با این کار، تمامی مجوزهای فرم‌ها و کارگاه‌های این کاربر سلب خواهد شد."
            : $"آیا از اعمال قالب دسترسی «{preset.Title}» برای کاربر «{_selectedUser.UserName}» اطمینان دارید؟\n\nتذکر: با این کار، دسترسی‌های فعلی این کاربر جایگزین خواهند شد.";
        var confirmBtn = isDeleteAll ? "بله، حذف شود" : "بله، اعمال شود";

        var parameters = new MudBlazor.DialogParameters
        {
            ["Title"] = title,
            ["ContentText"] = message,
            ["ConfirmButtonText"] = confirmBtn,
            ["CancelButtonText"] = "انصراف"
        };

        var options = new MudBlazor.DialogOptions
        {
            CloseButton = false,
            MaxWidth = MudBlazor.MaxWidth.ExtraSmall
        };

        var dialog = DialogService.Show<Safir.Client.Shared.ConfirmDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await ApplyPreset(preset.Key);
        }
    }

    private async Task ApplyPreset(string presetKey)
    {
        if (_selectedUser == null) return;
        try
        {
            var res = await Http.PostAsync($"api/pay2/access/user/{_selectedUser.UserId}/preset/{presetKey}", null);
            if (res.IsSuccessStatusCode)
            {
                // قالب روی سرور اعمال شده؛ همان‌جا دوباره می‌خوانیمش تا
                // کاربر مجبور نباشد دستی دوباره انتخابش کند.
                await ReloadSelectedUserAccessAsync();
                Snackbar.Add("قالب با موفقیت اعمال شد.", Severity.Success);
            }
            else
            {
                var msg = await res.Content.ReadAsStringAsync();
                Snackbar.Add(msg, Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("خطا در اعمال قالب.", Severity.Error);
        }
    }

    private async Task SaveAccess()
    {
        if (_selectedUser == null) return;
        _isSaving = true;
        try
        {
            var req = new { Forms = _userForms, AllowedWorkshopIds = _userWsIds };
            var res = await Http.PostAsJsonAsync($"api/pay2/access/user/{_selectedUser.UserId}/save", req);

            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("دسترسی‌ها با موفقیت ذخیره شد.", Severity.Success);
                // اگر کاربر دسترسی خودش را عوض کرده، منوی خودش هم باید تازه شود.
                if (Pay2Access.Access.UserCo == _selectedUser.UserId)
                {
                    await Pay2Access.EnsureLoadedAsync(true);
                }
            }
            else
            {
                var msg = await res.Content.ReadAsStringAsync();
                Snackbar.Add(msg, Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("خطا در ذخیره دسترسی‌ها.", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task LoadAudit()
    {
        if (_selectedUser == null) return;
        try
        {
            int uId = _selectedUser.UserId;
            _logs = await Http.GetFromJsonAsync<List<Pay2AuditEntry>>($"api/pay2/access/audit?userCo={uId}") ?? new();
        }
        catch
        {
            Snackbar.Add("خطا در دریافت لاگ.", Severity.Error);
        }
    }

