    // ─────────────────────────── کارت‌های شاخص ───────────────────────────

    private Kpi ActiveKpi =>
        _view == View.Board ? Kpi.None :
        _status == 1 && _urgentOnly && !_staleOnly ? Kpi.Urgent :
        _status == 1 && _staleOnly ? Kpi.Stale :
        _status == 1 && !_urgentOnly ? Kpi.Open :
        _status == 2 ? Kpi.Done :
        _status == 3 ? Kpi.Cancelled : Kpi.None;

    private async Task ApplyKpi(Kpi k)
    {
        _urgentOnly = k == Kpi.Urgent;
        _staleOnly = k == Kpi.Stale;
        var status = k switch { Kpi.Done => 2, Kpi.Cancelled => 3, _ => 1 };
        if (k == Kpi.Done) _sort = Sort.Newest;
        else if (k == Kpi.Stale) _sort = Sort.Oldest;
        else if (_sort == Sort.Oldest) _sort = Sort.Smart;

        if (_view != View.List || _status != status)
        {
            _view = View.List;
            _status = status;
            _selected.Clear();
            await ReloadAsync(withSummary: false);
        }
        else
        {
            Recompute();
        }
    }

    private async Task ShowNewest()
    {
        _urgentOnly = false;
        _staleOnly = false;
        _sort = Sort.Newest;
        if (_view != View.List || _status != 1)
        {
            _view = View.List;
            _status = 1;
            _selected.Clear();
            await ReloadAsync(withSummary: false);
        }
        else
        {
            Recompute();
        }
    }

