    private bool AllVisibleSelected => _visible.Count > 0 && _visible.All(t => _selected.Contains(t.IDNUM));

    private void ToggleSelect(TaskModel t)
    {
        if (!_selected.Remove(t.IDNUM)) _selected.Add(t.IDNUM);
    }

    private void ToggleSelectAll()
    {
        if (AllVisibleSelected) _selected.ExceptWith(_visible.Select(t => t.IDNUM));
        else _selected.UnionWith(_visible.Select(t => t.IDNUM));
    }

    private void ClearSelection() => _selected.Clear();

    // ─────────────────────────── عملیات سریع ───────────────────────────

    private Task ToggleDoneAsync(TaskModel t) => SetStatusAsync(t, t.STATUS == 1 ? 2 : 1);

    private async Task SetStatusAsync(TaskModel t, int status)
    {
        if (t.STATUS == status) return;
        var before = TaskComposer.Copy(t);
        var updated = TaskComposer.Copy(t);
        updated.STATUS = status;
        TaskComposer.StampDoneDate(updated, t.STATUS);

        if (!await SaveQuickAsync(t, updated)) return;

        // کارتِ «پیشنهاد برای شروع» از خلاصه می‌آید و نمونه‌ی جدایی از همان
        // وظیفه است؛ تغییر باید روی نمونه‌ی داخلِ فهرست هم بنشیند.
        var local = _tasks.FirstOrDefault(x => x.IDNUM == t.IDNUM);
        foreach (var item in new[] { t, local })
        {
            if (item is null) continue;
            item.STATUS = updated.STATUS;
            item.ENDATE = updated.ENDATE;
            item.ENTIME = updated.ENTIME;
        }
        t = local ?? t;

        var msg = status switch { 2 => "انجام شد ✓", 3 => "وظیفه لغو شد.", _ => "وظیفه دوباره باز شد." };
        Snackbar.Add($"#{t.IDNUM} — {msg}", status == 2 ? Severity.Success : Severity.Info, c =>
        {
            c.Action = "بازگردانی";
            c.ActionColor = Color.Primary;
            c.VisibleStateDuration = 8000; // فرصتِ کافی برای پشیمان شدن
            c.Onclick = _ => InvokeAsync(() => UndoAsync(before));
        });

        // از فهرستِ فیلترشده خارج می‌شود — با یک محوِ کوتاه، نه پرشِ ناگهانی.
        if (_view == View.List && _status != 0 && _status != status)
        {
            _leaving.Add(t.IDNUM);
            StateHasChanged();
            await Task.Delay(360);
            _leaving.Remove(t.IDNUM);
            _tasks.Remove(t);
            _selected.Remove(t.IDNUM);
        }
        Recompute();
        _drop?.Refresh();
        StateHasChanged();
        await RefreshSummaryAsync();
    }

    private async Task TogglePriorityAsync(TaskModel t)
    {
        var updated = TaskComposer.Copy(t);
        updated.PERIORITY = t.PERIORITY == 1 ? 2 : 1;
        if (!await SaveQuickAsync(t, updated)) return;
        t.PERIORITY = updated.PERIORITY;
        if (_tasks.FirstOrDefault(x => x.IDNUM == t.IDNUM) is { } local) local.PERIORITY = updated.PERIORITY;
        Snackbar.Add(t.PERIORITY == 1 ? $"#{t.IDNUM} فوری شد." : $"#{t.IDNUM} معمولی شد.", Severity.Info);
        Recompute();
        _drop?.Refresh();
        await RefreshSummaryAsync();
    }

    private async Task<bool> SaveQuickAsync(TaskModel original, TaskModel updated)
    {
        if (string.IsNullOrWhiteSpace(updated.COMP_COD) || string.IsNullOrWhiteSpace(updated.TASK))
        {
            Snackbar.Add("این وظیفه گیرنده یا شرح ندارد؛ اول آن را از «ویرایش» کامل کنید.", Severity.Warning);
            OpenTask(original);
            return false;
        }
        if (!_busy.Add(original.IDNUM)) return false;
        StateHasChanged();
        try
        {
            var ok = await AutomationService.UpdateTaskAsync(updated.IDNUM, updated);
            if (!ok) Snackbar.Add("تغییر ذخیره نشد. دوباره تلاش کنید.", Severity.Error);
            return ok;
        }
        finally
        {
            _busy.Remove(original.IDNUM);
        }
    }

    private async Task UndoAsync(TaskModel before)
    {
        if (await AutomationService.UpdateTaskAsync(before.IDNUM, before))
        {
            Snackbar.Add($"#{before.IDNUM} به حالت قبل برگشت.", Severity.Normal);
            await ReloadAsync();
        }
        else
        {
            Snackbar.Add("بازگردانی انجام نشد.", Severity.Error);
        }
    }

    private async Task OnDropAsync(MudItemDropInfo<TaskModel> info)
    {
        if (info.Item is null || !int.TryParse(info.DropzoneIdentifier, out var status)) return;
        if (info.Item.STATUS == status) return;
        await SetStatusAsync(info.Item, status);
    }

