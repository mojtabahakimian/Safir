@page "/automation/tasks"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Safir.Shared.Constants
@using Safir.Shared.Models
@using Safir.Shared.Models.Automation
@using Safir.Shared.Interfaces
@using Safir.Client.Components.Automation
@using MudBlazor

@inject IAutomationApiService AutomationService
@inject LookupApiService LookupService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ConnectionManagerService ConnectionManager
@inject IJSRuntime JS
@implements IAsyncDisposable

@attribute [Authorize]

<PageTitle>کارتابل اتوماسیون</PageTitle>

<div class="atm">

    @* ═════════════ سربرگ ═════════════ *@
    <section class="atm-hero">
        <div class="atm-hero__grid"></div>

        <div class="atm-hero__top">
            <div style="min-width:0;flex:1 1 420px">
                <span class="atm-hero__date"><i class="bi bi-calendar3"></i>@AutomationUi.LongDate(_now)</span>
                <h1>@AutomationUi.Greeting(_now)، @(string.IsNullOrWhiteSpace(UserNameDisplay) ? "همکار عزیز" : UserNameDisplay) <span class="atm-wave">👋</span></h1>
                <p class="atm-hero__sub">@HeroSentence</p>

                @if (_summary is not null && IsOwnInbox)
                {
                    <div class="atm-insights">
                        @if (_summary.OpenUrgent > 0)
                        {
                            <button type="button" class="atm-insight atm-insight--urgent" @onclick="() => ApplyKpi(Kpi.Urgent)">
                                <i class="bi bi-lightning-charge-fill"></i>@_summary.OpenUrgent کار فوری منتظر شماست
                            </button>
                        }
                        @if (_summary.OpenStale > 0)
                        {
                            <button type="button" class="atm-insight atm-insight--stale" @onclick="() => ApplyKpi(Kpi.Stale)">
                                <i class="bi bi-hourglass-bottom"></i>@_summary.OpenStale کار بیش از @_summary.StaleDays روز باز مانده
                            </button>
                        }
                        @if (_summary.NewToday > 0)
                        {
                            <button type="button" class="atm-insight" @onclick="ShowNewest">
                                <i class="bi bi-inbox-fill"></i>@_summary.NewToday ارجاعِ تازه‌ی امروز
                            </button>
                        }
                        @if (_summary.DoneThisWeek > 0)
                        {
                            <button type="button" class="atm-insight atm-insight--good" @onclick="() => ApplyKpi(Kpi.Done)">
                                <i class="bi bi-trophy-fill"></i>این هفته @_summary.DoneThisWeek کار را به سرانجام رساندید
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="atm-hero__side">
                <div class="atm-hero__actions">
                    <button type="button" class="atm-btn atm-btn--light" @onclick="() => NewTask()" title="وظیفه‌ی جدید (N)">
                        <i class="bi bi-plus-lg"></i>وظیفه‌ی جدید
                    </button>
                    <button type="button" class="atm-btn atm-btn--glass" @onclick="ShowMessagesDialog" title="پیام‌های داخلی">
                        <i class="bi bi-chat-dots-fill"></i>پیام‌ها
                        @if (_unreadMessageCount > 0)
                        {
                            <span class="atm-badge atm-badge--pulse">@_unreadMessageCount</span>
                        }
                    </button>
                    <button type="button" class="atm-btn atm-btn--glass" @onclick="ShowRemindersDialog" title="یادآوری‌ها">
                        <i class="bi bi-bell-fill"></i>یادآوری‌ها
                        @if (_activeReminderCount > 0)
                        {
                            <span class="atm-badge" style="background:#f59e0b">@_activeReminderCount</span>
                        }
                    </button>
                    <button type="button" class="atm-btn atm-btn--glass" @onclick="() => _guideOpen = true" title="فیلم آموزشِ یک‌دقیقه‌ای">
                        <i class="bi bi-play-circle-fill"></i>آموزش
                    </button>
                    <button type="button" class="atm-btn atm-btn--glass atm-btn--icon" @onclick="() => ReloadAsync()" disabled="@_loading" title="بروزرسانی (R)">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>

                @if (_summary is not null && _summary.Open + _summary.Done > 0)
                {
                    var rate = (double)_summary.Done / (_summary.Open + _summary.Done);
                    const double circ = 2 * Math.PI * 38;
                    <div class="atm-ringbox" title="نسبتِ کارهای انجام‌شده به کلِ کارهای ارجاع‌شده">
                        <div style="text-align:end;font-size:.78rem;opacity:.85;line-height:1.7">
                            <div>@_summary.Done انجام‌شده</div>
                            <div>@_summary.Open در انتظار</div>
                        </div>
                        <div class="atm-ring">
                            <svg viewBox="0 0 92 92">
                                <circle class="track" cx="46" cy="46" r="38" />
                                <circle class="bar" cx="46" cy="46" r="38"
                                        stroke-dasharray="@circ.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                        stroke-dashoffset="@((circ * (1 - rate)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" />
                            </svg>
                            <div class="atm-ring__label"><b>@Math.Round(rate * 100)٪</b><small>نرخ انجام</small></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (_summary?.Focus is { } focus && focus.STATUS == 1)
        {
            <div class="atm-focus">
                <div class="atm-focus__icon">@(focus.PERIORITY == 1 ? "🔥" : "🎯")</div>
                <div style="min-width:0">
                    <div class="atm-focus__eyebrow">پیشنهاد برای شروع — @(focus.PERIORITY == 1 ? "فوری‌ترین کار باز" : "قدیمی‌ترین کار باز")</div>
                    <div class="atm-focus__text">@focus.TASK</div>
                    <div class="atm-focus__meta">
                        #@focus.IDNUM
                        @if (!string.IsNullOrWhiteSpace(focus.NAME)) { <span> · @focus.NAME</span> }
                        · @AutomationUi.Ago(focus.STDATE, focus.STTIME, _now)
                    </div>
                </div>
                <div class="atm-focus__actions">
                    <button type="button" class="atm-btn atm-btn--glass" @onclick="() => OpenTask(focus)"><i class="bi bi-box-arrow-up-left"></i>باز کردن</button>
                    <button type="button" class="atm-btn atm-btn--light" disabled="@_busy.Contains(focus.IDNUM)" @onclick="() => SetStatusAsync(focus, 2)"><i class="bi bi-check2-circle"></i>انجام شد</button>
                </div>
            </div>
        }
    </section>

    @* ═════════════ کارت‌های شاخص ═════════════ *@
    <section class="atm-kpis">
        <button type="button" class="atm-kpi atm-kpi--open @(ActiveKpi == Kpi.Open ? "is-active" : "")" style="--i:0" @onclick="() => ApplyKpi(Kpi.Open)">
            <span class="atm-kpi__icon"><i class="bi bi-inbox"></i></span>
            <span><span class="atm-kpi__num">@(_summary?.Open.ToString() ?? "—")</span><span class="atm-kpi__label d-block">در انتظار انجام</span></span>
        </button>
        <button type="button" class="atm-kpi atm-kpi--urgent @(ActiveKpi == Kpi.Urgent ? "is-active" : "")" style="--i:1" @onclick="() => ApplyKpi(Kpi.Urgent)">
            <span class="atm-kpi__icon"><i class="bi bi-lightning-charge"></i></span>
            <span><span class="atm-kpi__num">@(_summary?.OpenUrgent.ToString() ?? "—")</span><span class="atm-kpi__label d-block">فوری</span></span>
        </button>
        <button type="button" class="atm-kpi atm-kpi--stale @(ActiveKpi == Kpi.Stale ? "is-active" : "")" style="--i:2" @onclick="() => ApplyKpi(Kpi.Stale)">
            <span class="atm-kpi__icon"><i class="bi bi-hourglass-split"></i></span>
            <span><span class="atm-kpi__num">@(_summary?.OpenStale.ToString() ?? "—")</span><span class="atm-kpi__label d-block">معوق (بیش از @(_summary?.StaleDays ?? 30) روز)</span></span>
        </button>
        <button type="button" class="atm-kpi atm-kpi--done @(ActiveKpi == Kpi.Done ? "is-active" : "")" style="--i:3" @onclick="() => ApplyKpi(Kpi.Done)">
            <span class="atm-kpi__icon"><i class="bi bi-check2-circle"></i></span>
            <span><span class="atm-kpi__num">@(_summary?.DoneThisWeek.ToString() ?? "—")</span><span class="atm-kpi__label d-block">انجام‌شده‌ی این هفته</span></span>
        </button>
        <button type="button" class="atm-kpi atm-kpi--cancel @(ActiveKpi == Kpi.Cancelled ? "is-active" : "")" style="--i:4" @onclick="() => ApplyKpi(Kpi.Cancelled)">
            <span class="atm-kpi__icon"><i class="bi bi-slash-circle"></i></span>
            <span><span class="atm-kpi__num">@(_summary?.Cancelled.ToString() ?? "—")</span><span class="atm-kpi__label d-block">لغو شده</span></span>
        </button>
    </section>

    @* ═════════════ نوار ابزار ═════════════ *@
    <section class="atm-toolbar">
        @if (_view == View.List)
        {
            <div class="atm-seg" role="tablist" aria-label="وضعیت">
                @foreach (var (s, label, color) in StatusTabs)
                {
                    <button type="button" role="tab" aria-selected="@(_status == s)" class="@(_status == s ? "is-active" : "")"
                            @onclick="() => SetStatusFilter(s)">
                        <span class="dot" style="color:@color"></span>@label
                        <span class="count">@CountFor(s)</span>
                    </button>
                }
            </div>
        }

        <div class="atm-search">
            <i class="bi bi-search"></i>
            <input id="atm-search" type="search" placeholder="جستجو در شرح، گیرنده، شماره…" autocomplete="off"
                   value="@_search" @oninput="OnSearch" />
            @if (string.IsNullOrEmpty(_search)) { <kbd>/</kbd> }
        </div>

        <button type="button" class="atm-toggle @(_urgentOnly ? "is-on" : "")" @onclick="ToggleUrgentOnly" title="فقط کارهای فوری">
            <i class="bi @(_urgentOnly ? "bi-lightning-charge-fill" : "bi-lightning-charge")"></i>فوری‌ها
        </button>

        @if (_canFilterByUser)
        {
            <div class="atm-field">
                <MudSelect T="int?" Value="_userId" ValueChanged="OnUserChanged" Dense="true" Variant="Variant.Outlined"
                           Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter" Placeholder="کارتابلِ…"
                           AdornmentIcon="@Icons.Material.Outlined.People">
                    <MudSelectItem T="int?" Value="@((int?)Userid)">کارتابل خودم</MudSelectItem>
                    @foreach (var p in _subordinates)
                    {
                        <MudSelectItem T="int?" Value="@((int?)p.USERCO)">@p.SAL_NAME</MudSelectItem>
                    }
                </MudSelect>
            </div>
        }

        <div class="atm-field">
            <MudSelect T="int?" MultiSelection="true" SelectedValues="_docFilter" SelectedValuesChanged="OnDocFilterChanged"
                       Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter"
                       Placeholder="همه‌ی انواع سند" MultiSelectionTextFunc="DocFilterText"
                       AdornmentIcon="@Icons.Material.Outlined.Description">
                @foreach (var d in _docTypes)
                {
                    <MudSelectItem T="int?" Value="@((int?)d.ID)">@d.NAME</MudSelectItem>
                }
            </MudSelect>
        </div>

        @if (_view == View.List)
        {
            <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true" Class="atm-push">
                <ActivatorContent>
                    <button type="button" class="atm-toggle" title="مرتب‌سازی"><i class="bi bi-sort-down"></i>@SortLabel(_sort)</button>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var s in Enum.GetValues<Sort>())
                    {
                        <MudMenuItem OnClick="() => SetSort(s)">
                            <i class="bi @(s == _sort ? "bi-check2" : "bi-dot") ml-2"></i>@SortLabel(s)
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }

        <div class="atm-view @(_view == View.Board ? "atm-push" : "")" role="group" aria-label="نما">
            <button type="button" class="@(_view == View.List ? "is-active" : "")" title="فهرست" @onclick="() => SetView(View.List)"><i class="bi bi-list-task"></i></button>
            <button type="button" class="@(_view == View.Board ? "is-active" : "")" title="بُرد (کانبان)" @onclick="() => SetView(View.Board)"><i class="bi bi-kanban"></i></button>
        </div>
    </section>

    @if (_loading)
    {
        <div class="atm-progress" aria-hidden="true"></div>
    }

    @if (!IsOwnInbox)
    {
        <div class="atm-viewing">
            <i class="bi bi-person-badge"></i>
            در حال مشاهده‌ی کارتابلِ <b>@PersonelName(_userId ?? 0)</b>
            <button type="button" class="atm-btn atm-btn--ghost" style="height:32px" @onclick="() => OnUserChanged(Userid)">
                <i class="bi bi-arrow-return-right"></i>کارتابل خودم
            </button>
        </div>
    }

    @* ═════════════ محتوا ═════════════ *@
    @if (!_loadedOnce)
    {
        <div class="atm-list">
            @for (int i = 0; i < 6; i++) { <div class="atm-skel" style="margin-bottom:10px;animation-delay:@(i * 90)ms"></div> }
        </div>
    }
    else if (_view == View.List)
    {
        @if (_visible.Count > 0)
        {
            <div class="atm-listhead">
                <label class="atm-check" title="انتخاب همه‌ی موارد نمایش‌داده‌شده">
                    <input type="checkbox" checked="@AllVisibleSelected" @onchange="ToggleSelectAll" />
                    <span></span>
                </label>
                <span>@_visible.Count وظیفه@(_visible.Count != _tasks.Count ? $" از {_tasks.Count}" : "")</span>
                @if (_staleOnly)
                {
                    <button type="button" class="atm-pill atm-pill--urgent" style="border:0;cursor:pointer" @onclick="ClearStale">
                        معوق‌ها <i class="bi bi-x"></i>
                    </button>
                }
                <span class="spacer"></span>
                @if (_selected.Count > 0) { <span>@_selected.Count انتخاب‌شده</span> }
            </div>

            <div class="atm-list">
                <Virtualize Items="_visible" Context="t" ItemSize="96" OverscanCount="6">
                    <div style="padding-bottom:10px" @key="t.IDNUM">
                        <TaskCard Item="t" Selectable="true" Selected="_selected.Contains(t.IDNUM)"
                                  Busy="_busy.Contains(t.IDNUM)" Leaving="_leaving.Contains(t.IDNUM)"
                                  Index="IndexOf(t)" Now="_now" StaleDays="StaleDays" DocTypes="_docTypes"
                                  OnOpen="OpenTask" OnEvents="t2 => ShowEventsDialog(t2.IDNUM)"
                                  OnToggleDone="ToggleDoneAsync" OnToggleSelect="ToggleSelect"
                                  OnTogglePriority="TogglePriorityAsync" OnSetStatus="x => SetStatusAsync(x.Item, x.Status)" />
                    </div>
                </Virtualize>
            </div>
        }
        else
        {
            <EmptyState Title="@EmptyTitle" Text="@EmptyText">
                @if (HasClientFilters)
                {
                    <button type="button" class="atm-btn atm-btn--ghost" @onclick="ClearFilters"><i class="bi bi-funnel"></i>پاک کردن فیلترها</button>
                }
                else if (_status == 1 && IsOwnInbox)
                {
                    <button type="button" class="atm-btn atm-btn--primary" @onclick="() => NewTask()"><i class="bi bi-plus-lg"></i>وظیفه‌ی جدید</button>
                }
            </EmptyState>
        }
    }
    else
    {
        <MudDropContainer T="TaskModel" @ref="_drop" Items="_visible" ItemsSelector="@((item, zone) => item.STATUS.ToString() == zone)"
                          ItemDropped="OnDropAsync" Class="atm-board" ItemDraggingClass="atm-dragging">
            <ChildContent>
                @foreach (var (s, label, _) in StatusTabs.Where(x => x.Status != 0))
                {
                    var count = _boardTotal.GetValueOrDefault(s);
                    var hidden = count - _visible.Count(x => x.STATUS == s);
                    <div class="atm-col atm-col--@s">
                        <div class="atm-col__head">
                            <span class="dot"></span>@label
                            <span class="count">@count@(s != 1 && CountFor(s) > count && !HasClientFilters ? $" از {CountFor(s)}" : "")</span>
                            @if (s == 1 && IsOwnInbox)
                            {
                                <button type="button" class="atm-icon-btn" style="width:28px;height:28px" title="وظیفه‌ی جدید" @onclick="() => NewTask()"><i class="bi bi-plus-lg"></i></button>
                            }
                        </div>
                        <MudDropZone T="TaskModel" Identifier="@s.ToString()" Class="@($"atm-dropzone {(count == 0 ? "is-empty" : "")}")" />
                        @if (hidden > 0)
                        {
                            <button type="button" class="atm-btn atm-btn--ghost" style="margin-top:10px;width:100%" @onclick="() => ShowMoreInColumn(s)">
                                <i class="bi bi-chevron-down"></i>نمایش @Math.Min(hidden, BoardPage) موردِ دیگر (@hidden مانده)
                            </button>
                        }
                        @if (s != 1 && CountFor(s) > count && !HasClientFilters)
                        {
                            <div class="atm-col__note">@BoardTop(s) موردِ آخر نمایش داده شده — برای همه، نمای فهرست را باز کنید.</div>
                        }
                    </div>
                }
            </ChildContent>
            <ItemRenderer>
                <TaskCard Item="context" Compact="true" Busy="_busy.Contains(context.IDNUM)"
                          Now="_now" StaleDays="StaleDays" DocTypes="_docTypes"
                          OnOpen="OpenTask" OnEvents="t2 => ShowEventsDialog(t2.IDNUM)"
                          OnToggleDone="ToggleDoneAsync" OnTogglePriority="TogglePriorityAsync"
                          OnSetStatus="x => SetStatusAsync(x.Item, x.Status)" />
            </ItemRenderer>
        </MudDropContainer>
    }

    @* ═════════════ نوار انتخاب گروهی ═════════════ *@
    @if (_selected.Count > 0 && _view == View.List)
    {
        <div class="atm-bulkbar">
            <b>@_selected.Count مورد انتخاب شد</b>
            <button type="button" class="atm-btn atm-btn--light" style="height:38px" @onclick="ShowBulkUpdateDialog"><i class="bi bi-pencil-square"></i>ویرایش گروهی</button>
            <button type="button" class="atm-btn atm-btn--glass" style="height:38px" @onclick="ClearSelection"><i class="bi bi-x-lg"></i>لغو انتخاب</button>
        </div>
    }

    @if (_guideOpen)
    {
        @* فیلمِ آموزشی — ساخته‌شده از docs/guides/automation-video (README همان‌جا) *@
        <div class="atm-guide" @onclick="() => _guideOpen = false">
            <div class="atm-guide__box" @onclick:stopPropagation="true" role="dialog" aria-label="آموزش کارتابل اتوماسیون">
                <header>
                    <span class="gl"><i class="bi bi-play-circle-fill"></i></span>
                    <b>آموزش کارتابل اتوماسیون</b>
                    <small>یک دقیقه — همه‌ی امکانات</small>
                    <span style="flex:1"></span>
                    <button type="button" class="atm-icon-btn" title="بستن (Esc)" @onclick="() => _guideOpen = false"><i class="bi bi-x-lg"></i></button>
                </header>
                <video src="media/automation-guide.mp4" poster="media/automation-guide.jpg" controls autoplay playsinline preload="metadata"></video>
            </div>
        </div>
    }

    <ChatWindow @ref="_chat" CurrentUserId="Userid" CurrentUserName="@UserNameDisplay" Personel="_personel"
                DefaultCustomer="_defaultCustomer" OnChanged="OnChatChanged" />

    <TaskComposer @ref="_composer" Personel="_personel" CurrentUserId="Userid" DefaultCustomer="_defaultCustomer"
                  DocTypes="_docTypes" OnSaved="OnComposerSaved" OnShowEvents="ShowEventsDialog" />
</div>

@code {
    private enum View { List, Board }
    private enum Sort { Smart, Newest, Oldest, Number }
    private enum Kpi { None, Open, Urgent, Stale, Done, Cancelled }

    private const int StaleDaysDefault = 30;
    private int StaleDays => _summary?.StaleDays > 0 ? _summary.StaleDays : StaleDaysDefault;

    private static readonly (int Status, string Label, string Color)[] StatusTabs =
    {
        (1, "انجام نشده", "var(--atm-primary)"),
        (2, "انجام شده", "var(--atm-done)"),
        (3, "لغو شده", "var(--atm-cancel)"),
        (0, "همه", "var(--atm-muted)")
    };

    // ── کاربر ──
    private int Userid;
    private string UserNameDisplay = "";
    private string UserHES = "";
    private bool _ready;

    // ── داده ──
    private List<PersonelLookupModel> _personel = new();
    private List<PersonelLookupModel> _subordinates = new();
    private List<DocumentTypeLookupModel> _docTypes = new();
    private LookupDto<string>? _defaultCustomer;
    private bool _canFilterByUser;
    private TaskSummaryModel? _summary;
    private List<TaskModel> _tasks = new();
    private List<TaskModel> _visible = new();
    private Dictionary<long, int> _indexOf = new();
    private int _unreadMessageCount;
    private int _activeReminderCount;

    // ── فیلتر و نما ──
    private View _view = View.List;
    private Sort _sort = Sort.Smart;
    private int _status = 1;
    private int? _userId;
    // int? و نه int: کدِ «سند حسابداری» صفر است و با مقدارِ پیش‌فرضِ int قاطی می‌شد.
    private IEnumerable<int?> _docFilter = new HashSet<int?>();
    private string _search = "";
    private bool _urgentOnly;
    private bool _staleOnly;

    // ── وضعیت رابط ──
    private bool _loading;
    private bool _loadedOnce;
    private int _loadVersion;
    private DateTime _now = DateTime.Now;
    private readonly HashSet<long> _selected = new();
    private readonly HashSet<long> _busy = new();
    private readonly HashSet<long> _leaving = new();

    private TaskComposer? _composer;
    private ChatWindow? _chat;
    private bool _guideOpen;
    private MudDropContainer<TaskModel>? _drop;
    private System.Threading.Timer? _timer;
    private DotNetObjectReference<TasksDashboard>? _selfRef;

    private bool IsOwnInbox => _userId is null || _userId == Userid;
    private string TaskTypesParam => _docFilter.Any(d => d.HasValue) ? string.Join(",", _docFilter.Where(d => d.HasValue)) : "1000";
    private bool HasClientFilters => !string.IsNullOrWhiteSpace(_search) || _urgentOnly || _staleOnly;

    // ─────────────────────────── راه‌اندازی ───────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await ConnectionManager.LoadSettingsAsync();
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            Snackbar.Add("کاربر احراز هویت نشده است.", Severity.Warning);
            return;
        }

        if (!int.TryParse(user.FindFirst(BaseknowClaimTypes.IDD)?.Value, out Userid) || Userid == 0)
        {
            Snackbar.Add("اطلاعات کاربر برای بارگذاری کارتابل ناقص یا نامعتبر است.", Severity.Error, c => c.RequireInteraction = true);
            return;
        }
        UserNameDisplay = user.FindFirst(BaseknowClaimTypes.UUSER)?.Value ?? "";
        UserHES = user.FindFirst(BaseknowClaimTypes.USER_HES)?.Value ?? "";
        _userId = Userid;
        _view = await LoadViewPreferenceAsync();

        try
        {
            _canFilterByUser = await AutomationService.CanViewSubordinateTasksAsync();
            var personelTask = AutomationService.GetPersonelLookupAsync();
            var subsTask = _canFilterByUser ? LookupService.GetSubordinatesAsync() : Task.FromResult<List<PersonelLookupModel>?>(new());
            var docTask = AutomationService.GetDocumentTypeLookupAsync();
            var custTask = string.IsNullOrWhiteSpace(UserHES) ? Task.FromResult<List<LookupDto<string>>?>(null) : LookupService.GetCustomerLookupAsync(UserHES);
            await Task.WhenAll(personelTask, subsTask, docTask, custTask);

            _personel = (await personelTask)?.OrderBy(p => p.USERCO == Userid ? 0 : 1).ThenBy(p => p.SAL_NAME).ToList() ?? new();
            _subordinates = (await subsTask)?.Where(p => p.USERCO != Userid).ToList() ?? new();
            _docTypes = (await docTask)?.ToList() ?? new();
            if (!string.IsNullOrWhiteSpace(UserHES))
            {
                _defaultCustomer = (await custTask)?.FirstOrDefault(c => c.Id == UserHES)
                                   ?? new LookupDto<string>(UserHES, $"حساب پیش‌فرض ({UserHES})");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"خطا در بارگذاری فهرست‌های پایه: {ex.Message}", Severity.Error);
        }

        _ready = true;
        await ReloadAsync();
        await LoadNotificationCountsAsync();

        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                _now = DateTime.Now;
                await LoadNotificationCountsAsync();
                StateHasChanged();
            });
        }, null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("atmKeys.attach", _selfRef); } catch { /* میان‌بُرها اختیاری‌اند */ }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        try { await JS.InvokeVoidAsync("atmKeys.detach"); } catch { }
        _selfRef?.Dispose();
    }

    // ─────────────────────────── بارگذاری ───────────────────────────

    private async Task ReloadAsync(bool withSummary = true)
    {
        if (!_ready) return;
        var version = ++_loadVersion;
        _loading = true;
        StateHasChanged();

        var user = _userId ?? Userid;
        var types = TaskTypesParam;
        var summaryTask = withSummary ? AutomationService.GetTaskSummaryAsync(user, types) : null;

        List<TaskModel>? loaded;
        if (_view == View.List)
        {
            loaded = (await AutomationService.GetTasksAsync(_status, user, types))?.ToList();
        }
        else
        {
            var open = AutomationService.GetTasksAsync(1, user, types);
            var done = AutomationService.GetTasksAsync(2, user, types, BoardTop(2));
            var canc = AutomationService.GetTasksAsync(3, user, types, BoardTop(3));
            await Task.WhenAll(open, done, canc);
            loaded = open.Result is null || done.Result is null || canc.Result is null
                ? null
                : open.Result.Concat(done.Result).Concat(canc.Result).ToList();
        }
        var summary = summaryTask is null ? _summary : await summaryTask;

        if (version != _loadVersion) return; // درخواستِ تازه‌تری در راه است

        if (loaded is null) Snackbar.Add("فهرست وظایف دریافت نشد. اتصال به سرور را بررسی کنید.", Severity.Error);
        _tasks = loaded ?? new();
        _summary = summary;
        _now = DateTime.Now;
        _selected.IntersectWith(_tasks.Select(t => t.IDNUM));
        Recompute();
        _loading = false;
        _loadedOnce = true;
        StateHasChanged();
        _drop?.Refresh();
    }

    private async Task RefreshSummaryAsync()
    {
        var s = await AutomationService.GetTaskSummaryAsync(_userId ?? Userid, TaskTypesParam);
        if (s is not null) { _summary = s; StateHasChanged(); }
    }

    private async Task LoadNotificationCountsAsync()
    {
        try
        {
            var m = AutomationService.GetUnreadMessageCountAsync();
            var r = AutomationService.GetActiveReminderCountAsync();
            await Task.WhenAll(m, r);
            _unreadMessageCount = m.Result;
            _activeReminderCount = r.Result;
        }
        catch { /* شمارنده‌ها اختیاری‌اند؛ خطا نباید صفحه را بشکند */ }
    }

    private static int BoardTop(int status) => status == 2 ? 60 : 30;

    // بُرد بدون Virtualize است؛ صدها کارت با منوی هرکدام مرورگر را کُند می‌کند.
    // پس هر ستون اول BoardPage کارت را نشان می‌دهد و بقیه با «نمایش بیشتر».
    private const int BoardPage = 60;
    private readonly Dictionary<int, int> _boardShow = new() { [1] = BoardPage, [2] = BoardPage, [3] = BoardPage };
    private Dictionary<int, int> _boardTotal = new();

    private void ShowMoreInColumn(int status)
    {
        _boardShow[status] = _boardShow.GetValueOrDefault(status, BoardPage) + BoardPage;
        Recompute();
        _drop?.Refresh();
    }

    // ─────────────────────────── فیلتر و مرتب‌سازی (سمت مرورگر) ───────────────────────────

    private void Recompute()
    {
        IEnumerable<TaskModel> q = _tasks;
        if (_urgentOnly) q = q.Where(t => t.PERIORITY == 1);
        if (_staleOnly) q = q.Where(t => t.STATUS == 1 && AutomationUi.AgeDays(t, _now) >= StaleDays);

        var terms = Normalize(_search).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (terms.Length > 0)
        {
            q = q.Where(t =>
            {
                var hay = Normalize($"{t.TASK} {t.NAME} {t.COMP_COD} {t.IDNUM} {t.num} {t.USERNAME}");
                return terms.All(hay.Contains);
            });
        }

        q = _sort switch
        {
            Sort.Newest => q.OrderByDescending(t => AutomationUi.At(t.STDATE, t.STTIME)).ThenByDescending(t => t.IDNUM),
            Sort.Oldest => q.OrderBy(t => AutomationUi.At(t.STDATE, t.STTIME)).ThenBy(t => t.IDNUM),
            Sort.Number => q.OrderByDescending(t => t.IDNUM),
            // هوشمند: کارهای بازِ فوری بالا، بعد جدیدترین‌ها
            _ => q.OrderBy(t => t.STATUS == 1 && t.PERIORITY == 1 ? 0 : 1).ThenByDescending(t => t.IDNUM)
        };

        _visible = q.ToList();
        if (_view == View.Board)
        {
            _boardTotal = _visible.GroupBy(t => t.STATUS).ToDictionary(g => g.Key, g => g.Count());
            _visible = _visible.GroupBy(t => t.STATUS)
                               .SelectMany(g => g.Take(_boardShow.GetValueOrDefault(g.Key, BoardPage)))
                               .ToList();
        }
        _indexOf = new Dictionary<long, int>(Math.Min(_visible.Count, 16));
        for (int i = 0; i < Math.Min(_visible.Count, 14); i++) _indexOf[_visible[i].IDNUM] = i;
    }

    private int IndexOf(TaskModel t) => _indexOf.TryGetValue(t.IDNUM, out var i) ? i : -1;

    /// <summary>ی/ک عربی و فارسی یکی، نیم‌فاصله = فاصله — تا جستجو به صفحه‌کلید حساس نباشد.</summary>
    private static string Normalize(string? s) => (s ?? "")
        .Replace('ي', 'ی').Replace('ك', 'ک').Replace('‌', ' ').Replace('ة', 'ه')
        .ToLowerInvariant();

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        Recompute();
    }

    private void ToggleUrgentOnly() { _urgentOnly = !_urgentOnly; Recompute(); _drop?.Refresh(); }
    private void ClearStale() { _staleOnly = false; Recompute(); }

    private void ClearFilters()
    {
        _search = "";
        _urgentOnly = false;
        _staleOnly = false;
        Recompute();
        _drop?.Refresh();
    }

