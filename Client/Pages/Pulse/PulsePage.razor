@page "/pulse"
@using Microsoft.AspNetCore.Authorization
@using Safir.Shared.Models.Pulse
@implements IAsyncDisposable
@inject PulseApiService Api
@inject IJSRuntime JS

@attribute [Authorize]

@* «نبض سازمان» — جای پنجره‌های NABZEFROOSH، NABZEDARY و NABZEMALI ِ WPF.
   خودِ داشبورد یک برنامه‌ی React + Motion است (سورس: پوشه‌ی Pulse/ در ریشه‌ی مخزن)
   که فقط همین صفحه با import() بارش می‌کند؛ Blazor داده را می‌آورد و به آن می‌دهد. *@

<PageTitle>نبض سازمان</PageTitle>

<div class="atm">
@if (_error is not null)
{
    <div class="atm-empty pulse-msg">
        <i class="bi bi-heart-pulse" style="font-size:2.6rem;opacity:.5"></i>
        <h3>@_error</h3>
    </div>
}
else if (!_mounted)
{
    <div style="display:flex;flex-direction:column;gap:18px">
        <div class="atm-skel" style="height:118px;border-radius:26px"></div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px">
            @for (int i = 0; i < 6; i++) { <div class="atm-skel" style="height:150px;border-radius:20px"></div> }
        </div>
        <div class="atm-skel" style="height:380px;border-radius:22px"></div>
    </div>
}

@* React این عنصر را در اختیار می‌گیرد؛ Blazor هیچ‌وقت بچه‌ای در آن نمی‌سازد و خودش هم همیشه رندر می‌شود *@
<div class="pulse-host" @ref="_host"></div>
</div>

@code {
    /// <summary>با هر تغییرِ خروجیِ Pulse/ (npm run build) بالا برود تا مرورگر نسخه‌ی تازه را بگیرد.</summary>
    private const string Bundle = "./js/pulse/pulse.js?v=14050711-1";

    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PulsePage>? _self;
    private string? _error;
    private bool _mounted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var (data, err) = await Api.LoadAsync();
        if (data is null)
        {
            _error = err ?? "داده‌ی نبض سازمان خوانده نشد.";
            StateHasChanged();
            return;
        }
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", Bundle);
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("mount", _host, data, _self);
            _mounted = true;
            _error = null;
        }
        catch (JSException ex)
        {
            _error = "نمایشِ نمودارها ممکن نشد: " + ex.Message;
        }
        StateHasChanged();
    }

    /// <summary>دکمه‌ی «به‌روزرسانی» در خودِ داشبورد.</summary>
    [JSInvokable]
    public Task Refresh() => LoadAsync();

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unmount", _host);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
