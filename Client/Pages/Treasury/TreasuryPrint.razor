@page "/treasury/{Id:int}/print/{Kind}"
@layout EmptyLayout
@using Microsoft.AspNetCore.Authorization
@using Safir.Shared.Models.Treasury
@using Safir.Client.Components.Treasury
@inject TreasuryApiService Api
@inject IJSRuntime JS
@attribute [Authorize]

@*
    چاپ‌های خزانه — Command12 «چاپ عملکرد خزانه» (KHAZANE_AMALKARD.mrt)، Command23 «سند دریافت»
    (SANAD_DARYAFT.mrt روی sanaddar_sub) و Command24 «سند پرداخت» (SANAD_PARDAKHT.mrt روی sanadpar_sub).
    صفحه‌ی A4 و تصویرِ امضاها (SALA_DTL.EMZA) مثل گزارش‌های WPF.
*@
<PageTitle>@(_doc?.Title ?? "چاپ خزانه") @Id</PageTitle>

<div class="trs-print-page">
    <div class="trs-print-tools">
        <button type="button" onclick="window.print()"><i class="bi bi-printer"></i> چاپ</button>
        <button type="button" onclick="window.close()"><i class="bi bi-x-lg"></i> بستن</button>
        <span>@(_doc?.Title) — خزانه‌ی @Id</span>
    </div>

    @if (_error is not null)
    {
        <div class="trs-print-error"><i class="bi bi-exclamation-triangle"></i> @_error</div>
    }
    else if (_doc is null)
    {
        <div class="trs-print-error">در حال آماده‌سازی…</div>
    }
    else
    {
        var d = _doc;
        <article class="trs-sheet">
            <header class="trs-sheet__head">
                <div class="co">
                    <b>@d.CompanyName</b>
                    @if (!string.IsNullOrWhiteSpace(d.FiscalYear)) { <small>@d.FiscalYear</small> }
                </div>
                <div class="ttl">
                    <h1>@d.Title</h1>
                    @if (!string.IsNullOrWhiteSpace(d.Molah)) { <small>@d.Molah</small> }
                </div>
                <dl class="meta">
                    <div><dt>شماره</dt><dd>@d.Id</dd></div>
                    <div><dt>تاریخ</dt><dd><bdi>@ChequeForm.FormatDate(d.Date)</bdi></dd></div>
                    @if (d.Ns is > 0) { <div><dt>سند</dt><dd>@d.Ns @(d.SanadBase is > 0 ? $"(مبنا {d.SanadBase})" : "")</dd></div> }
                    @if (d.Idk is > 0) { <div><dt>شماره برگه</dt><dd>@d.Idk</dd></div> }
                </dl>
            </header>

            @if (d.Rows.Count == 0)
            {
                <p class="trs-sheet__empty">@(d.Kind == "amalkard" ? "این خزانه سطری ندارد." : "این خزانه سطرِ چکی برای این سند ندارد.")</p>
            }
            else if (d.Kind == "amalkard")
            {
                <table class="trs-sheet__tbl">
                    <thead><tr><th>ردیف</th><th>نوع عملیات</th><th>نحوه</th><th>به حساب</th><th>از حساب</th><th>شرح</th><th class="n">مبلغ</th></tr></thead>
                    <tbody>
                        @{ int i = 0; }
                        @foreach (var r in d.Rows)
                        {
                            i++;
                            <tr>
                                <td class="c">@i</td><td>@r.Operation</td><td>@r.Method</td>
                                <td>@r.ToName<small><bdi>@r.ToHes</bdi></small></td>
                                <td>@r.FromName<small><bdi>@r.FromHes</bdi></small></td>
                                <td class="sh">@r.Sharh</td>
                                <td class="n">@AccountPicker.Money(r.Mabl)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><td colspan="6">جمع کل</td><td class="n">@AccountPicker.Money(d.Total)</td></tr></tfoot>
                </table>
            }
            else
            {
                <table class="trs-sheet__tbl">
                    <thead><tr><th>ردیف</th><th>شماره چک</th><th>جاری</th><th>تاریخ چک</th><th>نام بانک</th><th>شعبه</th><th>از</th><th class="n">مبلغ</th></tr></thead>
                    <tbody>
                        @{ int i = 0; }
                        @foreach (var r in d.Rows)
                        {
                            i++;
                            <tr>
                                <td class="c">@i</td>
                                <td><bdi>@(r.NSeri?.ToString("0") ?? "")</bdi></td>
                                <td><bdi>@r.NHesab</bdi></td>
                                <td><bdi>@(r.DateS is > 0 ? ChequeForm.FormatDate(r.DateS.Value) : "")</bdi></td>
                                <td>@r.BankName</td><td>@r.Shobeh</td><td>@r.FromName</td>
                                <td class="n">@AccountPicker.Money(r.Mabl)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><td colspan="7">جمع کل</td><td class="n">@AccountPicker.Money(d.Total)</td></tr></tfoot>
                </table>
            }

            @if (!string.IsNullOrWhiteSpace(d.TotalInWords))
            {
                <p class="trs-sheet__words"><b>جمع کل به حروف:</b> @d.TotalInWords</p>
            }

            <footer class="trs-sheet__signs">
                @foreach (var s in d.Signers)
                {
                    <div class="sg" @key="s.Slot">
                        <small>@s.Title</small>
                        @if (_signs.TryGetValue(s.Slot, out var src))
                        {
                            <img src="@src" alt="امضا" />
                        }
                        else
                        {
                            <span class="ph"></span>
                        }
                        <b>@s.Name</b>
                    </div>
                }
                @if (d.Signers.Count == 0)
                {
                    <div class="sg"><small>تنظیم کننده</small><span class="ph"></span></div>
                    <div class="sg"><small>مدیر مالی</small><span class="ph"></span></div>
                    <div class="sg"><small>مدیر عامل</small><span class="ph"></span></div>
                }
            </footer>
            <div class="trs-sheet__foot">کاربر: @d.UserName · تاریخ چاپ: <bdi>@ChequeForm.FormatDate(d.PrintedOn)</bdi></div>
        </article>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    /// <summary>amalkard | daryaft | pardakht</summary>
    [Parameter] public string Kind { get; set; } = "amalkard";

    private TreasuryPrintDto? _doc;
    private string? _error;
    private readonly Dictionary<int, string> _signs = new();
    private bool _printed;

    protected override async Task OnParametersSetAsync()
    {
        var (doc, err) = await Api.PrintAsync(Id, Kind);
        _doc = doc;
        _error = err;
        if (doc is null) return;
        foreach (var s in doc.Signers.Where(s => s.HasImage))
        {
            var bytes = await Api.SignatureAsync(Id, s.Slot);
            if (bytes is { Length: > 0 })
            {
                var mime = bytes[0] == 0x89 ? "image/png" : bytes[0] == 0x42 ? "image/bmp" : "image/jpeg";
                _signs[s.Slot] = $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_doc is not null && !_printed)
        {
            _printed = true;
            await Task.Delay(300); // فونت و تصویرِ امضاها
            try { await JS.InvokeVoidAsync("print"); } catch { }
        }
    }
}
