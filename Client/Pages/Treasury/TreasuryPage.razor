    // ─────────────────────────── امضا، ارجاع، چاپ ───────────────────────────

    private bool PrintBlocked => _meta?.PrintNeedsSignature == true && _detail?.Header.Signed != true;

    private async Task SignAsync((int Slot, bool On) a)
    {
        if (_detail is null || _busy) return;
        _busy = true;
        var r = await Api.SignAsync(_detail.Header.Id, a.Slot, a.On);
        _busy = false;
        if (!r.Ok) { Snackbar.Add(r.Error ?? "امضا ثبت نشد.", Severity.Error); return; }
        Snackbar.Add(a.On ? "امضا شد؛ خزانه قفل شد." : "امضا برداشته شد.", a.On ? Severity.Success : Severity.Info);
        await LoadDetailAsync(_detail.Header.Id);
    }

    private async Task ReferAsync(int personel)
    {
        if (_detail is null || _busy) return;
        _busy = true;
        var r = await Api.ReferAsync(_detail.Header.Id, personel);
        _busy = false;
        if (!r.Ok) { Snackbar.Add(r.Error ?? "ارجاع ثبت نشد.", Severity.Error); return; }
        Snackbar.Add(r.Info ?? "ارجاع داده شد.", Severity.Success);
        await LoadDetailAsync(_detail.Header.Id);
    }

    private async Task PrintAsync(string kind)
    {
        _printOpen = false;
        if (_detail is null) return;
        await JS.InvokeVoidAsync("open", $"/treasury/{_detail.Header.Id}/print/{kind}", "_blank");
    }

    private async Task ExcelAsync()
    {
        if (_detail is null) return;
        var (bytes, err) = await Api.ExcelAsync(_detail.Header.Id);
        if (bytes is null) { Snackbar.Add(err ?? "خروجی اکسل تهیه نشد.", Severity.Error); return; }
        await JS.InvokeVoidAsync("downloadFileFromBytes", $"خزانه-{_detail.Header.Id}.xlsx", bytes);
    }

    // ─────────────────────────── کپی و جای‌گذاری ───────────────────────────

    private async Task RefreshClipAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", ClipKey);
            _clipCount = string.IsNullOrEmpty(raw) ? 0 : (JsonSerializer.Deserialize<List<ClipRow>>(raw)?.Count ?? 0);
        }
        catch { _clipCount = 0; }
        StateHasChanged();
    }

    private async Task CopyRowsAsync()
    {
        if (_detail is null) return;
        var rows = _detail.Rows.Where(r => !TreasuryMethod.IsCheque(r.Nahva))
            .Select(r => new ClipRow { NoAm = r.NoAm, Nahva = r.Nahva, Fhes = r.Fhes, Thes = r.Thes, Sharh = r.Sharh, Mabl = r.Mabl, MhazNo = r.MhazNo })
            .ToList();
        var skipped = _detail.Rows.Count - rows.Count;
        try { await JS.InvokeVoidAsync("localStorage.setItem", ClipKey, JsonSerializer.Serialize(rows)); } catch { }
        _clipCount = rows.Count;
        Snackbar.Add($"{rows.Count} سطر کپی شد" + (skipped > 0 ? $"؛ {skipped} سطرِ چکی کپی نمی‌شود (هر چک یکتاست)." : "."), Severity.Info);
    }

    private async Task PasteRowsAsync()
    {
        if (_detail is null || _busy) return;
        List<ClipRow>? rows = null;
        try { rows = JsonSerializer.Deserialize<List<ClipRow>>(await JS.InvokeAsync<string?>("localStorage.getItem", ClipKey) ?? "[]"); } catch { }
        if (rows is not { Count: > 0 }) { _clipCount = 0; return; }
        _busy = true;
        int ok = 0;
        var errors = new List<string>();
        foreach (var c in rows)
        {
            var r = await Api.AddRowAsync(_detail.Header.Id, new TreasuryRowSaveRequest
            {
                NoAm = c.NoAm, Nahva = c.Nahva, Fhes = c.Fhes, Thes = c.Thes, Sharh = c.Sharh, Mabl = c.Mabl, MhazNo = c.MhazNo
            });
            if (r.Ok) ok++; else errors.Add(r.Error ?? "خطا");
        }
        _busy = false;
        await LoadDetailAsync(_detail.Header.Id);
        Snackbar.Add($"{ok} سطر جای‌گذاری شد" + (errors.Count > 0 ? $"؛ {errors.Count} سطر نشد: {errors[0]}" : "."), errors.Count > 0 ? Severity.Warning : Severity.Success);
        _ = LoadCashAsync();
    }

    // ─────────────────────────── ضمیمه ───────────────────────────

    private async Task AttachmentAsync(TreasuryRowDto r)
    {
        if (_detail is null) return;
        var parameters = new DialogParameters
        {
            ["Id"] = _detail.Header.Id, ["Idh"] = r.Idh, ["Radif"] = r.Radif?.ToString("0"), ["HasAttachment"] = r.HasAttachment,
            ["CanEdit"] = _meta?.CanCreate == true || _meta?.CanUpdate == true,
            ["CanDelete"] = _meta?.CanDelete == true || _meta?.CanUpdate == true
        };
        var dialog = DialogService.Show<RowAttachmentDialog>("تصویر سطر", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = false });
        var res = await dialog.Result;
        if (!res.Canceled && res.Data is true) await LoadDetailAsync(_detail.Header.Id);
    }

    /// <summary>
    /// فرمِ سطر — برای سطرِ تازه پایینِ جدول، و برای اصلاح درست زیرِ همان سطر تا جلوی چشمِ کاربر باز شود.
    /// </summary>
    private RenderFragment EntryPanel() => __builder =>
    {
        var auto = AutoSides;
        var picks = TreasuryMethod.PicksCheque(_e.Method);
        var newChq = _e.Method == TreasuryMethod.Cheque;
        <div class="trs-entry @(_rowEditIdh is not null ? "is-editing trs-entry--inline" : "")" @ref="_entryRef">
            <div class="trs-entry__title">
                <i class="bi @(_rowEditIdh is null ? "bi-plus-circle-fill" : "bi-pencil-square")"></i>
                @(_rowEditIdh is null ? "سطر جدید" : $"ویرایشِ سطرِ {_editRadif}")
                <small>Enter در شرح یا مبلغ = ثبت · Esc = انصراف</small>
            </div>
            <div class="trs-entry__ops">
                <div class="trs-seg2">
                    <button type="button" class="rec @(_e.NoAm == 1 ? "is-on" : "")" @onclick="() => SetOp(1)" disabled="@LockKind"><i class="bi bi-arrow-down-left"></i>دریافت</button>
                    <button type="button" class="pay @(_e.NoAm == 2 ? "is-on" : "")" @onclick="() => SetOp(2)" disabled="@LockKind"><i class="bi bi-arrow-up-right"></i>پرداخت</button>
                </div>
                <div class="trs-seg2 trs-seg2--methods">
                    @foreach (var (m, label, icon) in MethodButtons)
                    {
                        if (m == TreasuryMethod.ChequeAssign && _e.NoAm == TreasuryOp.Receipt) continue;
                        <button type="button" class="@(_e.Method == m ? "is-on" : "")" @onclick="() => SetMethod(m)" disabled="@LockKind"><i class="bi @icon"></i>@label</button>
                    }
                </div>
                @if (newChq)
                {
                    <label class="trs-check" title="چکِ غیرتجاری (ضمانت) — حساب‌های ADV/APV">
                        <input type="checkbox" checked="@_e.NonTrade" @onchange="e => { _e.NonTrade = (bool)(e.Value ?? false); ApplyAuto(); }" disabled="@LockKind" />
                        <span>غیرتجاری</span>
                    </label>
                }
            </div>
            @if (LockKind)
            {
                <div class="trs-entry__note"><i class="bi bi-lock-fill"></i>چکِ این سطر وصول، واگذار یا برگشت شده؛ نوع و نحوه‌ی سطر دیگر عوض نمی‌شود (سطر هم حذف نمی‌شود).</div>
            }
            else if (KindChanging)
            {
                <div class="trs-entry__note is-warn">
                    <i class="bi bi-arrow-repeat"></i>
                    <span>نوعِ سطر عوض می‌شود: با ذخیره، چکِ قبلیِ این سطر @(_e.Current is { } oc ? $"(سریال {oc.NSeri:0})" : "") همان‌طور برمی‌گردد که با حذفِ سطر،
                        و سطر با نوعِ تازه در همان ردیف ثبت می‌شود.</span>
                </div>
            }

            @if (picks)
            {
                <div class="trs-entry__pick">
                    <label class="trs-entry__lbl"><i class="bi bi-search"></i>@PickTitle</label>
                    @* کلید: با عوض شدنِ نوع یا سطر، فهرست و حالتِ باز/بسته‌اش از نو *@
                    <ChequePicker @key="@($"{PickMode}:{_rowEditIdh}")" Mode="@PickMode" Selected="_e.Picked" SelectedChanged="OnPicked"
                                  Current="@(SameKind ? _e.Current : null)" />
                </div>
            }

            <div class="trs-entry__grid">
                <AccountPicker Label="از حساب" Value="@_e.Fhes" Name="@_e.FhesName" OnChange="OnFromChanged"
                               Disabled="@auto.From" AutoHint="@AutoHint(true)" />
                <AccountPicker Label="به حساب" Value="@_e.Thes" Name="@_e.ThesName" OnChange="OnToChanged"
                               Disabled="@auto.To" AutoHint="@AutoHint(false)" />
                @if (_e.Method is TreasuryMethod.Cash or TreasuryMethod.Other)
                {
                    @* Enter/Esc فقط روی شرح و مبلغ — در انتخابگرِ حساب، Enter یعنی انتخابِ حساب نه ثبتِ سطر *@
                    <div class="trs-f trs-f--wide" @onkeydown="OnEntryKey">
                        <label>شرح</label>
                        <input class="atm-input" maxlength="255" placeholder="مثلاً: بابت فاکتور ۱۲۳۴" @bind="_e.Sharh" @bind:event="oninput" />
                    </div>
                }
                @if (!picks)
                {
                    <div class="trs-f" @onkeydown="OnEntryKey">
                        <label>مبلغ (ریال) <span class="req">*</span> @(newChq && _e.Chq.Group && _rowEditIdh is null ? "— هر فقره" : "")</label>
                        @* Pay2NumericInput تا فوکوس دارد مقدارِ تازه‌ی والد را نمی‌پذیرد؛ با کلیدِ تازه بعد از ثبت/ویرایش از نو ساخته می‌شود *@
                        <Pay2NumericInput @key="_entryKey" @bind-Value="_e.Mabl" IsDigitGroupActive="true" ThreeTwoZero="true"
                                          MaxLength="20" Direction="ltr" CssClass="trs-amount" />
                        @if (ParseMoney(_e.Mabl) is > 0 and var m)
                        {
                            <small class="trs-words">@Money(m) ریال</small>
                        }
                    </div>
                }
                else
                {
                    <div class="trs-f">
                        <label>مبلغ (از چک)</label>
                        <div class="trs-ro trs-ro--amt">@(_e.Picked is { } pk ? Money(pk.Mabl) : "—")</div>
                    </div>
                }
                @if (_e.Method == TreasuryMethod.ChequeAssign || (_e.Method == TreasuryMethod.ChequeReturn && _e.NoAm == TreasuryOp.Payment))
                {
                    <div class="trs-f">
                        <label>موقعیت چک</label>
                        <select class="atm-input" @bind="_e.Sandugh">
                            <option value="">—</option>
                            @foreach (var f in _meta!.ChequeFunds) { <option value="@f.Id">@f.Name</option> }
                        </select>
                    </div>
                }
                @if (_e.Method == TreasuryMethod.ChequeReturn)
                {
                    <div class="trs-f">
                        <label>وضعیتِ چک <span class="req">*</span></label>
                        <select class="atm-input" @bind="_e.Vaz">
                            <option value="">—</option>
                            @foreach (var (vid, vname) in _e.NoAm == TreasuryOp.Payment ? TreasuryChequeState.Received : TreasuryChequeState.PaidReturn)
                            {
                                <option value="@vid">@vname</option>
                            }
                        </select>
                    </div>
                }
                @if (_meta?.MarkazEnabled == true)
                {
                    <div class="trs-f">
                        <label>مرکز هزینه</label>
                        <select class="atm-input" @bind="_e.MhazNo">
                            <option value="">—</option>
                            @foreach (var c in _meta.CostCenters) { <option value="@c.Id">@c.Name</option> }
                        </select>
                    </div>
                }
            </div>

            @if (newChq)
            {
                <ChequeFields Form="_e.Chq" Meta="_meta!" Receive="@(_e.NoAm == TreasuryOp.Receipt)" AllowGroup="@(_rowEditIdh is null)"
                              LockAssign="@(SameKind && _e.Current?.InCirculation(_meta!.Bankha) == true)" />
            }
            @if (TreasuryMethod.IsCheque(_e.Nahva))
            {
                <div class="trs-entry__hint"><i class="bi bi-magic"></i>شرحِ سطر از روی مشخصاتِ چک ساخته می‌شود (مثل نرم‌افزار ویندوزی).</div>
            }

            <div class="trs-entry__foot">
                @if (_rowEditIdh is not null)
                {
                    <button type="button" class="atm-btn atm-btn--ghost" @onclick="ResetEntry" disabled="@_busy">انصراف</button>
                }
                <span style="flex:1"></span>
                <button type="button" class="atm-btn atm-btn--primary" @onclick="SaveRowAsync" disabled="@_busy">
                    @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="width:18px;height:18px;color:#fff" /> }
                    else { <i class="bi bi-check2"></i> }
                    @(_rowEditIdh is null ? (newChq && _e.Chq.Group ? $"ثبت {_e.Chq.Count} فقره" : "ثبت سطر") : "ذخیره‌ی تغییرات")
                </button>
            </div>
        </div>
    };

    // ─────────────────────────── سطرها ───────────────────────────

    /// <summary>کدام سمت خودکار است — NAHVA_AfterUpdate در WPF.</summary>
    private (bool From, bool To) AutoSides => (_e.NoAm, _e.Method) switch
    {
        (TreasuryOp.Receipt, TreasuryMethod.Cash or TreasuryMethod.Cheque or TreasuryMethod.ChequeReturn) => (false, true),
        (TreasuryOp.Payment, TreasuryMethod.Cash or TreasuryMethod.Cheque or TreasuryMethod.ChequeAssign or TreasuryMethod.ChequeReturn) => (true, false),
        _ => (false, false)
    };

    /// <summary>
    /// نوع و نحوه فقط وقتی قفل‌اند که چکِ دریافتی/پرداختیِ خودِ سطر دیگر دستِ ما نیست (همان قاعده‌ی حذفِ سطر).
    /// بر اساسِ سطرِ ذخیره‌شده، نه انتخابِ فعلیِ فرم — وگرنه زدنِ «چک» روی سطرِ نقد همه‌ی دکمه‌ها را قفل می‌کرد.
    /// </summary>
    private bool LockKind => _editOrig is { } o && TreasuryMethod.IsNewCheque(o.Nahva) && _e.Current?.InCirculation(_meta?.Bankha) == true;

    /// <summary>فرم هنوز همان چک و همان نقشِ سطرِ ذخیره‌شده را دارد (یا سطرِ تازه است).</summary>
    private bool SameKind => _editOrig is not { } o || TreasuryMethod.SameChequeRole(o.NoAm, o.Nahva, _e.NoAm, _e.Nahva);

    /// <summary>سطرِ چکی به نوعِ دیگری می‌رود — چکِ قبلی با ذخیره آزاد می‌شود.</summary>
    private bool KindChanging => _editOrig is not null && !SameKind;

    private string PickMode => (_e.NoAm, _e.Method) switch
    {
        (TreasuryOp.Payment, TreasuryMethod.ChequeAssign) => "assign",
        (TreasuryOp.Payment, TreasuryMethod.ChequeReturn) => "return-received",
        _ => "return-paid"
    };

    private string PickTitle => PickMode switch
    {
        "assign" => "کدام چکِ دریافتی واگذار می‌شود؟",
        "return-received" => "کدام چکِ دریافتی به صاحبش برمی‌گردد؟",
        _ => "کدام چکِ پرداختیِ ما برگشت خورده؟"
    };

    private string AutoHint(bool from) => (_e.NoAm, _e.Method) switch
    {
        (_, TreasuryMethod.Cash) => from ? "در پرداختِ نقد، از حسابِ صندوق خودکار است" : "در دریافتِ نقد، به حسابِ صندوق خودکار است",
        (TreasuryOp.Receipt, TreasuryMethod.Cheque) => "اسناد دریافتنی (تنظیماتِ سازمان)",
        (TreasuryOp.Payment, TreasuryMethod.Cheque) => "اسناد پرداختنی (تنظیماتِ سازمان)",
        (TreasuryOp.Payment, TreasuryMethod.ChequeAssign) => "اسناد دریافتنی — چک از صندوق خارج می‌شود",
        (TreasuryOp.Payment, TreasuryMethod.ChequeReturn) => "اسناد دریافتنی، یا گیرنده‌ی قبلی اگر چک واگذار شده بود",
        _ => "اسناد پرداختنی — چکِ ما برگشت خورده"
    };

    private void ResetEntry()
    {
        // بعد از اصلاح، فرمِ سطرِ تازه همان نوعی را می‌گیرد که پیش از اصلاح داشت — نه نوعِ سطرِ اصلاح‌شده
        // (وگرنه بعد از اصلاحِ یک واگذاری، پایینِ جدول فهرستِ همه‌ی چک‌های قابلِ واگذاری باز می‌ماند)
        var (keepOp, keepMethod) = _editOrig is null ? (_e.NoAm, _e.Method) : _newKind;
        _e = new Entry { NoAm = keepOp, Method = keepMethod };
        if (!TreasuryMethod.Allowed(_e.NoAm, _e.Method)) _e.Method = TreasuryMethod.Cash;
        DefaultsForMethod();
        _entryKey++;
        _rowEditIdh = null;
        _editOrig = null;
        _editRadif = null;
        ApplyAuto();
    }

    private void SetOp(int op)
    {
        if (_e.NoAm == op) return;
        ClearAutoSides();
        _e.NoAm = op;
        if (!TreasuryMethod.Allowed(op, _e.Method)) _e.Method = TreasuryMethod.Cash;
        _e.Picked = null;
        DefaultsForMethod();
        RestoreOriginalPick();
        ApplyAuto();
    }

    private void SetMethod(int m)
    {
        if (_e.Method == m) return;
        ClearAutoSides();
        _e.Method = m;
        _e.Picked = null;
        DefaultsForMethod();
        RestoreOriginalPick();
        ApplyAuto();
    }

    /// <summary>برگشت به همان نوعِ سطرِ ذخیره‌شده: چکِ خودِ سطر دوباره انتخاب شود، نه فهرستِ خالی.</summary>
    private void RestoreOriginalPick()
    {
        if (_editOrig is { } o && SameKind && TreasuryMethod.PicksCheque(o.Nahva)) _e.Picked = _e.Current;
    }

    private void DefaultsForMethod()
    {
        if (_e.Method == TreasuryMethod.ChequeReturn) _e.Vaz ??= _e.NoAm == TreasuryOp.Payment ? 5 : 1;
        if (_e.Method == TreasuryMethod.ChequeAssign) _e.Sandugh ??= _meta?.ChequeFunds.FirstOrDefault()?.Id;
    }

    /// <summary>حسابِ خودکارِ سمتِ قبلی پاک شود تا با نوع/نحوه‌ی تازه قاطی نشود.</summary>
    private void ClearAutoSides()
    {
        var a = AutoSides;
        if (a.From) { _e.Fhes = null; _e.FhesName = null; }
        if (a.To) { _e.Thes = null; _e.ThesName = null; }
    }

    private void ApplyAuto()
    {
        if (_meta is null) return;
        switch (_e.NoAm, _e.Method)
        {
            case (_, TreasuryMethod.Cash):
                _ = ApplyCashAsync();
                return;
            case (TreasuryOp.Receipt, TreasuryMethod.Cheque):
                SetSide(false, _e.NonTrade ? _meta.Adv : _meta.Ada);
                break;
            case (TreasuryOp.Payment, TreasuryMethod.Cheque):
                SetSide(true, _e.NonTrade ? _meta.Apv : _meta.Apa);
                break;
            case (TreasuryOp.Payment, TreasuryMethod.ChequeAssign):
                SetSide(true, _e.Picked?.Kind == 0 ? _meta.Adv : _meta.Ada);
                break;
            case (TreasuryOp.Payment, TreasuryMethod.ChequeReturn):
                {
                    var p = _e.Picked;
                    var kol = p?.NKol2 is > 0 ? p.NKol2 : p?.NKol;
                    var assigned = kol is not null && kol != _meta.Bankha;
                    SetSide(true, assigned ? (p!.Hes1 ?? p.Hes2) : (p?.Kind == 0 ? _meta.Adv : _meta.Ada));
                    if (string.IsNullOrWhiteSpace(_e.Thes) && !string.IsNullOrWhiteSpace(p?.CustNo))
                    {
                        _e.Thes = p!.CustNo!.Trim();
                        _e.ThesName = null;
                        _ = NameOfAsync(_e.Thes, false);
                    }
                    break;
                }
            case (TreasuryOp.Receipt, TreasuryMethod.ChequeReturn):
                SetSide(false, _e.Picked?.Kind == 0 ? _meta.Apv : _meta.Apa);
                break;
        }
        StateHasChanged();
    }

    private void SetSide(bool from, string? hes)
    {
        if (from) { _e.Fhes = hes; _e.FhesName = hes is null ? null : _accNames.GetValueOrDefault(hes); if (hes is not null && _e.FhesName is null) _ = NameOfAsync(hes, true); }
        else { _e.Thes = hes; _e.ThesName = hes is null ? null : _accNames.GetValueOrDefault(hes); if (hes is not null && _e.ThesName is null) _ = NameOfAsync(hes, false); }
    }

    private async Task NameOfAsync(string hes, bool from)
    {
        try
        {
            var name = (await Api.AccountsAsync(hes)).FirstOrDefault(a => a.Hes == hes)?.Name;
            _accNames[hes] = name;
            if (from && _e.Fhes == hes) _e.FhesName = name;
            if (!from && _e.Thes == hes) _e.ThesName = name;
            StateHasChanged();
        }
        catch { }
    }

    /// <summary>سطرِ نقد: سمتِ صندوق از واحد و شیفتِ همین خزانه (مثل NO_AM_AfterUpdate در WPF).</summary>
    private async Task ApplyCashAsync()
    {
        if (_e.Method != TreasuryMethod.Cash || _detail is null) return;
        var acc = await Api.CashAccountAsync(_detail.Header.Depatman, _detail.Header.Shift);
        if (acc is null) return;
        if (_e.NoAm == TreasuryOp.Receipt) { _e.Thes = acc.Hes; _e.ThesName = acc.Name; }
        else { _e.Fhes = acc.Hes; _e.FhesName = acc.Name; }
        StateHasChanged();
    }

    private void OnFromChanged(TreasuryAccountDto? a)
    {
        _e.Fhes = a?.Hes;
        _e.FhesName = a?.Name;
        // GETCHEK: نامِ پرداخت‌کننده = نامِ «از حساب»
        if (_e.Method == TreasuryMethod.Cheque && _e.NoAm == TreasuryOp.Receipt && string.IsNullOrWhiteSpace(_e.Chq.NameTah)) _e.Chq.NameTah = a?.Name?.Trim();
    }

    private void OnToChanged(TreasuryAccountDto? a)
    {
        _e.Thes = a?.Hes;
        _e.ThesName = a?.Name;
        // PAYCHEK: نامِ گیرنده = نامِ «به حساب»
        if (_e.Method == TreasuryMethod.Cheque && _e.NoAm == TreasuryOp.Payment && string.IsNullOrWhiteSpace(_e.Chq.NameTah)) _e.Chq.NameTah = a?.Name?.Trim();
    }

    private void OnPicked(TreasuryChequeDto? c)
    {
        _e.Picked = c;
        if (c is not null)
        {
            if (_e.Method == TreasuryMethod.ChequeAssign) _e.Sandugh = c.Sandugh ?? _e.Sandugh;
            if (_e.Method == TreasuryMethod.ChequeReturn && _e.NoAm == TreasuryOp.Payment) _e.Sandugh ??= c.Sandugh;
        }
        ApplyAuto();
    }

    private void EditRow(TreasuryRowDto r)
    {
        if (_rowEditIdh is null) _newKind = (_e.NoAm, _e.Method);
        _rowEditIdh = r.Idh;
        _editOrig = (r.NoAm, r.Nahva);
        _editRadif = r.Radif?.ToString("0") ?? (_detail!.Rows.IndexOf(r) + 1).ToString();
        _revealEntry = true;
        _entryKey++;
        _e = new Entry
        {
            NoAm = r.NoAm,
            Method = r.Nahva == TreasuryMethod.NonTradeCheque ? TreasuryMethod.Cheque : r.Nahva,
            NonTrade = r.Nahva == TreasuryMethod.NonTradeCheque,
            Fhes = r.Fhes, FhesName = r.FhesName, Thes = r.Thes, ThesName = r.ThesName,
            Sharh = r.Sharh, Mabl = r.Mabl.ToString("0", CultureInfo.InvariantCulture), MhazNo = r.MhazNo,
            Current = r.Cheque, Picked = TreasuryMethod.PicksCheque(r.Nahva) ? r.Cheque : null,
            Sandugh = r.Cheque?.Sandugh, Vaz = r.Cheque?.Vaz is { } v ? (int)v : null
        };
        if (r.Cheque is { } c && TreasuryMethod.IsNewCheque(r.Nahva)) _e.Chq = ChequeForm.From(c);
    }

    private async Task OnEntryKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await SaveRowAsync();
        else if (e.Key == "Escape") ResetEntry();
    }

    private async Task SaveRowAsync()
    {
        if (_detail is null || _busy) return;
        var req = new TreasuryRowSaveRequest
        {
            NoAm = _e.NoAm, Nahva = _e.Nahva, Fhes = _e.Fhes, Thes = _e.Thes, Sharh = _e.Sharh, MhazNo = _e.MhazNo
        };

        if (TreasuryMethod.PicksCheque(_e.Method))
        {
            if (_e.Picked is null) { Snackbar.Add("چک را از فهرست انتخاب کنید.", Severity.Warning); return; }
            req.PickedChequeId = _e.Picked.Id;
            req.Mabl = _e.Picked.Mabl;
            req.Sandugh = _e.Sandugh;
            req.Vaz = _e.Vaz;
        }
        else
        {
            var mabl = ParseMoney(_e.Mabl);
            if (mabl is not > 0) { Snackbar.Add("مبلغ را وارد کنید.", Severity.Warning); return; }
            req.Mabl = mabl.Value;
            if (_e.Method == TreasuryMethod.Cheque)
            {
                var (input, err) = _e.Chq.Build(_e.NoAm == TreasuryOp.Receipt, _rowEditIdh is null);
                if (err is not null) { Snackbar.Add(err, Severity.Warning); return; }
                req.Cheque = input;
            }
        }
        var auto = AutoSides;
        if (!auto.From && string.IsNullOrWhiteSpace(_e.Fhes) && _e.Method != TreasuryMethod.ChequeReturn) { Snackbar.Add("«از حساب» را انتخاب کنید.", Severity.Warning); return; }
        if (!auto.To && string.IsNullOrWhiteSpace(_e.Thes) && _e.Method != TreasuryMethod.ChequeReturn) { Snackbar.Add("«به حساب» را انتخاب کنید.", Severity.Warning); return; }

        _busy = true;
        StateHasChanged();
        var r = _rowEditIdh is { } idh
            ? await Api.UpdateRowAsync(_detail.Header.Id, idh, req)
            : await Api.AddRowAsync(_detail.Header.Id, req);
        _busy = false;
        if (!r.Ok) { Snackbar.Add((r.Error ?? "سطر ذخیره نشد.").Replace("\n", " · "), Severity.Error); StateHasChanged(); return; }

        _flash = r.Idh;
        var wasEdit = _rowEditIdh is not null;
        await LoadDetailAsync(_detail.Header.Id);
        ResetEntry();
        Snackbar.Add(wasEdit ? "سطر به‌روز شد و سند بازسازی شد." : "سطر ثبت شد و سند بازسازی شد.", Severity.Success);
        if (!string.IsNullOrWhiteSpace(r.Info)) Snackbar.Add(r.Info, Severity.Info);
        _ = LoadCashAsync();
        _ = Task.Delay(1600).ContinueWith(_ => InvokeAsync(() => { _flash = null; StateHasChanged(); }));
    }

    private async Task DeleteRowAsync(TreasuryRowDto row)
    {
        if (_detail is null || _busy) return;
        var extra = TreasuryMethod.IsCheque(row.Nahva) ? " وضعیتِ چکِ این سطر هم برمی‌گردد." : "";
        var ok = await DialogService.ShowMessageBox("حذف سطر", $"سطرِ «{row.Sharh}» به مبلغ {Money(row.Mabl)} حذف شود؟{extra}", yesText: "حذف", cancelText: "انصراف");
        if (ok != true) return;
        _busy = true;
        var r = await Api.DeleteRowAsync(_detail.Header.Id, row.Idh);
        _busy = false;
        if (!r.Ok) { Snackbar.Add(r.Error ?? "حذف نشد.", Severity.Error); return; }
        Snackbar.Add("سطر حذف شد و سند بازسازی شد.", Severity.Info);
        if (_rowEditIdh == row.Idh) ResetEntry();
        await LoadDetailAsync(_detail.Header.Id);
        _ = LoadCashAsync();
    }

    private List<SanadLine> SanadLines => _detail is null ? new() :
        _detail.Rows.Select(r => new SanadLine(r.Thes ?? "", r.ThesName, r.Mabl, 0))
            .Concat(_detail.Rows.Select(r => new SanadLine(r.Fhes ?? "", r.FhesName, 0, r.Mabl)))
            .GroupBy(l => l.Hes)
            .Select(g => new SanadLine(g.Key, g.First().Name, g.Sum(x => x.Bed), g.Sum(x => x.Bes)))
            .OrderByDescending(l => l.Bed).ThenByDescending(l => l.Bes)
            .ToList();

    // ─────────────────────────── قالب‌بندی ───────────────────────────

    private string OpName(int op) => _meta?.Operations.FirstOrDefault(x => x.Id == op)?.Name?.Trim() is { Length: > 0 } n ? n : op == 1 ? "دریافت" : "پرداخت";
    private string MethodName(int m) => _meta?.Methods.FirstOrDefault(x => x.Id == m)?.Name?.Trim() is { Length: > 0 } n ? n : m.ToString();
    private static string KindName(int k) => k switch { 2 => "سند دریافت", 3 => "سند پرداخت", _ => "عادی" };
    private static string Money(double v) => AccountPicker.Money(v);
    private static string StatementUrl(string? hes) => string.IsNullOrWhiteSpace(hes) ? "javascript:void(0)" : $"/customer-statement/{hes.Trim()}";

    private static double? ParseMoney(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return null;
        var digits = ChequeForm.Digits(s);
        return double.TryParse(digits, NumberStyles.None, CultureInfo.InvariantCulture, out var v) ? v : null;
    }

    private static long ToLong(DateTime d) => Pc.GetYear(d) * 10000L + Pc.GetMonth(d) * 100 + Pc.GetDayOfMonth(d);

    private static DateTime? FromLong(long d)
    {
        try { return Pc.ToDateTime((int)(d / 10000), (int)(d / 100 % 100), (int)(d % 100), 0, 0, 0, 0); }
        catch { return null; }
    }

    private static string FormatDate(long d) => ChequeForm.FormatDate(d);
    private static long? ParseDate(string? s) => ChequeForm.ParseDate(s);

    private static string DateLabel(long d)
    {
        var dt = FromLong(d);
        if (dt is null) return FormatDate(d);
        var today = DateTime.Now.Date;
        if (dt.Value.Date == today) return "امروز";
        if (dt.Value.Date == today.AddDays(-1)) return "دیروز";
        return $"{AutomationUi.WeekDay(dt.Value.DayOfWeek)} {FormatDate(d)}";
    }

    private static HeaderForm Clone(HeaderForm h) => new() { Date = h.Date, Kind = h.Kind, Depatman = h.Depatman, Shift = h.Shift, Molah = h.Molah };

    private static string Norm(string? s) => (s ?? "").Replace('ي', 'ی').Replace('ك', 'ک').Replace('‌', ' ').ToLowerInvariant();
}
