@page "/my-bug-reports"
@using Safir.Shared.Models.BugReport
@using Safir.Client.Services
@using MudBlazor
@using System.Globalization
@inject BugReportApiService BugReportApi
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ConnectionManagerService ConnectionManager

<PageTitle>گزارش‌های خطای من</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8 mb-16">
    <MudText Typo="Typo.h4" Class="mb-6">گزارش‌های خطای من</MudText>

    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudGrid AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="5">
                <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_filterStatuses"
                           Label="فیلتر بر اساس وضعیت" Variant="Variant.Outlined" Dense="true" Clearable="true"
                           MultiSelectionTextFunc="@(list => $"{list.Count} وضعیت انتخاب شده")">
                    @foreach (var status in BugReportStatuses.All)
                    {
                        <MudSelectItem T="string" Value="@status.Key">@status.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudTextField @bind-Value="_searchText" Label="جستجو" Variant="Variant.Outlined" Dense="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true" Immediate="true" />
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex justify-end">
                <MudTooltip Text="پاک کردن فیلترها">
                    <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff" OnClick="ClearFilters" />
                </MudTooltip>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable Items="@FilteredReports" Dense="true" Hover="true" Loading="@_isLoading" LoadingProgressColor="Color.Primary" Striped="true" OnRowClick="OnRowClick" T="BugReportDto" RowClass="cursor-pointer">
        <HeaderContent>
            <MudTh>شناسه</MudTh>
            <MudTh>تاریخ ثبت</MudTh>
            <MudTh>دسته‌بندی</MudTh>
            <MudTh>شرح مشکل</MudTh>
            <MudTh>وضعیت</MudTh>
            <MudTh>پیام تیم فنی</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="شناسه">@context.Id</MudTd>
            <MudTd DataLabel="تاریخ ثبت">@FormatShamsiDateFromDateTime(context.CreatedAt)</MudTd>
            <MudTd DataLabel="دسته‌بندی">@context.Category</MudTd>
            <MudTd DataLabel="شرح مشکل">
                <MudText Typo="Typo.body2" Style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@context.UserDescription">
                    @context.UserDescription
                </MudText>
            </MudTd>
            <MudTd DataLabel="وضعیت">
                <MudChip T="string" Size="Size.Small"
                         Color="@BugReportStatusUi.GetColor(context.Status)"
                         Variant="@BugReportStatusUi.GetVariant(context.Status)"
                         Icon="@BugReportStatusUi.GetIcon(context.Status)">
                    @BugReportStatusUi.GetLabel(context.Status)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="پیام تیم فنی">
                <MudText Typo="Typo.body2" Style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@context.AdminNote">
                    @context.AdminNote
                </MudText>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>شما تاکنون گزارش خطایی ثبت نکرده‌اید.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>در حال بارگذاری...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="تعداد در صفحه" InfoFormat="{first_item}-{last_item} از {all_items}" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private List<BugReportDto> _reports = new();
    private bool _isLoading = true;

    private IEnumerable<string> _filterStatuses = new HashSet<string>();
    private string _searchText = "";

    private IEnumerable<BugReportDto> FilteredReports =>
        _reports.Where(r =>
            (!_filterStatuses.Any() || _filterStatuses.Contains(r.Status)) &&
            (string.IsNullOrWhiteSpace(_searchText) ||
                r.Id.ToString().Contains(_searchText) ||
                (r.UserDescription?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.Category?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false)));

    protected override async Task OnInitializedAsync()
    {
        await ConnectionManager.LoadSettingsAsync();
        await LoadReportsAsync();
    }

    private async Task LoadReportsAsync()
    {
        _isLoading = true;
        try
        {
            _reports = await BugReportApi.GetMyBugReportsAsync() ?? new List<BugReportDto>();
        }
        catch (Exception)
        {
            Snackbar.Add("خطا در دریافت لیست گزارش‌ها.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ClearFilters()
    {
        _filterStatuses = new HashSet<string>();
        _searchText = "";
    }

    private void OnRowClick(TableRowClickEventArgs<BugReportDto> args)
    {
        NavigationManager.NavigateTo($"/bug-report-detail/{args.Item.Id}");
    }

    private string FormatShamsiDateFromDateTime(DateTime dt)
    {
        try
        {
            PersianCalendar pc = new PersianCalendar();
            return $"{pc.GetYear(dt):D4}/{pc.GetMonth(dt):D2}/{pc.GetDayOfMonth(dt):D2} {dt.ToString("HH:mm")}";
        }
        catch
        {
            return dt.ToString("yyyy/MM/dd HH:mm");
        }
    }
}
