@page "/bug-report-list"
@using Microsoft.AspNetCore.Authorization
@using Safir.Shared.Models.BugReport
@using Safir.Client.Services
@using MudBlazor
@attribute [Authorize]
@inject BugReportApiService BugReportApi
@inject ISnackbar Snackbar
@inject ConnectionManagerService ConnectionManager

<PageTitle>لیست گزارش‌های خطا</PageTitle>

<style>
    .bug-report-link-table tbody .mud-table-cell {
        padding: 0 !important;
    }

    .bug-report-link-table thead .mud-table-cell {
        padding: 16px !important;
    }

    .bug-report-row-link {
        display: block;
        width: 100%;
        min-height: 36px;
        padding: 6px 16px;
        color: inherit;
        text-decoration: none;
    }

        .bug-report-row-link:hover {
            color: inherit;
            text-decoration: none;
        }

    .bug-report-row-link-center {
        text-align: center;
    }

    .bug-report-summary-text {
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .bug-report-sort-header {
        cursor: pointer;
        user-select: none;
        display: flex;
        align-items: center;
    }

    .bug-report-status-chip {
        cursor: pointer;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-16">
    <MudText Typo="Typo.h5" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.BugReport" Class="me-2 mb-1" />
        لیست گزارش‌های خطای دریافتی
    </MudText>

    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <!-- Quick group filter: plain buttons instead of MudTabs — MudTabs' animated
             underline uses LTR math internally and lands under the wrong tab in an
             RTL layout, even though the click logic is fine. Manual buttons avoid that. -->
        <div class="d-flex flex-wrap gap-2 mb-3">
            <MudButton Variant="@(_groupFilter == null ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Primary" Size="Size.Small" DisableElevation="true"
                       OnClick="@(() => SetGroupFilter(null))">
                همه (@_allReports.Count)
            </MudButton>
            <MudButton Variant="@(_groupFilter == BugReportStatuses.StatusGroup.Open ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Primary" Size="Size.Small" DisableElevation="true"
                       OnClick="@(() => SetGroupFilter(BugReportStatuses.StatusGroup.Open))">
                باز (@CountInGroup(BugReportStatuses.StatusGroup.Open))
            </MudButton>
            <MudButton Variant="@(_groupFilter == BugReportStatuses.StatusGroup.Resolved ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Primary" Size="Size.Small" DisableElevation="true"
                       OnClick="@(() => SetGroupFilter(BugReportStatuses.StatusGroup.Resolved))">
                حل شده (@CountInGroup(BugReportStatuses.StatusGroup.Resolved))
            </MudButton>
            <MudButton Variant="@(_groupFilter == BugReportStatuses.StatusGroup.Closed ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Primary" Size="Size.Small" DisableElevation="true"
                       OnClick="@(() => SetGroupFilter(BugReportStatuses.StatusGroup.Closed))">
                بسته شده (@CountInGroup(BugReportStatuses.StatusGroup.Closed))
            </MudButton>
        </div>

        <!-- Clickable status legend: click to add/remove that status from the filter -->
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var status in BugReportStatuses.All)
            {
                var count = _statusCounts.TryGetValue(status.Key, out var c) ? c : 0;
                if (count == 0) { continue; }
                var isActive = _filterStatuses.Contains(status.Key);
                <MudChip T="string" Class="bug-report-status-chip"
                         Color="@BugReportStatusUi.GetColor(status.Key)"
                         Variant="@(isActive ? Variant.Filled : Variant.Outlined)"
                         Icon="@BugReportStatusUi.GetIcon(status.Key)"
                         Size="Size.Small"
                         OnClick="@(() => ToggleStatusFilter(status.Key))">
                    @status.Label (@count)
                </MudChip>
            }
        </div>

        <MudGrid AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_filterStatuses"
                           Label="فیلتر بر اساس وضعیت" Variant="Variant.Outlined" Dense="true"
                           Clearable="true" MultiSelectionTextFunc="@(list => $"{list.Count} وضعیت انتخاب شده")">
                    @foreach (var status in BugReportStatuses.All)
                    {
                        <MudSelectItem T="string" Value="@status.Key">@status.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect @bind-Value="_filterSeverity" Label="شدت" Variant="Variant.Outlined" Clearable="true" Dense="true">
                    <MudSelectItem Value="@("")">همه</MudSelectItem>
                    <MudSelectItem Value="@("Critical")">بحرانی</MudSelectItem>
                    <MudSelectItem Value="@("High")">زیاد</MudSelectItem>
                    <MudSelectItem Value="@("Medium")">متوسط</MudSelectItem>
                    <MudSelectItem Value="@("Low")">کم</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect @bind-Value="_filterCategory" Label="دسته‌بندی" Variant="Variant.Outlined" Clearable="true" Dense="true">
                    <MudSelectItem Value="@("")">همه</MudSelectItem>
                    @foreach (var category in _categories)
                    {
                        <MudSelectItem Value="@category">@category</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField @bind-Value="_searchText" Label="جستجو (شناسه، مشتری، شرح مشکل...)" Variant="Variant.Outlined" Dense="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true" Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex justify-end gap-2">
                <MudTooltip Text="پاک کردن همه فیلترها">
                    <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff" Color="Color.Default" OnClick="ClearFilters" />
                </MudTooltip>
                <MudTooltip Text="بارگذاری مجدد">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="LoadReports" Disabled="_isLoading" />
                </MudTooltip>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }
    else if (_reports == null)
    {
        <MudAlert Severity="Severity.Error">خطا در بارگذاری گزارش‌ها. لطفاً دوباره تلاش کنید.</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.caption" Class="mb-2 text-muted">
            تعداد کل: @_allReports.Count گزارش | نمایش فعلی: @FilteredReports.Count() مورد
        </MudText>

        <MudTable Items="@FilteredReports" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm"
                  T="BugReportDto" RowClass="cursor-pointer" Class="bug-report-link-table">
            <HeaderContent>
                <MudTh>
                    <div class="bug-report-sort-header" @onclick='() => SetSort("Id")'>
                        شناسه @SortIcon("Id")
                    </div>
                </MudTh>
                <MudTh>
                    <div class="bug-report-sort-header" @onclick='() => SetSort("CreatedAt")'>
                        تاریخ ثبت @SortIcon("CreatedAt")
                    </div>
                </MudTh>
                <MudTh>مشتری / شرکت</MudTh>
                <MudTh>دسته‌بندی</MudTh>
                <MudTh>
                    <div class="bug-report-sort-header" @onclick='() => SetSort("Severity")'>
                        شدت @SortIcon("Severity")
                    </div>
                </MudTh>
                <MudTh>
                    <div class="bug-report-sort-header" @onclick='() => SetSort("Status")'>
                        وضعیت @SortIcon("Status")
                    </div>
                </MudTh>
                <MudTh>متوقف‌کننده</MudTh>
                <MudTh>خلاصه مشکل</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="شناسه">
                    <a class="bug-report-row-link bug-report-row-link-center" href="@BugReportDetailUrl(context)">
                        @context.Id
                    </a>
                </MudTd>

                <MudTd DataLabel="تاریخ ثبت">
                    <a class="bug-report-row-link" href="@BugReportDetailUrl(context)">
                        @context.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                    </a>
                </MudTd>

                <MudTd DataLabel="مشتری">
                    <a class="bug-report-row-link" href="@BugReportDetailUrl(context)">
                        @(context.CustomerName ?? "-")
                    </a>
                </MudTd>

                <MudTd DataLabel="دسته‌بندی">
                    <a class="bug-report-row-link" href="@BugReportDetailUrl(context)">
                        @(context.Category ?? "-")
                    </a>
                </MudTd>

                <MudTd DataLabel="شدت">
                    <a class="bug-report-row-link" href="@BugReportDetailUrl(context)">
                        <MudChip T="string" Color="@GetSeverityColor(context.Severity)" Size="Size.Small" Label="true">
                            @GetSeverityLabel(context.Severity)
                        </MudChip>
                    </a>
                </MudTd>

                <MudTd DataLabel="وضعیت">
                    <a class="bug-report-row-link" href="@BugReportDetailUrl(context)">
                        <MudChip T="string" Color="@BugReportStatusUi.GetColor(context.Status)"
                                 Variant="@BugReportStatusUi.GetVariant(context.Status)"
                                 Icon="@BugReportStatusUi.GetIcon(context.Status)"
                                 Size="Size.Small" Label="true">
                            @BugReportStatusUi.GetLabel(context.Status)
                        </MudChip>
                    </a>
                </MudTd>

                <MudTd DataLabel="متوقف‌کننده">
                    <a class="bug-report-row-link bug-report-row-link-center" href="@BugReportDetailUrl(context)">
                        @if (context.IsBlocking)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" Title="مشکل متوقف‌کننده است" />
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </a>
                </MudTd>

                <MudTd DataLabel="خلاصه مشکل">
                    <a class="bug-report-row-link" href="@BugReportDetailUrl(context)">
                        <MudText Typo="Typo.body2" Class="bug-report-summary-text">
                            @context.UserDescription
                        </MudText>
                    </a>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" RowsPerPageString="تعداد در هر صفحه:" />
            </PagerContent>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="pa-4">هیچ گزارشی با این فیلترها یافت نشد.</MudText>
            </NoRecordsContent>
        </MudTable>
    }
</MudContainer>

@code {
    private List<BugReportDto> _allReports = new();
    private List<BugReportDto>? _reports;
    private bool _isLoading = true;

    private BugReportStatuses.StatusGroup? _groupFilter = null;

    private IEnumerable<string> _filterStatuses = new HashSet<string>();
    private string _filterSeverity = "";
    private string _filterCategory = "";
    private string _searchText = "";

    private string _sortColumn = "CreatedAt";
    private bool _sortDescending = true;

    private Dictionary<string, int> _statusCounts => _allReports
        .GroupBy(r => r.Status)
        .ToDictionary(g => g.Key, g => g.Count());

    private List<string> _categories => _allReports
        .Select(r => r.Category)
        .Where(c => !string.IsNullOrWhiteSpace(c))
        .Select(c => c!)
        .Distinct()
        .OrderBy(c => c)
        .ToList();

    private IEnumerable<BugReportDto> FilteredReports
    {
        get
        {
            var query = (_reports ?? new List<BugReportDto>()).AsEnumerable();

            if (_groupFilter != null)
                query = query.Where(r => BugReportStatuses.GetGroup(r.Status) == _groupFilter);

            if (_filterStatuses.Any())
                query = query.Where(r => _filterStatuses.Contains(r.Status));

            if (!string.IsNullOrEmpty(_filterSeverity))
                query = query.Where(r => r.Severity == _filterSeverity);

            if (!string.IsNullOrEmpty(_filterCategory))
                query = query.Where(r => r.Category == _filterCategory);

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                query = query.Where(r =>
                    r.Id.ToString().Contains(_searchText) ||
                    (r.CustomerName?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (r.UserDescription?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (r.Category?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (r.ContactInfo?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            query = _sortColumn switch
            {
                "Id" => _sortDescending ? query.OrderByDescending(r => r.Id) : query.OrderBy(r => r.Id),
                "Severity" => _sortDescending ? query.OrderByDescending(r => SeverityRank(r.Severity)) : query.OrderBy(r => SeverityRank(r.Severity)),
                "Status" => _sortDescending ? query.OrderByDescending(r => BugReportStatuses.GetLabel(r.Status)) : query.OrderBy(r => BugReportStatuses.GetLabel(r.Status)),
                _ => _sortDescending ? query.OrderByDescending(r => r.CreatedAt) : query.OrderBy(r => r.CreatedAt),
            };

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ConnectionManager.LoadSettingsAsync();
        await LoadReports();
    }

    private async Task LoadReports()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var result = await BugReportApi.GetBugReportsAsync();
            _allReports = result ?? new List<BugReportDto>();
            _reports = _allReports;
        }
        catch
        {
            _reports = null;
            Snackbar.Add("خطا در بارگذاری گزارش‌ها.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private int CountInGroup(BugReportStatuses.StatusGroup group) =>
        _allReports.Count(r => BugReportStatuses.GetGroup(r.Status) == group);

    private void SetGroupFilter(BugReportStatuses.StatusGroup? group)
    {
        _groupFilter = group;
    }

    private void ToggleStatusFilter(string key)
    {
        var set = new HashSet<string>(_filterStatuses);
        if (!set.Remove(key)) set.Add(key);
        _filterStatuses = set;
    }

    private void ClearFilters()
    {
        _filterStatuses = new HashSet<string>();
        _filterSeverity = "";
        _filterCategory = "";
        _searchText = "";
        _groupFilter = null;
    }

    private void SetSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortColumn = column;
            _sortDescending = true;
        }
    }

    private RenderFragment SortIcon(string column) => __builder =>
    {
        if (_sortColumn == column)
        {
            <MudIcon Icon="@(_sortDescending? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)" Size="Size.Small" Class="ms-1" />
        }
    };

    private static int SeverityRank(string severity) => severity switch
    {
        "Critical" => 4,
        "High" => 3,
        "Medium" => 2,
        "Low" => 1,
        _ => 0
    };

    private static string BugReportDetailUrl(BugReportDto report)
    {
        return $"/bug-report-detail/{report.Id}";
    }

    private Color GetSeverityColor(string severity) => severity switch
    {
        "Critical" => Color.Error,
        "High" => Color.Warning,
        "Medium" => Color.Info,
        "Low" => Color.Success,
        _ => Color.Default
    };

    private string GetSeverityLabel(string severity) => severity switch
    {
        "Critical" => "بحرانی",
        "High" => "زیاد",
        "Medium" => "متوسط",
        "Low" => "کم",
        _ => severity
    };
}
