@page "/"

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Safir.Shared.Constants;
@using Safir.Shared.Utility
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ClientAppSettingsService ClientAppSettings

<PageTitle>صفحه اصلی</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="safir-home">
            <!-- سرتیتر: خوشامد + محیط کاری -->
            <div class="safir-home-hero">
                <div>
                    <div class="safir-home-greeting">سلام @displayName، خوش آمدید</div>
                    <div class="safir-home-sub">
                        <i class="bi bi-calendar3"></i> امروز @_today
                        @if (!string.IsNullOrWhiteSpace(_companyName))
                        {
                            <span class="safir-home-dot">·</span>
                            <i class="bi bi-building"></i>
                            @_companyName
                            @if (_fiscalYear.HasValue)
                            {
                                <span>(سال مالی @_fiscalYear)</span>
                            }
                        }
                    </div>
                </div>
            </div>

            @* عمداً فقط سه میان‌بر پرکاربرد؛ بقیه‌ی بخش‌ها در منوی کناری‌اند و صفحه‌ی اول شلوغ نمی‌شود *@
            <div class="safir-home-grid">
                @foreach (var tile in _tiles)
                {
                    <a class="safir-home-tile" href="@tile.Href">
                        <div class="safir-home-tile-icon @tile.Tone"><i class="bi @tile.Icon"></i></div>
                        <div class="safir-home-tile-body">
                            <div class="safir-home-tile-title">
                                @tile.Title
                                @if (!string.IsNullOrEmpty(tile.Shortcut))
                                {
                                    <span class="safir-home-kbd">@tile.Shortcut</span>
                                }
                            </div>
                            <div class="safir-home-tile-desc">@tile.Description</div>
                        </div>
                        <i class="bi bi-chevron-left safir-home-tile-arrow"></i>
                    </a>
                }
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="safir-home">
            <div class="safir-home-guest">
                <div class="safir-home-guest-icon"><i class="bi bi-shield-lock"></i></div>
                <div class="safir-home-greeting">به سیستم جامع سفیر خوش آمدید</div>
                <div class="safir-home-sub">برای استفاده از امکانات سیستم، لطفاً وارد شوید.</div>
                <a class="safir-home-hero-action" href="login">
                    <i class="bi bi-box-arrow-in-left"></i> ورود به سیستم
                </a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? displayName;
    private string _today = "";
    private string? _companyName;
    private short? _fiscalYear;

    private sealed record HomeTile(string Title, string Description, string Href, string Icon, string Tone, string? Shortcut = null);

    // همان سه میان‌بر صفحه‌ی قبلی؛ هر مجوزی را خود صفحه‌ی مقصد بررسی می‌کند
    private static readonly HomeTile[] _tiles =
    {
        new("حقوق و دستمزد", "پرسنل، احکام، کارکرد، محاسبه و گزارش‌ها", "salary/manage", "bi-wallet2", "tone-blue"),
        new("لیست مشتریان", "مشتریان من و ثبت سفارش", "visitor-customers", "bi-people", "tone-blue", "Ctrl + F8"),
        new("تعریف مشتری جدید", "ثبت مشخصات مشتری", "customer-define", "bi-person-plus", "tone-blue"),
    };

    protected override async Task OnInitializedAsync()
    {
        _today = CL_Tarikh.FormatShamsiDateFromLong(CL_Tarikh.GetCurrentPersianDateAsLong());

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity == null || !user.Identity.IsAuthenticated) return;

        displayName = user.FindFirst(BaseknowClaimTypes.UUSER)?.Value ?? "";

        // نام شرکت فقط برای نمایش است؛ اگر نیامد صفحه بدون آن کار می‌کند
        try
        {
            var sazman = await ClientAppSettings.GetSettingsAsync();
            _companyName = sazman?.NAME;
            _fiscalYear = sazman?.YEA;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Home: company settings not loaded: {ex.Message}");
        }
    }
}
